-- Globals the addon shares with config files and other addons, and the wire
-- contracts it shares with the donatos.net API and between the server and the menu.

------------------------------------------------------------------------------
-- donatos.net server API.
-- Payloads travel as JSON, so dates arrive as strings and JSON null as nil.
------------------------------------------------------------------------------

-- Why goods can't be bought or activated on this server: "notSetUp", one-time goods whose item
-- the server's config doesn't register (`item.availability`).
type DonatosUnavailableReason = "notSetUp"

interface DonatosGoodsVariant {
	id: string;
	price: number;
	duration?: number;
	-- Set by the game server in what it syncs to clients, never by the API.
	unavailable?: DonatosUnavailableReason;
}

-- A goods image: absolute URLs named by their content hash, so a URL's content never
-- changes. JPEG (`.jpg`), or PNG (`.png`) when the image has transparency. `card` is at most
-- 640px on its longer side, for shop cards; `full` at most 1280px. `width` and `height` are the
-- full image's.
interface DonatosGoodsImage {
	full: string;
	card: string;
	-- The files' ids, for `server:get-image`.
	ids: { full: string; card: string };
	width: number;
	height: number;
}

interface DonatosItemGoods {
	key: string;
	meta?: string;
	name: string;
}

-- A PNG from the API to download and draw; `width` and `height` give its aspect.
interface DonatosLogo {
	-- For `server:get-image`.
	id: string;
	url: string;
	width: number;
	height: number;
}

-- A way to pay our order besides SBP's QR code, as the API describes its button.
interface DonatosPaymentMethod {
	-- For `server:payment-method-link`, unless `url` is set.
	id: string;
	name: string;
	-- Text before the logo; the name is shown when there is neither.
	label?: string;
	-- A PNG in the brand's colours, for buttons of `colors.fill`.
	logo?: DonatosLogo;
	-- One of our icons ("card"), before the label.
	icon?: string;
	-- "#RRGGBB"; our own button colours when absent.
	colors?: { fill: string; hover: string; ink: string };
	-- Opened as is, without asking for a link.
	url?: string;
	-- Under the link's QR code.
	qrHint?: string;
}

interface DonatosServerApi {
	["server:get-config"]: {
		input: nil;
		output: {
			name: string;
			updatedAt: string;
			payUrl: string;
			igs: { enabled: boolean };
			goods: {
				id: number;
				name: string;
				order?: number;
				category?: string;
				categoryId?: number;
				key: string;
				description?: string;
				variants?: DonatosGoodsVariant[];
				-- By position, the first is the cover; absent when there are none.
				images?: DonatosGoodsImage[];
				-- Unix seconds; absent for goods added before the date was kept.
				createdAt?: number;
			}[];
			goodsCategories: { id: number; name: string }[];
		};
	};
	["server:igs-create-payment-url"]: {
		input: { playerExternalId: string; sum: number; extra?: string };
		output: { url: string };
	};
	["server:create-order"]: {
		-- `email` is for the receipt; without it the one the player asked to remember is used.
		input: { playerExternalId: string; amount: number; email?: string; rememberEmail?: boolean };
		output: {
			orderId: number;
			-- T-Kassa's pay page (card, SBP, T-Pay and the rest).
			payUrl: string;
			-- `modules` is `size` rows of `size` modules, "1" dark; absent when there is no QR.
			-- `logo` goes beside the title.
			sbp?: { payload: string; size: number; modules: string; logo?: DonatosLogo };
			-- The other ways to pay it, in order.
			methods: DonatosPaymentMethod[];
		};
	};
	["server:payment-method-link"]: {
		input: { playerExternalId: string; orderId: number; method: string };
		-- `url`: a link into the bank's phone app; `qr`: that link as a QR code, laid out like `sbp`'s.
		output: { url: string; qr: { size: number; modules: string } };
	};
	["server:get-image"]: {
		-- An image's id from the API (goods images, payment logos).
		input: { id: string };
		-- `data`: the file's bytes in base64.
		output: { data: string };
	};
	["server:get-updates:v2"]: {
		input: { since?: string; playerExternalIds: string[] };
		output: {
			ts: string;
			server: { updatedAt: string };
			updatedPlayers: { id: number; externalId: string; updatedAt: string }[];
			newOrders: {
				id: number;
				playerId: number;
				playerExternalId: string;
				playerName?: string;
				total: string;
				status: "PENDING" | "SUCCEEDED" | "CANCELED" | "REFUNDED";
				isAnonymous: boolean;
			}[];
		};
	};
	["server:get-player"]: {
		input: { playerExternalId: string; setName?: string };
		output: {
			player: {
				id: number;
				externalId: string;
				balance: number;
				-- The remembered receipt email, masked ("p***@example.com"); missing from older APIs.
				receiptEmail?: string;
				externalMeta?: {
					name?: string;
					avatarUrl?: string;
					profileUrl?: string;
				};
			};
			inventoryItems: {
				id: number;
				goodsId?: number;
				goods?: { name: string; description?: string; key: string };
				variantId?: string;
				variant?: DonatosGoodsVariant;
				amountPaid?: string;
				-- Set by the game server in what it syncs to clients, never by the API.
				unavailable?: DonatosUnavailableReason;
			}[];
			activeItems: {
				id: number;
				activatedAt: number;
				expires?: { at: number; ["in"]: string; inS: number; durationS: number };
				isFrozen: boolean;
				frozenAt?: number;
				freezeCounter?: number;
				goods: DonatosItemGoods;
				variant?: DonatosGoodsVariant;
			}[];
		} | nil;
	};
	["player:purchase-goods"]: {
		input: { playerId: number; goodsId: number; variantId: string; expectedPrice?: number };
		output: {
			item: { id: number };
			goods: { id: number; name: string };
		};
	};
	["player:activate-item"]: {
		input: { playerId: number; itemId: number };
		output: {
			goods: { id: number; key: string; meta?: string; name: string };
			variant: { id: string; duration?: number; price: number };
			order?: { isAnonymous: boolean };
		};
	};
	["player:gift-item"]: {
		input: { playerId: number; itemId: number; gifteeExternalId: string };
		output: {
			gifteeExternalId: string;
			item: { id: number; name: string; variant?: DonatosGoodsVariant };
		};
	};
	["player:freeze-active-item"]: {
		input: { playerId: number; itemId: number };
		output: boolean;
	};
	["player:unfreeze-active-item"]: {
		input: { playerId: number; itemId: number };
		output: boolean;
	};
	["player:get-history"]: {
		-- `cursor` is the previous page's `nextCursor`; omit it for the newest entries.
		input: { playerId: number; cursor?: number; limit?: number };
		output: {
			-- Newest first. `createdAt` is unix seconds; `delta` is signed (+ credit, - debit).
			entries: {
				id: number;
				createdAt: number;
				delta: number;
				kind: string;
				source: "paid" | "free";
				description: string;
				-- A short form of `description` (the goods name for purchases and item
				-- refunds); missing from APIs before it.
				title?: string;
			}[];
			-- Present when there are older entries.
			nextCursor?: number;
			-- With the newest page only: rubles paid in successful orders.
			summary?: { ordersTotal: number };
		};
	};
}

type DonatosRemoteConfig = DonatosServerApi["server:get-config"]["output"]
type DonatosRemoteData = DonatosServerApi["server:get-player"]["output"]
type DonatosInventoryItem = NonNullable<DonatosRemoteData>["inventoryItems"][number]
type DonatosActiveItem = NonNullable<DonatosRemoteData>["activeItems"][number]
type DonatosHistoryPage = DonatosServerApi["player:get-history"]["output"]
type DonatosHistoryEntry = DonatosHistoryPage["entries"][number]

------------------------------------------------------------------------------
-- Menu -> server actions.
------------------------------------------------------------------------------

type DonatosActionResult<T> =
	| { success: true; data: T }
	| { success: false; error: string }

interface DonatosOnlinePlayer {
	externalId: string;
	name: string;
	avatarUrl?: string;
}

interface DonatosServerActions {
	requestSync: { input: nil; output: DonatosActionResult<true> };
	requestRefresh: { input: nil; output: DonatosActionResult<true> };
	purchaseGoods: {
		input: { goodsId: number; variantId: string; expectedPrice?: number };
		output: DonatosActionResult<DonatosServerApi["player:purchase-goods"]["output"]>;
	};
	activateItem: { input: { id: number }; output: DonatosActionResult<true> };
	giftItem: {
		input: { id: number; gifteeExternalId: string };
		output: DonatosActionResult<DonatosServerApi["player:gift-item"]["output"]>;
	};
	freezeActiveItem: { input: { id: number }; output: DonatosActionResult<true> };
	unfreezeActiveItem: { input: { id: number }; output: DonatosActionResult<true> };
	createIgsPaymentUrl: {
		input: { sum: number };
		output: DonatosActionResult<DonatosServerApi["server:igs-create-payment-url"]["output"]>;
	};
	createOrder: {
		input: { amount: number; email?: string; rememberEmail?: boolean };
		output: DonatosActionResult<DonatosServerApi["server:create-order"]["output"]>;
	};
	paymentMethodLink: {
		input: { orderId: number; method: string };
		output: DonatosActionResult<DonatosServerApi["server:payment-method-link"]["output"]>;
	};
	getOnlinePlayers: { input: nil; output: DonatosActionResult<DonatosOnlinePlayer[]> };
	getHistory: { input: { cursor?: number }; output: DonatosActionResult<DonatosHistoryPage> };
}

------------------------------------------------------------------------------
-- Server -> client net messages. Payloads are JSON, `{ action, data }` arrays.
------------------------------------------------------------------------------

type DonatosUiTab = "shop" | "inventory" | "activeItems" | "profile"

-- One chat message part: text, a player by UserID, or a Color:ToTable() color.
type DonatosChatPart = [0, string] | [1, number] | [2, [number, number, number, number]]

-- A client can still run an older bundle while it fetches a new one, so these messages only
-- ever gain optional fields; their shape never changes.
interface DonatosClientMessages {
	resultFromServer: [number, unknown];
	updateAddon: string;
	openUi: DonatosUiTab | nil;
	print: DonatosChatPart[];
	broadcast: DonatosChatPart[];
	syncConfig: DonatosRemoteConfig;
	syncPlayer: DonatosRemoteData;
}

------------------------------------------------------------------------------
-- Globals.
------------------------------------------------------------------------------

-- The menu's colour schemes (ui/theme.tlua).
type DonatosColorScheme = "ocean" | "emerald" | "amber" | "graphite" | "light"

interface DonatosConfig {
	apiEndpoint?: string;
	apiToken?: string;
	autoUpdate?: boolean;
	menuKeyBind?: KEY;
	igsCompat?: boolean;
}

-- The shape of the `donatos` global, which main.tlua creates.
interface DonatosGlobal {
	-- server
	Item?: (key: string) => DonatosItem;

	-- client
	OpenUI?: (tab?: DonatosUiTab) => Panel;
	NetMessageToServer?: <K extends keyof DonatosServerActions>(
		action: K,
		data: DonatosServerActions[K]["input"],
		callback?: (result: DonatosServerActions[K]["output"]) => void
	) => void;

	GetRemoteConfig?: () => DonatosRemoteConfig | nil;

	-- set by donatos/config_sv.lua and donatos/config_sh.lua
	config?: DonatosConfig;
	dev?: {
		-- rebuild the menu on every open
		enabled?: boolean;
	};
}

-- Set by the bootstrap addon before it runs the bundle.
declare donatosBootstrap: {
	version?: number;
	addonVersionConVar?: ConVar;
	bundleSha256ConVar?: ConVar;
	addonApiUrl?: string;
} | nil

-- State that survives a bundle reload (`RunString` of a newer bundle).
interface DonatosPersistentState {
	items?: Table<string, DonatosItem>;
	knownSamRanks?: Table<string, true>;
	clientNonce?: {
		value: number;
		handlers: Table<number, (data: unknown) => void>;
	};
	remoteConfig?: { value: DonatosRemoteConfig | nil };
	menu?: { frame: Panel | nil };
}

-- The shape of the `_donatos` global, which utils/state.tlua creates.
interface DonatosRuntime {
	_timersUuid?: string;
	_runCount?: number;
	_state: DonatosPersistentState;
}

interface Player {
	_donatos?: DonatosPlayer;
	Donatos(self: Player): DonatosPlayer;
	-- IGS compatibility, installed when donatos.config.igsCompat is set
	HasPurchase(self: Player, key: string): boolean;

	-- SAM admin mod, when installed
	sam_getrank?: (self: Player) => string;
	sam_get_nwvar?: (self: Player, key: string, fallback: string) => string;
	sam_set_rank?: (self: Player, rank: string) => void;

	-- DarkRP, when installed
	addMoney?: (self: Player, amount: number, reason: string) => void;
}

-- Gaps in @tlua/gmod 1.0.14. Remove each once the package has it.

-- FontData fields all have wiki defaults, but the package declares every one required.
interface SurfaceLib {
	CreateFont(fontName: string, fontData: Partial<FontData>): void;
}

-- The package drops Derma "panelhook" pages (https://wiki.facepunch.com/gmod/DLabel:DoClick).
interface DLabel {
	DoClick(self: DLabel): void;
}

interface DTextEntry {
	OnChange(self: DTextEntry): void;
}

-- Created by garrysmod/lua/vgui/dvscrollbar.lua; not documented on the wiki.
interface DVScrollBar {
	btnGrip: DScrollBarGrip;
	-- Set while the grip is held.
	Dragging?: boolean;
}

-- https://wiki.facepunch.com/gmod/utf8.charpattern
interface Utf8Lib {
	charpattern: string;
}
