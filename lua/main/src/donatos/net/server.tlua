-- Server: actions the client (and the menu through it) requests over the `donatos` net message.

local clientView = require("donatos.client-view")
local item = require("donatos.item")
local netMessage = require("donatos.net")
local serverApi = require("donatos.server-api")
local remoteConfig = require("donatos.utils.load-remote-config")
local serverUtils = require("donatos.server-utils")
local serverPlayer = require("player.server")
local async = require("utils.async")
local log = require("utils.log")
local state = require("utils.state")

local function ok<T>(data: T): { success: true; data: T }
	return { success = true, data = data }
end

local function err(message: string): { success: false; error: string }
	return { success = false, error = message }
end

local NOT_LOADED = "Ошибка: данные игрока не загружены. Попробуйте позднее."
local NOT_IN_INVENTORY = "Ошибка: предмет не найден в инвентаре."
local NOT_FOUND = "Ошибка: товар не найден. Откройте меню заново."
-- Why `item.availability` refused, for the player. The menu shows the reason before that in
-- its own words (`views.unavailableText`).
local UNAVAILABLE: { [K in DonatosUnavailableReason]: string } = {
	notSetUp = "Ошибка: предмет не настроен. Обратитесь к администратору сервера.",
}
local HISTORY_PAGE_SIZE = 20
-- The start of the API's error when `expectedPrice` no longer matches the variant's price.
local PRICE_CHANGED = "Цена товара изменилась"
-- Instead of that error when the server could not get the new price either.
local PRICE_CHANGED_RETRY = "Цена товара изменилась. Откройте меню заново через минуту."

local function findInventoryItem(ply: Player, id: number): DonatosInventoryItem | nil
	for _, inventoryItem in ipairs(ply:Donatos():GetInventoryItems()) do
		if inventoryItem.id == id then
			return inventoryItem
		end
	end
	return nil
end

local function syncConfigTo(ply: Player)
	local config = state.remoteConfig.value
	if config then
		netMessage.toClient(ply, "syncConfig", clientView.config(config))
	end
end

-- The goods and variant the ids name in the cached config, or nil when it has none such. The
-- ids come from a client, so a number sent as a string (or the other way) still matches.
local function cachedVariant(goodsId: unknown, variantId: unknown): (DonatosRemoteConfig["goods"][number] | nil, DonatosGoodsVariant | nil)
	local config = state.remoteConfig.value
	local wantedGoods, wantedVariant = tonumber(goodsId), tostring(variantId)
	if config == nil or wantedGoods == nil then
		return nil, nil
	end
	for _, goods in ipairs(config.goods) do
		if goods.id == wantedGoods then
			for _, variant in ipairs(goods.variants or {}) do
				if variant.id == wantedVariant then
					return goods, variant
				end
			end
		end
	end
	return nil, nil
end

-- A reload syncs every client, so a client cannot trigger them more often than this.
local CONFIG_RELOAD_INTERVAL = 10
local lastConfigReloadAt = -math.huge

-- Reloads the config on a client's behalf, joining a reload in flight; returns whether it
-- loaded, false when one ran too recently.
local reloadConfig = suspend function(): boolean
	if not remoteConfig.isLoading() then
		if RealTime() - lastConfigReloadAt < CONFIG_RELOAD_INTERVAL then
			return false
		end
		lastConfigReloadAt = RealTime()
	end
	return remoteConfig.loadRemoteConfig()
end

-- Gets the player the current prices after the API rejected `input.expectedPrice`;
-- returns whether it did.
local refreshPrices = suspend function(ply: Player, input: DonatosServerActions["purchaseGoods"]["input"]): boolean
	-- The cache already disagrees with the client: only that client is behind (or made the
	-- price up), so it alone gets the cached config.
	local _, variant = cachedVariant(input.goodsId, input.variantId)
	if (variant and variant.price) ~= input.expectedPrice then
		syncConfigTo(ply)
		return true
	end
	-- The cache is stale too.
	return reloadConfig()
end

-- Each player gets a bucket of REQUEST_BURST requests, refilled at REQUEST_RATE per second:
-- enough for the menu's bursts, while a spamming client cannot flood the API (most actions
-- call it with the server's token) or the server.
local REQUEST_BURST = 5
local REQUEST_RATE = 1
local requestBuckets: Table<Player, { tokens: number; at: number }> = setmetatable({}, { __mode = "k" })

local function takeRequestToken(ply: Player): boolean
	local now = RealTime()
	local bucket = requestBuckets[ply]
	if bucket == nil then
		bucket = { tokens = REQUEST_BURST, at = now }
		requestBuckets[ply] = bucket
	end
	bucket.tokens = math.min(REQUEST_BURST, bucket.tokens + (now - bucket.at) * REQUEST_RATE)
	bucket.at = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens = bucket.tokens - 1
	return true
end

-- Reloads the player's data without waiting for it.
local function refreshInBackground(ply: Player)
	async.run(suspend function()
		serverPlayer.of(ply):loadRemoteData()
	end)
end

local type ServerActionHandlers = {
	[K in keyof DonatosServerActions]: suspend (
		ply: Player,
		input: DonatosServerActions[K]["input"]
	) => DonatosServerActions[K]["output"]
}

local handlers: ServerActionHandlers = {
	requestSync = suspend function(ply)
		serverPlayer.of(ply):sync()
		syncConfigTo(ply)
		return ok(true)
	end,

	requestRefresh = suspend function(ply)
		serverPlayer.of(ply):loadRemoteData()
		syncConfigTo(ply)
		return ok(true)
	end,

	createIgsPaymentUrl = suspend function(ply, input)
		local data, error = serverApi.request("server:igs-create-payment-url", {
			playerExternalId = ply:SteamID64(),
			sum = input.sum,
		})

		if data == nil then
			return err(error)
		end

		return ok(data)
	end,

	createOrder = suspend function(ply, input)
		local data, error = serverApi.request("server:create-order", {
			playerExternalId = ply:SteamID64(),
			amount = input.amount,
			email = input.email,
			rememberEmail = input.rememberEmail,
		})

		if data == nil then
			return err(error)
		end

		-- A remembered email reaches the menu with the next update: the API marks the player
		-- changed.
		return ok(data)
	end,

	paymentMethodLink = suspend function(ply, input)
		local data, error = serverApi.request("server:payment-method-link", {
			playerExternalId = ply:SteamID64(),
			orderId = input.orderId,
			method = input.method,
		})

		if data == nil then
			return err(error)
		end

		return ok(data)
	end,

	purchaseGoods = suspend function(ply, input)
		local playerId = ply:Donatos():GetID()
		if not playerId then
			return err(NOT_LOADED)
		end

		-- Only goods this server can judge are sold. Clients get their goods from this cache, so
		-- one it lacks was removed or made up: no reload (a client could force them).
		local goods, variant = cachedVariant(input.goodsId, input.variantId)
		if goods == nil or variant == nil then
			return err(NOT_FOUND)
		end
		-- Bought, it could not be activated.
		local reason = item.availability(goods.key, variant)
		if reason ~= nil then
			return err(UNAVAILABLE[reason])
		end

		local data, error = serverApi.request("player:purchase-goods", {
			playerId = playerId,
			goodsId = goods.id,
			variantId = variant.id,
			expectedPrice = input.expectedPrice,
		})

		if data == nil then
			-- Answer once the menu has the new price, or say it has none yet.
			if string.find(error, PRICE_CHANGED, 1, true) and not refreshPrices(ply, input) then
				return err(PRICE_CHANGED_RETRY)
			end
			return err(error)
		end

		serverPlayer.of(ply):loadRemoteData()

		ply:EmitSound("garrysmod/content_downloaded.wav", 75, 100, 0.3)

		return ok(data)
	end,

	activateItem = suspend function(ply, input)
		local playerId = ply:Donatos():GetID()
		if not playerId then
			return err(NOT_LOADED)
		end

		local inventoryItem = findInventoryItem(ply, input.id)
		if inventoryItem == nil then
			return err(NOT_IN_INVENTORY)
		end

		local goods = inventoryItem.goods
		local reason = goods and item.availability(goods.key, inventoryItem.variant)
		if reason ~= nil then
			return err(UNAVAILABLE[reason])
		end

		local canActivate, message = hook.Run("donatos:preActivateItem", ply, inventoryItem)
		if canActivate == false then
			return err(`Вы не можете активировать этот предмет${message and `: ${message}` or ""}`)
		end

		-- TODO: handle request error
		local data, error = serverApi.request("player:activate-item", {
			playerId = playerId,
			itemId = input.id,
		})

		if data == nil then
			return err(error)
		end

		if not item.invoke(data.goods.key, "_onActivate", ply, data) then
			return err("ВОЗНИКЛА ОШИБКА! Предмет настроен неверно, обратитесь к администратору сервера для возврата.")
		end

		item.invoke(data.goods.key, "_onPlayerJoin", ply, data)

		if not data.order or data.order.isAnonymous == false then
			serverUtils.sendMessage({
				args = { ply, ` активировал предмет "${data.goods.name}"` },
			})
		end
		ply:EmitSound("friends/friend_join.wav", 75, 100, 0.2)

		refreshInBackground(ply)

		return ok(true)
	end,

	giftItem = suspend function(ply, input)
		local playerId = ply:Donatos():GetID()
		if not playerId then
			return err(NOT_LOADED)
		end

		local inventoryItem = findInventoryItem(ply, input.id)
		if inventoryItem == nil then
			return err(NOT_IN_INVENTORY)
		end

		if input.gifteeExternalId == ply:SteamID64() then
			return err("Нельзя подарить предмет самому себе.")
		end

		local giftee: Player | nil = nil
		for _, target in ipairs(player.GetAll()) do
			if target:SteamID64() == input.gifteeExternalId then
				giftee = target
				break
			end
		end
		if giftee == nil then
			return err("Игрок не найден на сервере.")
		end

		local data, error = serverApi.request("player:gift-item", {
			playerId = playerId,
			itemId = input.id,
			gifteeExternalId = input.gifteeExternalId,
		})

		if data == nil then
			return err(error)
		end

		refreshInBackground(ply)
		refreshInBackground(giftee)

		local goods = inventoryItem.goods
		local itemName = goods and goods.name or "предмет"

		serverUtils.sendMessage({
			receiver = ply,
			args = { `Вы подарили предмет "${itemName}" игроку `, giftee, "." },
		})

		serverUtils.sendMessage({
			receiver = giftee,
			args = { ply, ` подарил вам предмет "${itemName}".` },
		})

		giftee:EmitSound("garrysmod/save_load4.wav", 75, 100, 0.25)

		return ok(data)
	end,

	freezeActiveItem = suspend function(ply, input)
		local playerId = ply:Donatos():GetID()
		if not playerId then
			return err(NOT_LOADED)
		end

		local data, error = serverApi.request("player:freeze-active-item", {
			playerId = playerId,
			itemId = input.id,
		})

		if data == nil then
			return err(error)
		end

		-- The load applies the change (`applyFreezes`).
		serverPlayer.of(ply):loadRemoteData()

		return ok(true)
	end,

	unfreezeActiveItem = suspend function(ply, input)
		local playerId = ply:Donatos():GetID()
		if not playerId then
			return err(NOT_LOADED)
		end

		local data, error = serverApi.request("player:unfreeze-active-item", {
			playerId = playerId,
			itemId = input.id,
		})

		if data == nil then
			return err(error)
		end

		-- The load applies the change (`applyFreezes`).
		serverPlayer.of(ply):loadRemoteData()

		return ok(true)
	end,

	getOnlinePlayers = suspend function(ply)
		local onlinePlayers: DonatosOnlinePlayer[] = {}

		for _, target in ipairs(player.GetAll()) do
			local externalId = target:SteamID64()
			if target ~= ply and externalId and #externalId > 0 and externalId ~= "0" then
				local data = target:Donatos()._remoteData.data
				local externalMeta = data and data.player.externalMeta

				table.insert(onlinePlayers, {
					externalId = externalId,
					name = target:Nick(),
					avatarUrl = externalMeta and externalMeta.avatarUrl,
				})
			end
		end

		table.sort(onlinePlayers, function(a: DonatosOnlinePlayer, b: DonatosOnlinePlayer): boolean
			return a.name < b.name
		end)

		return ok(onlinePlayers)
	end,

	getHistory = suspend function(ply, input)
		local playerId = ply:Donatos():GetID()
		if not playerId then
			return err(NOT_LOADED)
		end

		local data, error = serverApi.request("player:get-history", {
			playerId = playerId,
			cursor = input and input.cursor,
			limit = HISTORY_PAGE_SIZE,
		})

		if data == nil then
			-- An API without the action rejects its name as an invalid parameter.
			if error ~= nil and string.find(error, "\"action\"", 1, true) ~= nil then
				return err("История операций пока недоступна")
			end
			return err(error)
		end

		return ok(data)
	end,
}

util.AddNetworkString("donatos")

net.Receive("donatos", function(len: number, ply: Player)
	local nonce = net.ReadUInt(20)
	if not takeRequestToken(ply) then
		netMessage.toClient(ply, "resultFromServer", { nonce, err("Слишком много запросов. Подождите немного.") })
		return
	end
	local message = util.JSONToTable(net.ReadString())
	if message == nil then
		return
	end
	local action = message[1]
	local data = message[2]

	async.run(suspend function()
		-- The action name comes off the wire: look it up untyped.
		local untyped = handlers as Table<string, suspend (ply: Player, input: unknown) => unknown>
		local handler = type(action) == "string" and untyped[action] or nil
		if handler == nil then
			netMessage.toClient(ply, "resultFromServer", { nonce, err("Unknown action") })
			return
		end

		local succeeded, result = pcall(handler, ply, data)
		if succeeded then
			netMessage.toClient(ply, "resultFromServer", { nonce, result })
		else
			log.error(`Error in handleServerMessage[${action}]:`)
			print(result)
			netMessage.toClient(ply, "resultFromServer", {
				nonce,
				err("Внутренняя ошибка сервера. Повторите попытку позже."),
			})
		end
	end)
end)

return {
	handlers = handlers,
}
