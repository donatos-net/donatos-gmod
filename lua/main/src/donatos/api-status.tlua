-- Whether the server can reach the API, replicated to clients so the menu can say it's down
-- instead of loading forever. The server sets it from `donatos.server-api`'s requests.

local GLOBAL = "donatos_api_down"

-- Server.
local function setDown(down: boolean)
	SetGlobal2Bool(GLOBAL, down)
end

local function isDown(): boolean
	return GetGlobal2Bool(GLOBAL, false)
end

return {
	setDown = setDown,
	isDown = isDown,
}
