	-- HeroUI's light theme under the ocean bar, a little deeper so white text holds on it.
	light = {
		label = "Светлая",
		swatch = { 244, 244, 245 },
		light = true,
		accent = { 4, 133, 247 },
		accentForeground = SNOW,
		-- A step below HeroUI's whites: over a game a full-white window glares.
		tint = { -12, -12, -12 },
