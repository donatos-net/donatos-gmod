	},
	-- No colour: a grey bar, and white as the accent with dark text on it.
	graphite = {
		label = "Графит",
		swatch = { 113, 113, 122 },
		light = false,
		accent = SNOW,
		accentForeground = ECLIPSE,
		tint = { 0, 0, 0 },
		gradient = { { 40, 40, 44 }, { 52, 52, 57 }, { 36, 36, 40 }, { 47, 47, 52 } },
		strength = 1,
		vivid = { { 161, 161, 170 }, { 228, 228, 231 }, { 113, 113, 122 }, { 212, 212, 216 } },
