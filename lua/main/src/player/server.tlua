local clientView = require("donatos.client-view")
local item = require("donatos.item")
local netMessage = require("donatos.net")
local serverApi = require("donatos.server-api")
local serverUtils = require("donatos.server-utils")
local savedItems = require("player.saved-items")
local shared = require("player.shared")
local log = require("utils.log")
local state = require("utils.state")

-- Server-only methods, falling back to the shared ones.
local SERVER_PLAYER = setmetatable({}, { __index = shared.PLAYER })
local SERVER_PLAYER_META = { __index = SERVER_PLAYER }

interface DonatosServerPlayer extends DonatosPlayer, Omit<typeof SERVER_PLAYER, "__index"> {
	-- Loads can overlap (the update poll, a purchase, the menu's refresh) and finish out of
	-- order: each is numbered when it starts, and one older than the last applied is dropped.
	_loadSeq: number;
	_appliedSeq: number;
}

suspend function SERVER_PLAYER.loadRemoteData(self: DonatosServerPlayer): (DonatosRemoteData, nil) | (nil, string)
	local ply = self._ply
	self._loadSeq = self._loadSeq + 1
	local seq = self._loadSeq
	log.info(`Loading data for player ${ply:SteamID()} (${ply:Nick()})`)

	local data, err = serverApi.request("server:get-player", {
		playerExternalId = ply:SteamID64(),
		setName = ply:Nick(),
	})

	if err ~= nil then
		-- An outage is logged once, by the API client; only it brings in the saved items (an API
		-- answering with an error, or a missing token, is no reason to trust them).
		if err ~= serverApi.UNAVAILABLE then
			log.error(`Failed to load data for player ${ply:SteamID()} (${ply:Nick()}): ${err}`)
		elseif not self._remoteData.isLoaded and self._savedActiveItems == nil then
			local items = savedItems.load(ply)
			self._savedActiveItems = items
			if items ~= nil then
				self._itemsLoadedAt = SysTime()
				self:scheduleExpiry()
				log.info(`Using ${#items} saved active items for player ${ply:SteamID()} until the API answers`)
			end
		end
		return nil, err
	end

	-- A newer load already applied fresher data; this one's is stale.
	if seq < self._appliedSeq then
		return data, nil
	end
	self._appliedSeq = seq

	log.info(`Loaded data for player ${ply:SteamID()} (${ply:Nick()})`)

	local wasLoaded = self._remoteData.isLoaded
	local prevData = self._remoteData.data
	local prevBalance = prevData and prevData.player.balance

	self._remoteData = { isLoaded = true, data = data }
	self._savedActiveItems = nil
	self._itemsLoadedAt = SysTime()
	self:scheduleExpiry()
	if wasLoaded and prevData and data then
		self:applyFreezes(prevData.activeItems, data.activeItems)
	end
	savedItems.save(ply, data)
	netMessage.toClient(ply, "syncPlayer", clientView.player(data))

	if prevBalance and prevBalance < self:GetBalance() then
		self:print(`Ваш баланс пополнен на ${self:GetBalance() - prevBalance}`)
		ply:EmitSound("garrysmod/save_load4.wav", 75, 100, 0.25)
	end

	if not wasLoaded and data then
		if data.player.balance > 0 then
			self:print(`Вам доступно ${data.player.balance} р.`)
		end
		if #data.inventoryItems > 0 then
			local names: string[] = {}
			for _, inventoryItem in ipairs(data.inventoryItems) do
				local goods = inventoryItem.goods
				table.insert(names, goods and goods.name or "???")
			end
			self:print(`У вас есть неактивированные предметы в инвентаре: ${table.concat(names, ", ")}`)
		end
	end

	return data, nil
end

function SERVER_PLAYER.sync(self: DonatosServerPlayer)
	if self._remoteData.isLoaded then
		netMessage.toClient(self._ply, "syncPlayer", clientView.player(self._remoteData.data))
	end
end

function SERVER_PLAYER.print(self: DonatosServerPlayer, ...: string | Player | Color)
	serverUtils.sendMessage({ receiver = self._ply, args = { ... } })
end

-- `items` without the ones that ran out `elapsed` seconds after they were had, or nil when none did.
local function unexpired(items: DonatosActiveItem[], elapsed: number): DonatosActiveItem[] | nil
	local kept: DonatosActiveItem[] = {}
	for _, itm in ipairs(items) do
		local expires = itm.expires
		-- A frozen item's expiry moves when it thaws.
		if itm.isFrozen or expires == nil or expires.inS > elapsed then
			table.insert(kept, itm)
		end
	end
	return #kept < #items and kept or nil
end

-- Drops the active items (loaded or saved) that have run out since they were had, as the API
-- does at the player's next load (an expiry isn't a change it reloads them for), and takes back
-- a SAM rank one gave. Join handlers don't run again: the player hasn't joined. Run by the timer
-- `scheduleExpiry` sets.
function SERVER_PLAYER.dropExpiredItems(self: DonatosServerPlayer)
	local loadedAt = self._itemsLoadedAt
	if loadedAt == nil then
		return
	end
	local kept = unexpired(self:GetActiveItems(), SysTime() - loadedAt)
	if kept ~= nil then
		local data = self._remoteData.data
		if data ~= nil then
			data.activeItems = kept
			self:sync()
		else
			self._savedActiveItems = kept
		end
		log.info(`Active items of player ${self._ply:SteamID()} ran out`)
		self:applySamRanks()
	end
	self:scheduleExpiry()
end

-- Further off than this, an expiry gets no timer: a rejoin, map change or purchase loads the
-- player first (and the API drops the item at that load if it has run out).
local EXPIRY_HORIZON = 24 * 60 * 60

-- Sets the player's expiry timer for when the first of their active items runs out, replacing
-- the one set before; called whenever the items change. `expires.inS` counts from when they
-- were had, so the server's clock doesn't matter.
function SERVER_PLAYER.scheduleExpiry(self: DonatosServerPlayer)
	local ply = self._ply
	local name = state.hookId(`expiry_${ply:SteamID64()}`)
	-- Had by an older bundle's run, which didn't note when: counted from now.
	local loadedAt = self._itemsLoadedAt or SysTime()
	self._itemsLoadedAt = loadedAt
	local soonest: number | nil = nil
	for _, itm in ipairs(self:GetActiveItems()) do
		local expires = itm.expires
		if not itm.isFrozen and expires ~= nil and (soonest == nil or expires.inS < soonest) then
			soonest = expires.inS
		end
	end
	local delay = soonest and math.max(loadedAt + soonest - SysTime(), 0)
	if delay == nil or delay > EXPIRY_HORIZON then
		timer.Remove(name)
		return
	end
	timer.Create(name, delay, 1, function()
		-- A newer bundle sets its own timers for the same players.
		if not state.hasInstanceChanged() and IsValid(ply) then
			(ply:Donatos() as DonatosServerPlayer):dropExpiredItems()
		end
	end)
end

-- Gives the player the SAM rank of their newest active rank item when they have none of their
-- own, and takes back a donated rank no active item gives any more.
function SERVER_PLAYER.applySamRanks(self: DonatosServerPlayer)
	local ply = self._ply

	local setRank = ply.sam_set_rank
	if setRank ~= nil then
		local getRank = ply.sam_getrank
		local getNwVar = ply.sam_get_nwvar
		local plySamRank = getRank and getRank(ply)
		if plySamRank == nil then
			plySamRank = getNwVar and getNwVar(ply, "rank", "user")
		end
		plySamRank = plySamRank or ply:GetUserGroup()

		local purchasedSamRanks: Table<string, true> = {}
		local highestRank: DonatosActiveItem | nil = nil

		for _, itm in ipairs(self:GetActiveItems()) do
			if not itm.isFrozen then
				local donatosItem = state.items[itm.goods.key]
				local samRank = donatosItem and donatosItem.meta.samRank
				if samRank then
					purchasedSamRanks[samRank] = true

					if highestRank == nil or itm.activatedAt > highestRank.activatedAt then
						highestRank = itm
					end
				end
			end
		end

		if state.knownSamRanks[plySamRank] and not purchasedSamRanks[plySamRank] then
			log.info(`Removing expired SAM rank ${plySamRank} from user ${ply:SteamID()}`)
			setRank(ply, "user")
			-- Free for another rank item's rank, below.
			plySamRank = "user"
		end

		-- dont override currently assigned custom rank
		if plySamRank == "user" and highestRank ~= nil then
			local donatosItem = state.items[highestRank.goods.key]
			local samRank = donatosItem and donatosItem.meta.samRank
			if samRank then
				setRank(ply, samRank)
			end
		end
	end
end

-- Applies what freezing or thawing items (in the menu or on the site) changed between two loads:
-- SAM ranks follow the unfrozen items, and a thawed item's join handlers run. A frozen item's
-- other effects last until the player rejoins, as an expired one's do.
function SERVER_PLAYER.applyFreezes(self: DonatosServerPlayer, before: DonatosActiveItem[], after: DonatosActiveItem[])
	local wasFrozen: Table<number, boolean> = {}
	for _, itm in ipairs(before) do
		wasFrozen[itm.id] = itm.isFrozen
	end
	local thawed: DonatosActiveItem[] = {}
	local changed = false
	for _, itm in ipairs(after) do
		local was = wasFrozen[itm.id]
		if was ~= nil and was ~= itm.isFrozen then
			changed = true
			if was then
				table.insert(thawed, itm)
			end
		end
	end
	if not changed then
		return
	end
	self:applySamRanks()
	for _, itm in ipairs(thawed) do
		item.invoke(itm.goods.key, "_onPlayerJoin", self._ply, { goods = itm.goods })
	end
end

-- Applies the player's active items (saved ones until the first load): SAM ranks, then each
-- item's join handlers.
function SERVER_PLAYER.onPlayerJoined(self: DonatosServerPlayer)
	if not self:IsLoaded() and self._savedActiveItems == nil then
		return
	end
	self:applySamRanks()

	local ply = self._ply
	for _, itm in ipairs(self:GetActiveItems()) do
		if not itm.isFrozen then
			item.invoke(itm.goods.key, "_onPlayerJoin", ply, { goods = itm.goods })
		end
	end
end

local function new(ply: Player): DonatosServerPlayer
	return setmetatable(
		{ _ply = ply, _remoteData = { isLoaded = false, data = nil }, _loadSeq = 0, _appliedSeq = 0 },
		SERVER_PLAYER_META
	)
end

-- `ply:Donatos()` on the server.
local function of(ply: Player): DonatosServerPlayer
	return ply:Donatos() as DonatosServerPlayer
end

return {
	new = new,
	of = of,
}
