local BLUE_1 = Color(231, 245, 255)
local BLUE_3 = Color(165, 216, 255)
local BLUE_6 = Color(51, 154, 240)
local ORANGE_6 = Color(255, 146, 43)
local RED_6 = Color(255, 107, 107)

local log = {}

function log.addText(...: any)
	chat.AddText(BLUE_6, "[Donatos] ", BLUE_1, ...)
end

function log.debug(str: string)
	MsgC(BLUE_3, "[Donatos] [DEBUG] ", str, "\n")
end

function log.info(str: string)
	MsgC(BLUE_6, "[Donatos] [INFO] ", str, "\n")
end

function log.warn(str: string)
	MsgC(ORANGE_6, "[Donatos] [WARN] ", str, "\n")
end

function log.error(str: string)
	MsgC(RED_6, "[Donatos] [ERROR] ", str, "\n")
end

return log
