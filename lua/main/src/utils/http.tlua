local async = require("utils.async")
local log = require("utils.log")

local interface HttpRequest {
	url: string;
	method?: string;
	headers?: Table<string, string>;
	body?: string;
	-- Seconds until the request counts as failed; DEFAULT_TIMEOUT when not given.
	timeout?: number;
}

local interface HttpResponse {
	code: number;
	body: string;
	headers: Table<string, string>;
}

local type HttpOutcome =
	| { ok: true; response: HttpResponse }
	| { ok: false; reason: string }

-- Servers whose own HTTP fails to reach the API (GMod's goes through Steam's) often install a
-- module that sends requests itself, with HTTP's arguments: reqwest (gmsv_reqwest) or CHTTP
-- (gmsv_chttp). The first one installed is used, GMod's HTTP otherwise.
local function pickSend(): (parameters: HTTPRequest) => boolean
	for _, module in ipairs({ { name = "reqwest", global = "reqwest" }, { name = "chttp", global = "CHTTP" } }) do
		if util.IsBinaryModuleInstalled(module.name) and pcall(require, module.name) then
			local send = (_G as Table<string, unknown>)[module.global]
			if type(send) == "function" then
				log.info(`Sending HTTP requests with ${module.global}`)
				return send as (parameters: HTTPRequest) => boolean
			end
		end
	end
	return HTTP
end

local send = pickSend()

-- GMod's own default. Our timer enforces it for backends that don't.
local DEFAULT_TIMEOUT = 60

local request = suspend function(parameters: HttpRequest): (HttpResponse, nil) | (nil, string)
	local timeout = parameters.timeout or DEFAULT_TIMEOUT
	local outcome = async.await(function(resolve: (value: HttpOutcome) => void)
		-- Our own timer too: not every backend honours `timeout`. Whichever comes first counts.
		timer.Simple(timeout, function()
			resolve({ ok = false, reason = `timed out after ${timeout}s` })
		end)
		-- false when the backend couldn't start the request; it calls neither callback then.
		local started = send({
			url = parameters.url,
			method = parameters.method or "GET",
			headers = parameters.headers,
			body = parameters.body,
			timeout = timeout,
			success = function(code: number, body: string, headers: Table<string, string>)
				resolve({ ok = true, response = { code = code, body = body, headers = headers } })
			end,
			-- reqwest's reason is HTTP's "unsuccessful"; the actual error comes after it.
			failed = function(reason: string, detail?: string)
				resolve({ ok = false, reason = detail ~= nil and `${reason}: ${detail}` or reason })
			end,
		})
		if started == false then
			resolve({ ok = false, reason = "the request couldn't be started" })
		end
	end)

	if outcome.ok then
		return outcome.response, nil
	end
	return nil, outcome.reason
end

return {
	request = request,
}
