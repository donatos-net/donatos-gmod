-- Client: the web UI in a DHTML panel, and the `window.donatosLua` bridge it calls.

local netMessage = require("donatos.net")
local async = require("utils.async")
local log = require("utils.log")
local state = require("utils.state")

-- The build replaces this literal with the UI's HTML.
local html = "__DONATOS_HTML__"

local webPanelState = state.webPanel

local webPanelLastUsedAt = RealTime()

local function markWebPanelUsed()
	webPanelLastUsedAt = RealTime()
end

local function getPanelInstance(): DHTML | nil
	local panel = webPanelState.panel
	if panel ~= nil and IsValid(panel) then
		return panel
	end
	return nil
end

local function queueJsonCallback(panel: DHTML, fnName: string, callbackId: number, value: unknown)
	local payload = util.TableToJSON({ value = value })
	local safePayload = string.JavascriptSafe(payload or "{}")
	panel:QueueJavascript(`window.donatosNative.${fnName}(${callbackId}, JSON.parse('${safePayload}').value)`)
end

local function pushStateTo(panel: DHTML, key: string, value: unknown)
	local payload = util.TableToJSON({ value = value })
	local safeKey = string.JavascriptSafe(key)
	local safePayload = string.JavascriptSafe(payload or "{}")
	panel:QueueJavascript(`window.donatosNative?.setState?.('${safeKey}', JSON.parse('${safePayload}').value)`)
end

local function pushState(key: string, value: unknown)
	local panel = getPanelInstance()
	if panel ~= nil then
		pushStateTo(panel, key, value)
	end
end

local function destroyPanel()
	local panel = webPanelState.panel
	if IsValid(panel) then
		panel:Remove()
	end
	webPanelState.panel = nil
end

local function paintLoadingOverlay(self: Panel, w: number, h: number): boolean
	draw.RoundedBox(w * 0.01, 0, 0, w, h, Color(10, 12, 14, 254))

	local barWidth = math.min(420, w * 0.7)
	local barHeight = math.min(10, w * 0.005)
	local barX = (w - barWidth) / 2
	local barY = h / 2 - barHeight / 2
	local chunkWidth = barWidth * 0.28
	local travel = barWidth - chunkWidth
	local speed = 600
	local tick = (RealTime() * speed) % (travel * 2)
	local chunkOffset = tick > travel and travel * 2 - tick or tick

	draw.RoundedBox(w * 0.01, barX, barY, barWidth, barHeight, Color(255, 255, 255, 28))
	draw.RoundedBox(w * 0.01, barX + chunkOffset, barY, chunkWidth, barHeight, Color(255, 255, 255, 235))
	return false
end

local function createPanel(): DHTML
	destroyPanel()

	log.debug("Creating Web UI")

	local panel = vgui.Create("DHTML") as DHTML
	webPanelState.panel = panel

	panel:SetSize(math.min(2000, ScrW() / 2), ScrH() / 2)
	panel:SetKeyboardInputEnabled(true)
	panel:SetMouseInputEnabled(true)
	panel:Center()

	local loadingOverlay: DPanel | nil = vgui.Create("DPanel", panel) as DPanel
	loadingOverlay:SetPos(0, 0)
	loadingOverlay:SetSize(panel:GetWide(), panel:GetTall())
	loadingOverlay:SetAlpha(0)
	loadingOverlay:AlphaTo(255, 0.1)
	loadingOverlay:SetZPos(32767)
	loadingOverlay.Paint = paintLoadingOverlay

	local function removeLoadingOverlay()
		local overlay = loadingOverlay
		if overlay == nil or not IsValid(overlay) then
			return
		end

		overlay:Stop()

		overlay:AlphaTo(0, 0.5, 0, function(_, targetPanel: Panel)
			loadingOverlay = nil
			if IsValid(targetPanel) then
				targetPanel:Remove()
			end
		end)
	end

	panel:AddFunction("donatosLua", "netMessageToServer", function(callbackId: number, action: string, dataJson?: string)
		local data = dataJson and util.JSONToTable(dataJson) or nil

		local sent, sendError = pcall(
			netMessage.toServer,
			action as keyof DonatosServerActions,
			data as never,
			function(result: unknown)
				queueJsonCallback(panel, "_resolveCallback", callbackId, result)
			end
		)
		if not sent then
			queueJsonCallback(panel, "_rejectCallback", callbackId, { error = tostring(sendError) })
		end
	end)
	panel:AddFunction("donatosLua", "openUrl", function(url: string)
		gui.OpenURL(url)
	end)
	panel:AddFunction("donatosLua", "closeUi", function()
		markWebPanelUsed()
		panel:SetVisible(false)
	end)
	panel:AddFunction("donatosLua", "uiReady", function()
		removeLoadingOverlay()
	end)
	panel:AddFunction("donatosLua", "requestStateSync", function()
		pushStateTo(panel, "serverConfig", state.remoteConfig.value)
		local localPlayer = LocalPlayer()
		if IsValid(localPlayer) then
			pushStateTo(panel, "playerExternalId", localPlayer:SteamID64())
			local remoteData = localPlayer:Donatos()._remoteData
			if remoteData.isLoaded then
				pushStateTo(panel, "playerData", remoteData.data)
			end
		end
	end)

	panel.OnDocumentReady = function()
		local zoom = math.min(ScrW() / 1920, ScrH() / 1080)
		if zoom > 1 then
			panel:QueueJavascript(`document.documentElement.style.zoom = '${zoom}'`)
		end
	end

	-- TODO: how to prevent shift click?
	local dev = donatos.dev
	local devUrl = dev and dev.enabled and dev.webUiUrl or nil
	if devUrl and #devUrl > 0 then
		panel:OpenURL(devUrl)
	else
		panel:SetHTML(html)
	end

	return panel
end

local function open(tab?: string): DHTML
	markWebPanelUsed()

	local dev = donatos.dev
	if dev and dev.enabled then
		createPanel()
	end

	local panel = getPanelInstance() or createPanel()

	-- Show and focus panel
	panel:SetVisible(true)
	panel:MakePopup()

	if tab then
		log.debug(`Web UI opened with tab: ${tab}`)
	end

	return panel
end

local function performGc()
	local panel = webPanelState.panel
	if panel == nil then
		return
	end

	if not IsValid(panel) then
		webPanelState.panel = nil
		return
	end

	if panel:IsVisible() or RealTime() - webPanelLastUsedAt < 5 * 60 then
		return
	end

	destroyPanel()
end

destroyPanel()

hook.Add("GUIMousePressed", state.hookId("web_ui"), function()
	local panel = getPanelInstance()
	if panel ~= nil then
		panel:SetVisible(false)
	end
end)

async.run(suspend function()
	while true do
		state.delay(60)
		performGc()
	end
end)

return {
	open = open,
	pushState = pushState,
}
