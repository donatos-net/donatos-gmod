-- Client: the menu's building blocks. A block is a panel that lays itself out for a given
-- width and reports the height it needs; containers (stack, grid) compose blocks.
-- Option tables passed to widgets stay live: painting reads them every frame, so changing
-- `options.pending` or `options.label` updates the widget in place.

local images = require("ui.images")
local theme = require("ui.theme")

local colors = theme.colors
local px = theme.px

interface DonatosUiBlock {
	panel: Panel;
	-- Positions the block's children for `width` and returns the height it needs.
	layout: (width: number) => number;
}

local function blankPanel(parent: Panel): Panel
	local panel = vgui.Create("DPanel", parent)
	panel.Paint = function(self: Panel, w: number, h: number): boolean
		return true
	end
	return panel
end

------------------------------------------------------------------------------ text

interface DonatosUiTextOptions {
	text: string;
	font: string;
	color: Color;
	-- Line height in the design's CSS pixels; the font's own height when unset.
	lineHeight?: number;
	maxLines?: number;
	align?: "left" | "center";
}

local function text(parent: Panel, options: DonatosUiTextOptions): DonatosUiBlock
	local panel = vgui.Create("DPanel", parent)
	panel:SetMouseInputEnabled(false)
	local lines: string[] = {}
	local lineHeight = 0
	local fontHeight = 0

	panel.Paint = function(self: Panel, w: number, h: number): boolean
		surface.SetFont(options.font)
		surface.SetTextColor(options.color)
		local inset = (lineHeight - fontHeight) / 2
		for i, line in ipairs(lines) do
			local x = 0
			if options.align == "center" then
				local lineWidth = surface.GetTextSize(line)
				x = (w - lineWidth) / 2
			end
			surface.SetTextPos(x, (i - 1) * lineHeight + inset)
			surface.DrawText(line)
		end
		return true
	end

	return {
		panel = panel,
		layout = function(width: number): number
			local maxLines = options.maxLines
			lines = maxLines ~= nil and theme.clamp(options.text, options.font, width, maxLines)
				or theme.wrap(options.text, options.font, width)
			fontHeight = theme.fontHeight(options.font)
			lineHeight = options.lineHeight ~= nil and math.max(px(options.lineHeight), fontHeight) or fontHeight
			return #lines * lineHeight
		end,
	}
end

-- A fixed-height block that draws with `paint`.
local function painted(parent: Panel, height: number, paint: (w: number, h: number) => void): DonatosUiBlock
	local panel = vgui.Create("DPanel", parent)
	panel:SetMouseInputEnabled(false)
	panel.Paint = function(self: Panel, w: number, h: number): boolean
		paint(w, h)
		return true
	end
	return {
		panel = panel,
		layout = function(): number
			return height
		end,
	}
end

local CHIP_ICON, CHIP_ICON_GAP = 12, 4

local function chipWidth(label: string, icon?: DonatosIcon): number
	local w = theme.textSize(label, theme.font("chip")) + px(16)
	return icon ~= nil and w + px(CHIP_ICON) + px(CHIP_ICON_GAP) - px(2) or w
end

-- A rounded pill label (the design's Chip), with `icon` before the text, drawn at (x, y);
-- returns its width.
local function chip(label: string, x: number, y: number, background: Color, foreground: Color, icon?: DonatosIcon): number
	local font = theme.font("chip")
	local w = chipWidth(label, icon)
	local h = px(20)
	theme.box(h / 2, x, y, w, h, background)
	if icon ~= nil then
		-- A little less padding before an icon than before text, as HeroUI's chips have.
		local size = px(CHIP_ICON)
		theme.icon(icon, x + px(6), y + (h - size) / 2, size, foreground)
		draw.SimpleText(label, font, x + px(6) + size + px(CHIP_ICON_GAP), y + h / 2, foreground, TEXT_ALIGN_LEFT, TEXT_ALIGN_CENTER)
	else
		draw.SimpleText(label, font, x + w / 2, y + h / 2, foreground, TEXT_ALIGN_CENTER, TEXT_ALIGN_CENTER)
	end
	return w
end

------------------------------------------------------------------------------ containers

-- Blocks top to bottom with `gap` between them, inset by `padding` (or `padX` / `padY`).
local function stack(
	parent: Panel,
	gap: number,
	padding?: number,
	padY?: number
): (DonatosUiBlock, (child: DonatosUiBlock) => void)
	local panel = blankPanel(parent)
	local children: DonatosUiBlock[] = {}
	local padX = padding or 0
	local padTop = padY or padX

	local block: DonatosUiBlock = {
		panel = panel,
		layout = function(width: number): number
			local y = padTop
			for i, child in ipairs(children) do
				local h = child.layout(width - padX * 2)
				child.panel:SetPos(padX, y)
				child.panel:SetSize(width - padX * 2, h)
				y = y + h + (i < #children and gap or 0)
			end
			return y + padTop
		end,
	}
	return block, function(child: DonatosUiBlock)
		table.insert(children, child)
	end
end

-- `columns` equal columns; every cell in a row takes the row's height.
local function grid(parent: Panel, columns: number, gap: number): (DonatosUiBlock, (child: DonatosUiBlock) => void)
	local panel = blankPanel(parent)
	local children: DonatosUiBlock[] = {}

	local block: DonatosUiBlock = {
		panel = panel,
		layout = function(width: number): number
			local cellWidth = (width - gap * (columns - 1)) / columns
			local y = 0
			local rowStart = 1
			while rowStart <= #children do
				local rowEnd = math.min(rowStart + columns - 1, #children)
				local rowHeight = 0
				for i = rowStart, rowEnd do
					local child = assert(children[i])
					rowHeight = math.max(rowHeight, child.layout(math.floor(cellWidth)))
				end
				for i = rowStart, rowEnd do
					local child = assert(children[i])
					local column = i - rowStart
					child.panel:SetPos(math.floor(column * (cellWidth + gap)), y)
					child.panel:SetSize(math.floor(cellWidth), rowHeight)
				end
				y = y + rowHeight + (rowEnd < #children and gap or 0)
				rowStart = rowEnd + 1
			end
			return y
		end,
	}
	return block, function(child: DonatosUiBlock)
		table.insert(children, child)
	end
end

-- Lays panels left to right, wrapping, each at its own size.
local function flow(parent: Panel, gap: number, padding: number, panels: Panel[]): DonatosUiBlock
	local panel = blankPanel(parent)
	for _, child in ipairs(panels) do
		child:SetParent(panel)
	end
	return {
		panel = panel,
		layout = function(width: number): number
			local x, y, rowHeight = padding, padding, 0
			for _, child in ipairs(panels) do
				local w, h = child:GetSize()
				if x > padding and x + w > width - padding then
					x = padding
					y = y + rowHeight + gap
					rowHeight = 0
				end
				child:SetPos(x, y)
				x = x + w + gap
				rowHeight = math.max(rowHeight, h)
			end
			return y + rowHeight + padding
		end,
	}
end

interface DonatosUiScroll {
	panel: Panel;
	-- Holds the content; moved up by the scroll offset.
	canvas: Panel;
	-- The offset now, from 0 to `maxScroll()`.
	scroll: () => number;
	maxScroll: () => number;
	-- Jumps to `offset`, stopping a glide.
	setScroll: (offset: number) => void;
	-- Glides to `offset` over `duration` seconds.
	scrollTo: (offset: number, duration: number) => void;
}

-- A scroll area whose content is one block, laid out to the area's width. It is a plain panel
-- with its own offset and grip, not DScrollPanel: servers run addons that make DVScrollBar
-- smooth for every panel, and their easing fought ours.
local function scroll(parent: Panel, content: (canvas: Panel) => DonatosUiBlock): DonatosUiScroll
	local area = vgui.Create("Panel", parent)
	local canvas = vgui.Create("Panel", area)
	local bar = vgui.Create("Panel", area)
	bar:SetVisible(false)
	local grip = vgui.Create("Panel", bar)
	grip.Paint = function(self: Panel, w: number, h: number): boolean
		theme.box(px(3), px(2), 0, w - px(4), h, colors.scrollGrip)
		return true
	end

	local offset = 0
	local function maxScroll(): number
		return math.max(canvas:GetTall() - area:GetTall(), 0)
	end
	local function place()
		local w, h = bar:GetWide(), area:GetTall()
		local total = canvas:GetTall()
		if total <= h or h <= 0 then
			return
		end
		local gripHeight = math.max(math.Round(h * h / total), px(32))
		grip:SetSize(w, gripHeight)
		grip:SetPos(0, math.Round((h - gripHeight) * offset / (total - h)))
	end
	local function apply(value: number)
		offset = math.Clamp(value, 0, maxScroll())
		canvas:SetPos(0, -math.Round(offset))
		place()
	end

	-- The wheel glides: each step eases 100px over 300ms (ease-out-quart), and steps in a row
	-- add up. Dragging the grip or a jump takes over at once.
	local glide = theme.tween(0)
	local glideTarget: number | nil = nil
	local function scrollTo(target: number, duration: number)
		glideTarget = math.Clamp(target, 0, maxScroll())
		glide.set(offset)
		glide.to(glideTarget, duration, "outQuart")
	end
	local function setScroll(value: number)
		glideTarget = nil
		apply(value)
	end
	area.OnMouseWheeled = function(self: Panel, delta: number): boolean
		if maxScroll() <= 0 then
			return false
		end
		scrollTo((glideTarget or offset) - delta * px(100), 0.3)
		return true
	end

	-- Dragging the grip moves the content with it; a click on the track pages towards the click.
	local dragFrom: number | nil = nil
	grip.OnMousePressed = function(self: Panel, key: number): boolean
		if key == MOUSE_LEFT then
			local _, y = self:CursorPos()
			dragFrom = y
			glideTarget = nil
			self:MouseCapture(true)
		end
		return true
	end
	grip.OnMouseReleased = function(self: Panel, key: number): boolean
		dragFrom = nil
		self:MouseCapture(false)
		return true
	end
	bar.OnMousePressed = function(self: Panel, key: number)
		if key == MOUSE_LEFT then
			local _, y = self:CursorPos()
			local page = area:GetTall() * 0.9
			scrollTo((glideTarget or offset) + (y < grip:GetY() and -page or page), 0.3)
		end
		return true
	end

	local driver = vgui.Create("Panel", area)
	driver:SetSize(0, 0)
	driver:SetMouseInputEnabled(false)
	driver.Think = function(self: Panel)
		local from = dragFrom
		if from ~= nil then
			if not input.IsMouseDown(MOUSE_LEFT) then
				dragFrom = nil
				grip:MouseCapture(false)
				return
			end
			local _, y = bar:CursorPos()
			local track = area:GetTall() - grip:GetTall()
			if track > 0 then
				apply((y - from) / track * maxScroll())
			end
			return
		end
		local target = glideTarget
		if target == nil then
			return
		end
		apply(glide.done() and target or glide.value())
		if glide.done() then
			glideTarget = nil
		end
	end

	-- Laid out narrower by the bar while the content is taller than the area.
	local block = content(canvas)
	area.PerformLayout = function(self: Panel, w: number, h: number)
		local barWidth = px(8)
		local height = block.layout(w - barWidth)
		local scrolls = height > h
		local width = w - barWidth
		if not scrolls then
			width = w
			height = block.layout(w)
		end
		block.panel:SetPos(0, 0)
		block.panel:SetSize(width, height)
		canvas:SetSize(width, height)
		bar:SetVisible(scrolls)
		bar:SetPos(w - barWidth, 0)
		bar:SetSize(barWidth, h)
		apply(offset)
	end

	return {
		panel = area,
		canvas = canvas,
		scroll = function()
			return offset
		end,
		maxScroll = maxScroll,
		setScroll = setScroll,
		scrollTo = scrollTo,
	}
end

------------------------------------------------------------------------------ buttons

-- HeroUI's button variants; "segment" is a tab on the gradient top bar.
-- "shade" is a translucent button on the gradient top bar.
type DonatosUiButtonVariant = "primary" | "secondary" | "soft" | "light" | "ghost" | "segment" | "shade"

interface DonatosUiButton {
	label?: string;
	icon?: DonatosIcon;
	variant?: DonatosUiButtonVariant;
	-- Heights: lg 40, md 36 (the default), sm 32, xs 28.
	size?: "lg" | "md" | "sm" | "xs";
	active?: boolean;
	-- Tabs: where the sliding selection is, as its left and right edges in the tab's own x.
	-- Under it the text and badge are drawn dark, clipped to its edges, so they stay
	-- readable while it moves.
	selection?: () => (number, number);
	badge?: number;
	pending?: boolean;
	disabled?: boolean;
	-- Stretch to the width the parent gives instead of fitting the label.
	fill?: boolean;
	-- Draw as a select trigger: the label on the left (muted while `placeholder`), a chevron on
	-- the right.
	select?: boolean;
	placeholder?: boolean;
	-- A brand's own colours instead of the variant's: fill, hovered fill, text.
	brand?: { fill: Color; hover: Color; ink: Color };
	-- A logo after the label: a PNG from `url` (downloaded like goods images), `aspect` times as
	-- wide as high; `fallback` is drawn instead until it is ready, or if it can't be had.
	logo?: { url: string; id: string; aspect: number; fallback: string };
	onClick?: (button: DButton) => void;
}

local BUTTON_HEIGHTS = { lg = 40, md = 36, sm = 32, xs = 28 }
local BUTTON_PADDING = { lg = 20, md = 16, sm = 14, xs = 12 }

local function buttonFont(options: DonatosUiButton): string
	return options.size == "xs" and theme.font("smallMedium") or theme.font("medium")
end

local function badgeWidth(badgeText: string): number
	return math.max(theme.textSize(badgeText, theme.font("chip")) + px(12), px(18))
end

-- A logo's height in its button's.
local LOGO_SCALE = 0.52

local function buttonMetrics(options: DonatosUiButton): (number, number)
	local size = options.size or "md"
	local height = px(BUTTON_HEIGHTS[size])
	if options.label == nil and options.icon ~= nil then
		return height, height
	end
	local padX = px(BUTTON_PADDING[size])
	local width = theme.textSize(options.label or "", buttonFont(options)) + padX * 2
	if options.badge ~= nil and options.badge > 0 then
		width = width + px(6) + badgeWidth(tostring(options.badge)) - px(2)
	end
	if options.icon ~= nil then
		width = width + px(16) + px(8)
	end
	local logo = options.logo
	if logo ~= nil then
		width = width + math.Round(height * LOGO_SCALE) * logo.aspect + (options.label ~= nil and px(7) or 0)
	end
	return width, height
end

local TAB_HOVER_INK = theme.fade(colors.barText, 0.7)

local function buttonColors(options: DonatosUiButton, hovered: boolean): (Color | nil, Color)
	local brand = options.brand
	if brand ~= nil then
		return hovered and brand.hover or brand.fill, brand.ink
	end
	local variant = options.variant or "primary"
	if variant == "primary" then
		return hovered and colors.accentHover or colors.accent, colors.accentInk
	elseif variant == "secondary" then
		return hovered and colors.defaultHover or colors.default, colors.text
	elseif variant == "soft" then
		return hovered and colors.accentSoftHover or colors.accentSoft, colors.accentText
	elseif variant == "light" then
		return hovered and colors.barPillHover or colors.barPill, colors.barPillText
	elseif variant == "shade" then
		return hovered and colors.barSelected or colors.barShade, colors.barText
	elseif variant == "segment" then
		-- HeroUI's tabs: the tab list draws the selected indicator (white here); an unselected
		-- tab dims to 70% while hovered.
		return nil, hovered and TAB_HOVER_INK or colors.barText
	end
	-- ghost
	return hovered and colors.default or nil, hovered and colors.text or colors.muted
end

-- HeroUI's pressed scale: by size, and smaller for icon-only (close) buttons; tabs don't scale.
local function pressScale(options: DonatosUiButton): number
	if options.variant == "segment" then
		return 1
	elseif options.label == nil and options.icon ~= nil then
		return 0.93
	elseif options.size == "lg" then
		return 0.96
	elseif options.size == "sm" or options.size == "xs" then
		return 0.98
	end
	return 0.97
end

local function button(parent: Panel, options: DonatosUiButton): DButton
	local btn = vgui.Create("DButton", parent) as DButton
	btn:SetText("")
	btn:SetSize(buttonMetrics(options))
	local hover = theme.tween(0)
	local press = theme.tween(1)

	-- The icon, label and badge, centred; `under` the white selection of a tab.
	local function paintLabel(w: number, h: number, ink: Color, under: boolean)
		local font = buttonFont(options)
		local labelWidth = 0
		if options.label ~= nil then
			labelWidth = theme.textSize(options.label, font)
		end
		local badgeText = options.badge ~= nil and options.badge > 0 and tostring(options.badge) or nil
		local badgeSpace = badgeText ~= nil and px(6) + badgeWidth(badgeText) or 0
		local iconSize = options.icon ~= nil and (options.label ~= nil and px(16) or math.Round(h * 0.44)) or 0
		local iconGap = options.icon ~= nil and options.label ~= nil and px(8) or 0
		-- The logo, or its fallback text while there is no material.
		local logo = options.logo
		local logoMaterial: IMaterial | nil = nil
		local logoReadyAt = 0
		local logoHeight = math.Round(h * LOGO_SCALE)
		local logoWidth = 0
		if logo ~= nil then
			logoMaterial, logoReadyAt = images.image(logo.url, logo.id)
			logoWidth = logoMaterial ~= nil and math.Round(logoHeight * logo.aspect) or theme.textSize(logo.fallback, font)
		end
		local logoGap = logo ~= nil and options.label ~= nil and px(7) or 0
		local contentWidth = labelWidth + badgeSpace + iconSize + iconGap + logoGap + logoWidth
		local x = (w - contentWidth) / 2

		if options.icon ~= nil then
			theme.icon(options.icon, x, (h - iconSize) / 2, iconSize, ink)
			x = x + iconSize + iconGap
		end
		if options.label ~= nil then
			local _, textHeight = theme.textSize(options.label, font)
			surface.SetFont(font)
			surface.SetTextColor(ink)
			surface.SetTextPos(x, (h - textHeight) / 2)
			surface.DrawText(options.label)
			x = x + labelWidth
		end
		if logo ~= nil then
			x = x + logoGap
			if logoMaterial ~= nil then
				surface.SetMaterial(logoMaterial)
				surface.SetDrawColor(255, 255, 255, ink.a * images.fadeIn(logoReadyAt))
				surface.DrawTexturedRect(math.Round(x), math.Round((h - logoHeight) / 2), logoWidth, logoHeight)
			else
				draw.SimpleText(logo.fallback, font, x, h / 2, ink, TEXT_ALIGN_LEFT, TEXT_ALIGN_CENTER)
			end
			x = x + logoWidth
		end
		if badgeText ~= nil then
			local bw, bh = badgeWidth(badgeText), px(18)
			local bx, by = x + px(6), (h - bh) / 2
			local badgeFill, badgeInk = colors.barShade, colors.text
			if options.variant == "segment" then
				-- White on the gradient, dark under the white selection.
				badgeFill = under and colors.barPillText or colors.barPill
				badgeInk = under and colors.barText or colors.barPillText
			end
			theme.box(bh / 2, bx, by, bw, bh, badgeFill)
			draw.SimpleText(badgeText, theme.font("chip"), bx + bw / 2, by + bh / 2, badgeInk, TEXT_ALIGN_CENTER, TEXT_ALIGN_CENTER)
		end
	end

	local function paintContent(self: DButton, w: number, h: number)
		local alpha = options.disabled and 0.5 or 1
		local base, baseInk = buttonColors(options, false)
		local hot, hotInk = buttonColors(options, true)
		local t = hover.value()
		local fill = theme.mix(base, hot, t)
		if fill ~= nil then
			theme.box(h / 2, 0, 0, w, h, theme.fade(fill, alpha))
		end
		local ink = theme.fade(theme.mix(baseInk, hotInk, t) or baseInk, alpha)

		if options.pending then
			theme.spinner(w / 2, h / 2, h * 0.24, ink)
			return
		end

		if options.select then
			local font = theme.font("body")
			local padX = px(14)
			local chevron = px(16)
			local label = options.label or ""
			local _, textHeight = theme.textSize(label, font)
			surface.SetFont(font)
			surface.SetTextColor(options.placeholder and colors.muted or ink)
			surface.SetTextPos(padX, (h - textHeight) / 2)
			surface.DrawText(label)
			theme.icon("chevronDown", w - padX - chevron, (h - chevron) / 2, chevron, colors.muted)
			return
		end

		paintLabel(w, h, ink, false)
		local selection = options.selection
		if selection == nil then
			return
		end
		local from, to = selection()
		from, to = math.max(math.floor(from), 0), math.min(math.ceil(to), w)
		if from < to then
			-- Again in dark, cut to the selection: the selection's edge splits a glyph rather
			-- than the whole label taking a colour in between, which would fade it out on
			-- both the white selection and the gradient.
			local sx, sy = self:LocalToScreen(0, 0)
			render.SetScissorRect(sx + from, sy, sx + to, sy + h, true)
			paintLabel(w, h, theme.fade(colors.barPillText, alpha), true)
			render.SetScissorRect(0, 0, 0, 0, false)
		end
	end

	btn.Paint = function(self: DButton, w: number, h: number): boolean
		local inactive = options.disabled or options.pending
		-- Background 100ms ease-out (tabs: 150ms ease); the pressed scale 250ms ease.
		local tab = options.variant == "segment"
		local hovered = self:IsHovered() and not inactive and not (tab and options.active)
		hover.to(hovered and 1 or 0, tab and 0.15 or 0.1, tab and "smooth" or "out")
		press.to((self:IsDown() and not inactive) and pressScale(options) or 1, 0.25, "smooth")
		local scaled = theme.pushScale(self, press.value(), w / 2, h / 2)
		paintContent(self, w, h)
		theme.popScale(scaled)
		return true
	end

	btn.DoClick = function(self: DButton)
		if options.disabled or options.pending then
			return
		end
		local onClick = options.onClick
		if onClick ~= nil then
			onClick(self)
		end
	end

	return btn
end

-- Buttons side by side, right-aligned in the block (or left with `align`).
local function row(parent: Panel, gap: number, buttons: DButton[], align?: "left" | "right"): DonatosUiBlock
	local panel = blankPanel(parent)
	local height = 0
	for _, child in ipairs(buttons) do
		child:SetParent(panel)
		height = math.max(height, child:GetTall())
	end
	return {
		panel = panel,
		layout = function(width: number): number
			local total = 0
			for i, child in ipairs(buttons) do
				total = total + child:GetWide() + (i > 1 and gap or 0)
			end
			local x = align == "left" and 0 or width - total
			for _, child in ipairs(buttons) do
				child:SetPos(x, (height - child:GetTall()) / 2)
				x = x + child:GetWide() + gap
			end
			return height
		end,
	}
end

-- Buttons stacked full width, `gap` apart.
local function column(parent: Panel, gap: number, buttons: DButton[]): DonatosUiBlock
	local panel = blankPanel(parent)
	for _, child in ipairs(buttons) do
		child:SetParent(panel)
	end
	return {
		panel = panel,
		layout = function(width: number): number
			local y = 0
			for i, child in ipairs(buttons) do
				child:SetPos(0, y)
				child:SetWide(width)
				y = y + child:GetTall() + (i < #buttons and gap or 0)
			end
			return y
		end,
	}
end

------------------------------------------------------------------------------ switch

interface DonatosUiSwitch {
	on: boolean;
	label: string;
	hint?: string;
	onChange?: (on: boolean) => void;
}

-- A HeroUI switch with a label and a hint beside it; the whole row toggles it.
local function switch(parent: Panel, options: DonatosUiSwitch): DonatosUiBlock
	local panel = vgui.Create("DButton", parent) as DButton
	panel:SetText("")
	local hintLines: string[] = {}
	-- HeroUI's switch: the thumb moves 300ms ease-out-fluid, the track recolours 250ms ease.
	local position = theme.tween(options.on and 1 or 0)
	local track = theme.tween(options.on and 1 or 0)

	panel.Paint = function(self: DButton, w: number, h: number): boolean
		position.to(options.on and 1 or 0, 0.3, "outFluid")
		track.to(options.on and 1 or 0, 0.25, "smooth")
		local tw, th = px(40), px(24)
		theme.box(th / 2, 0, 0, tw, th, theme.mix(colors.default, colors.accent, track.value()) or colors.default)
		local thumb = px(18)
		local inset = px(3)
		-- White, or the accent's ink on a white accent.
		local knob = theme.mix(colors.barPill, colors.accentInk, track.value()) or colors.barPill
		theme.box(thumb / 2, inset + (tw - thumb - inset * 2) * position.value(), inset, thumb, thumb, knob)

		local x = tw + px(12)
		local labelFont = theme.font("medium")
		local hintFont = theme.font("chip")
		draw.SimpleText(options.label, labelFont, x, (th - theme.fontHeight(labelFont)) / 2, colors.text)
		local y = th + px(2)
		for _, line in ipairs(hintLines) do
			draw.SimpleText(line, theme.font("small"), x, y, colors.muted)
			y = y + px(16)
		end
		return true
	end
	panel.DoClick = function(self: DButton)
		options.on = not options.on
		local onChange = options.onChange
		if onChange ~= nil then
			onChange(options.on)
		end
	end

	return {
		panel = panel,
		layout = function(width: number): number
			local hint = options.hint
			hintLines = hint ~= nil and theme.wrap(hint, theme.font("small"), width - px(52)) or {}
			return px(24) + (#hintLines > 0 and px(2) + #hintLines * px(16) or 0)
		end,
	}
end

------------------------------------------------------------------------------ checkbox

interface DonatosUiCheckbox {
	on: boolean;
	label: string;
	-- Words of the label that link to web pages (`text` as it appears in it), opened through
	-- gui.OpenURL (which asks first).
	links?: { text: string; url: string }[];
	onChange?: (on: boolean) => void;
}

-- A HeroUI checkbox with a label wrapped beside it; the whole row toggles it, except its links.
local function checkbox(parent: Panel, options: DonatosUiCheckbox): DonatosUiBlock
	local panel = vgui.Create("DButton", parent) as DButton
	panel:SetText("")
	-- The label's words where `layout` placed them, each with the page its link opens.
	local words: { text: string; x: number; y: number; w: number; url: string | nil }[] = {}
	-- The box fills with the accent over HeroUI's 250ms ease.
	local fill = theme.tween(options.on and 1 or 0)

	local function linkAt(mx: number, my: number): string | nil
		for _, word in ipairs(words) do
			if word.url ~= nil and mx >= word.x and mx < word.x + word.w and my >= word.y and my < word.y + px(22) then
				return word.url
			end
		end
		return nil
	end

	panel.Paint = function(self: DButton, w: number, h: number): boolean
		fill.to(options.on and 1 or 0, 0.25, "smooth")
		local size = px(20)
		local top = (px(22) - size) / 2
		theme.box(px(6), 0, top, size, size, theme.mix(colors.default, colors.accent, fill.value()) or colors.default)
		if fill.value() > 0 then
			local icon = px(14)
			theme.icon("check", (size - icon) / 2, top + (size - icon) / 2, icon, theme.fade(colors.accentInk, fill.value()))
		end

		local font = theme.font("body")
		local inset = (px(22) - theme.fontHeight(font)) / 2
		local hovered = self:IsHovered() and linkAt(self:CursorPos()) or nil
		for _, word in ipairs(words) do
			local url = word.url
			draw.SimpleText(word.text, font, word.x, word.y + inset, url ~= nil and colors.accentText or colors.text)
			if url ~= nil then
				surface.SetDrawColor(hovered == url and colors.accentText or theme.fade(colors.accentText, 0.5))
				surface.DrawRect(word.x, word.y + inset + math.Round(theme.fontHeight(font) * 0.9), word.w, math.max(px(1), 1))
			end
		end
		return true
	end
	panel.DoClick = function(self: DButton)
		local url = linkAt(self:CursorPos())
		if url ~= nil then
			gui.OpenURL(url)
			return
		end
		options.on = not options.on
		local onChange = options.onChange
		if onChange ~= nil then
			onChange(options.on)
		end
	end

	return {
		panel = panel,
		layout = function(width: number): number
			local font = theme.font("body")
			local space = theme.textSize(" ", font)
			local left = px(30)
			-- Which link each byte of the label belongs to.
			local linkFrom: { from: number; to: number; url: string }[] = {}
			for _, link in ipairs(options.links or {}) do
				local from, to = string.find(options.label, link.text, 1, true)
				if from ~= nil and to ~= nil then
					table.insert(linkFrom, { from = from, to = to, url = link.url })
				end
			end
			words = {}
			local x, y = left, 0
			local lineCount = 1
			for position, match in string.gmatch(options.label, "()(%S+)") do
				-- `()` captures the word's position, a number.
				local start = tonumber(position) or 0
				local text = match as string
				local url: string | nil = nil
				for _, link in ipairs(linkFrom) do
					if start >= link.from and start <= link.to then
						url = link.url
					end
				end
				local tw = theme.textSize(text, font)
				if x > left and x + space + tw > width then
					x, y = left, y + px(22)
					lineCount = lineCount + 1
				end
				local previous = words[#words]
				if x > left then
					-- A link's underline runs on under the space between its words.
					if previous ~= nil and url ~= nil and previous.url == url and previous.y == y then
						previous.w = previous.w + space
					end
					x = x + space
				end
				table.insert(words, { text = text, x = x, y = y, w = tw, url = url })
				x = x + tw
			end
			return lineCount * px(22)
		end,
	}
end

------------------------------------------------------------------------------ menus

interface DonatosUiMenuItem {
	label: string;
	disabled?: boolean;
	steamID64?: string;
	onClick: () => void;
}

local openDropdown: DMenu | nil = nil

-- Closes the open dropdown, if there is one; returns whether it did.
local function closeDropdown(): boolean
	local menu = openDropdown
	openDropdown = nil
	if menu ~= nil and IsValid(menu) and menu:IsVisible() then
		CloseDermaMenus()
		return true
	end
	return false
end

-- A popover's frame: a DMenu, so it closes on a click outside it like any menu (and on Escape,
-- through closeDropdown), drawn as HeroUI's popover.
local function popoverShell(): DMenu
	local menu = DermaMenu(false, nil)
	-- HeroUI's popover entrance: 150ms ease, fading in and growing from 0.9 at its top edge.
	local enter = theme.tween(0)
	enter.to(1, 0.15, "smooth")
	local scaled = false
	menu.Paint = function(self: Panel, w: number, h: number): boolean
		local t = enter.value()
		theme.captureBehind("menu", t)
		scaled = theme.pushScale(self, Lerp(t, 0.9, 1), w / 2, 0)
		theme.box(px(16), 0, 0, w, h, colors.surface)
		theme.ring(px(16), 0, 0, w, h, colors.separator)
		return true
	end
	menu.PaintOver = function(self: Panel, w: number, h: number): boolean
		theme.popScale(scaled)
		scaled = false
		theme.coverBehind("menu", self, enter.value())
		return true
	end
	return menu
end

-- Opens `menu` (`width` wide) under `anchor`, aligned to its right edge (or left).
local function openUnder(menu: DMenu, anchor: Panel, width: number, alignLeft?: boolean)
	local ax, ay = anchor:LocalToScreen(0, 0)
	local x = alignLeft and ax or ax + anchor:GetWide() - width
	menu:Open(x, ay + anchor:GetTall() + px(6), false, anchor)
	openDropdown = menu
end

-- A dropdown under `anchor`, aligned to its right edge (or left with `alignLeft`).
local function dropdown(anchor: Panel, items: DonatosUiMenuItem[], minWidth?: number, alignLeft?: boolean): DMenu
	local menu = popoverShell()
	local font = theme.font("body")
	local itemHeight = px(32)
	local avatarSize = px(20)
	local width = math.max(minWidth or 0, px(160))
	for _, item in ipairs(items) do
		local textWidth = theme.textSize(item.label, font)
		width = math.max(width, textWidth + px(32) + (item.steamID64 ~= nil and avatarSize + px(8) or 0))
	end
	menu:SetMinimumWidth(width)
	menu:SetMaxHeight(px(280))

	-- DMenu stacks its items edge to edge; spacers pad it above and below, so a hovered item's
	-- highlight stays inside the rounded border.
	local function spacer()
		local panel = blankPanel(menu)
		panel:SetTall(px(6))
		panel:SetMouseInputEnabled(false)
		menu:AddPanel(panel)
	end

	spacer()
	for _, item in ipairs(items) do
		local option = menu:AddOption("", function()
			if not item.disabled then
				item.onClick()
			end
		end)
		option:SetText("")
		option.PerformLayout = function(self: Panel, w: number, h: number)
			self:SetTall(itemHeight)
		end
		local textX = px(16)
		if item.steamID64 ~= nil then
			local avatar = vgui.Create("AvatarImage", option)
			avatar:SetSize(avatarSize, avatarSize)
			avatar:SetPos(px(16), (itemHeight - avatarSize) / 2)
			avatar:SetSteamID(item.steamID64, 32)
			avatar:SetMouseInputEnabled(false)
			textX = px(16) + avatarSize + px(8)
		end
		-- Menu items: background 150ms ease, pressed scale 0.98.
		local hover = theme.tween(0)
		local press = theme.tween(1)
		option.Paint = function(self: Panel, w: number, h: number): boolean
			hover.to((self:IsHovered() and not item.disabled) and 1 or 0, 0.15, "smooth")
			press.to(((self as DButton):IsDown() and not item.disabled) and 0.98 or 1, 0.25, "smooth")
			local fill = theme.mix(nil, colors.default, hover.value())
			if fill ~= nil then
				theme.box(px(10), px(6), 0, w - px(12), h, fill)
			end
			local color = item.disabled and colors.muted or colors.text
			local itemScaled = theme.pushScale(self, press.value(), w / 2, h / 2)
			draw.SimpleText(item.label, font, textX, h / 2, color, TEXT_ALIGN_LEFT, TEXT_ALIGN_CENTER)
			theme.popScale(itemScaled)
			return true
		end
	end

	spacer()

	openUnder(menu, anchor, width, alignLeft)
	return menu
end

-- A popover under `anchor`, `width` wide, aligned to its right edge: `build` fills `parent`
-- and returns its height. Clicks inside it leave it open.
local function popover(anchor: Panel, width: number, build: (parent: Panel, width: number) => number): DMenu
	local menu = popoverShell()
	local body = blankPanel(menu)
	body:SetSize(width, build(body, width))
	menu:SetMinimumWidth(width)
	menu:AddPanel(body)
	openUnder(menu, anchor, width)
	return menu
end

------------------------------------------------------------------------------ progress

-- An 8-high bar filled with the vivid gradient; `fraction` is read every frame. `behind` is
-- the colour the bar sits on (its rounded ends are cut out of it).
local function progress(parent: Panel, fraction: () => number, behind: Color): DonatosUiBlock
	return painted(parent, px(8), function(w: number, h: number)
		local r = h / 2
		theme.box(r, 0, 0, w, h, colors.default)
		local fill = math.Round(math.Clamp(fraction(), 0, 1) * w)
		if fill <= 0 then
			return
		end
		fill = math.max(fill, h)
		local strip = math.max(px(2), 2)
		for x = 0, fill - 1, strip do
			surface.SetDrawColor(theme.gradientAt(x, w, true))
			surface.DrawRect(x, 0, math.min(strip, fill - x), h)
		end
		theme.roundCutout(r, 0, 0, fill, h, behind, true, false, true, false)
		theme.roundCutout(r, 0, 0, fill, h, fill < w and colors.default or behind, false, true, false, true)
	end)
end

------------------------------------------------------------------------------ inputs and media

-- A text field: the returned panel is the styled box to place, holding the entry inset from
-- its edges (a TextEntry draws its text flush with its own left edge).
local function textEntry(parent: Panel, placeholder: string, numeric: boolean): (Panel, DTextEntry)
	local field = vgui.Create("DPanel", parent)
	field:SetCursor("beam")
	field:SetTall(px(36))
	local entry = vgui.Create("DTextEntry", field) as DTextEntry
	entry:SetFont(theme.font("input"))
	entry:SetNumeric(numeric)
	entry:SetPaintBackground(false)
	entry.Paint = function(self: DTextEntry, w: number, h: number): boolean
		if self:GetValue() == "" and not self:HasFocus() then
			draw.SimpleText(placeholder, theme.font("input"), 2, h / 2, colors.muted, TEXT_ALIGN_LEFT, TEXT_ALIGN_CENTER)
		end
		self:DrawTextEntryText(colors.text, colors.selection, colors.text)
		return true
	end
	field.Paint = function(self: Panel, w: number, h: number): boolean
		theme.box(px(12), 0, 0, w, h, entry:HasFocus() and colors.defaultHover or colors.default)
		return true
	end
	field.PerformLayout = function(self: Panel, w: number, h: number)
		entry:SetPos(px(12), 0)
		entry:SetSize(w - px(24), h)
	end
	field.OnMousePressed = function(self: Panel, keyCode: number): boolean
		entry:RequestFocus()
		return true
	end
	return field, entry
end

-- A pill search field with a magnifier and, once there is text, a clear button.
-- `onChange` runs on every edit with the new text.
local function searchField(parent: Panel, placeholder: string, onChange: (value: string) => void): (Panel, DTextEntry)
	local field = vgui.Create("DPanel", parent)
	field:SetCursor("beam")
	field:SetTall(px(36))
	local entry = vgui.Create("DTextEntry", field) as DTextEntry
	entry:SetFont(theme.font("input"))
	entry:SetPaintBackground(false)
	entry.Paint = function(self: DTextEntry, w: number, h: number): boolean
		if self:GetValue() == "" then
			draw.SimpleText(placeholder, theme.font("input"), 2, h / 2, colors.muted, TEXT_ALIGN_LEFT, TEXT_ALIGN_CENTER)
		end
		self:DrawTextEntryText(colors.text, colors.selection, colors.text)
		return true
	end

	local clear = button(field, { icon = "close", size = "xs", variant = "secondary" })
	clear:SetSize(px(24), px(24))
	clear:SetVisible(false)
	clear.DoClick = function(self: DButton)
		entry:SetValue("")
		entry:OnChange()
		entry:RequestFocus()
	end

	entry.OnChange = function(self: DTextEntry)
		local value = self:GetValue()
		clear:SetVisible(value ~= "")
		onChange(value)
	end

	local focus = theme.tween(0)
	field.Paint = function(self: Panel, w: number, h: number): boolean
		focus.to(entry:HasFocus() and 1 or 0, 0.15, "out")
		theme.box(h / 2, 0, 0, w, h, colors.surface)
		local ring = theme.mix(nil, colors.surfaceRing, focus.value())
		if ring ~= nil then
			theme.ring(h / 2, 0, 0, w, h, ring)
		end
		local icon = px(16)
		theme.icon("search", px(12), (h - icon) / 2, icon, colors.muted)
		return true
	end
	field.PerformLayout = function(self: Panel, w: number, h: number)
		local left = px(12) + px(16) + px(8)
		clear:SetPos(w - px(6) - clear:GetWide(), (h - clear:GetTall()) / 2)
		entry:SetPos(left, 0)
		entry:SetSize(w - left - px(6) - clear:GetWide() - px(4), h)
	end
	field.OnMousePressed = function(self: Panel, keyCode: number): boolean
		entry:RequestFocus()
		return true
	end
	return field, entry
end

-- A circular Steam avatar. `behind` returns the colours under it, bottom layer first; they
-- are painted back over the image's corners.
local function avatar(parent: Panel, size: number, target: Player, behind: () => Color[]): Panel
	local holder = vgui.Create("DPanel", parent)
	holder:SetSize(size, size)
	local image = vgui.Create("AvatarImage", holder)
	image:SetSize(size, size)
	image:SetPlayer(target, 64)
	image:SetPaintedManually(true)
	image:SetMouseInputEnabled(false)
	holder.Paint = function(self: Panel, w: number, h: number): boolean
		image:PaintManual()
		for _, color in ipairs(behind()) do
			theme.circleCutout(0, 0, w, color)
		end
		return true
	end
	return holder
end

------------------------------------------------------------------------------ dialogs

interface DonatosUiDialog {
	title: string;
	description?: string;
	-- `relayout` re-measures the dialog after the body's content changes size.
	body?: (parent: Panel, relayout: () => void) => DonatosUiBlock;
	actions: DonatosUiButton[];
}

-- A dialog that sizes and places itself in the area the host gives it.
interface DonatosUiFloating {
	panel: Panel;
	place: (areaWidth: number, areaHeight: number) => void;
}

-- What a dialog grows out of (a shop card): it morphs from there into the dialog, and back
-- into it on closing.
interface DonatosUiOrigin {
	-- Where it is on the screen; nil once it is gone (the page was rebuilt).
	rect: () => [number, number, number, number] | nil;
	-- Paints it at its own size at (0, 0); shown fading out as the morph sets off.
	paint: (w: number, h: number) => void;
	-- While the dialog is out (true) the origin isn't drawn: it has turned into the dialog.
	hide: (hidden: boolean) => void;
}

interface DonatosUiDialogHost {
	-- Shows `dialog` in place of the one showing; `stacked` puts it over that one instead, and
	-- closing it brings the one under it back as it was.
	show: (dialog: DonatosUiDialog, stacked?: boolean) => void;
	-- Shows a dialog built by `build` (the parent is the dimmed overlay); from `origin`, it
	-- grows out of that.
	showCustom: (build: (parent: Panel, relayout: () => void) => DonatosUiFloating, stacked?: boolean, origin?: DonatosUiOrigin) => void;
	-- Closes the top dialog.
	close: () => void;
	-- Whether a dialog is showing (and not already on its way out).
	isOpen: () => boolean;
	-- Puts the host over the whole of `frame` (call from the frame's PerformLayout).
	cover: (w: number, h: number) => void;
}

-- One dialog on the host's stack; only the top one is visible.
local type DialogLayer = {
	panel: Panel;
	place: (areaWidth: number, areaHeight: number) => void;
	-- 0 hidden, 1 shown: the entrance and exit fade and scale.
	presence: DonatosTween;
	exiting: boolean;
	origin?: DonatosUiOrigin;
	-- 0 at the origin, 1 in place; the way there and back, after which the dialog's own
	-- presence goes on as usual.
	morph: DonatosTween;
	-- The origin's screen rect the morph goes from or back to.
	from?: [number, number, number, number];
}

-- The morph from an origin: 350ms there and 300ms back, ease-out-quart like the gallery's
-- zoom. The dialog is stretched from the origin's place to its own, with the origin's
-- picture over it fading out on the first part of the way.
local MORPH_IN, MORPH_OUT = 0.35, 0.3

-- 0 up to `from`, 1 from `to`, smooth in between.
local function ramp(t: number, from: number, to: number): number
	local x = math.Clamp((t - from) / (to - from), 0, 1)
	return x * x * (3 - 2 * x)
end

local function dialogHost(frame: Panel, radius: number): DonatosUiDialogHost
	local overlay = blankPanel(frame)
	overlay:SetVisible(false)
	overlay:SetZPos(1000)

	-- HeroUI's modal: the backdrop fades in over 150ms (out over 100ms); the dialog fades in
	-- while settling from 1.05 to 1 over 250ms ease-out-quad, and leaves fading to 0.95 over
	-- 100ms.
	local backdrop = theme.tween(0)

	-- Bottom first. A dialog shown stacked hides the one under it; a dialog on its way out
	-- stays here until its exit is over.
	local layers: DialogLayer[] = {}

	-- A dialog on its way between its origin and its place: a picture of it stretched over
	-- the rect in between (its child panels can't be drawn scaled, as each is clipped to its
	-- own place), the origin's picture over that at first.
	local function paintMorph(layer: DialogLayer, from: [number, number, number, number], origin: DonatosUiOrigin, m: number)
		local sx, sy = overlay:LocalToScreen(0, 0)
		local fx, fy, fw, fh = from[1] - sx, from[2] - sy, from[3], from[4]
		local tx, ty, tw, th = layer.panel:GetBounds()
		local x, y, w, h = Lerp(m, fx, tx), Lerp(m, fy, ty), Lerp(m, fw, tw), Lerp(m, fh, th)
		theme.paintSnapshot(layer.panel, x, y, w, h)
		local shown = 1 - ramp(m, 0, 0.45)
		if shown > 0 then
			theme.captureBehind("morph", shown)
			local pushed = theme.pushMap(overlay, x, y, w / math.max(fw, 1), h / math.max(fh, 1))
			origin.paint(fw, fh)
			theme.popScale(pushed)
			theme.coverBehind("morph", overlay, shown)
		end
	end

	overlay.Paint = function(self: Panel, w: number, h: number): boolean
		local fill = theme.mix(nil, colors.overlay, backdrop.value())
		if fill ~= nil then
			theme.box(radius, 0, 0, w, h, fill)
		end
		for _, layer in ipairs(layers) do
			local m = layer.morph.value()
			local from, origin = layer.from, layer.origin
			local morphing = m < 1 and from ~= nil and origin ~= nil
			-- Drawn by the morph until it is in place.
			layer.panel:SetPaintedManually(morphing)
			if morphing and from ~= nil and origin ~= nil and layer.panel:IsVisible() then
				paintMorph(layer, from, origin, m)
			end
		end
		return true
	end

	-- The top dialog that is not leaving.
	local function top(): DialogLayer | nil
		for i = #layers, 1, -1 do
			local layer = assert(layers[i])
			if not layer.exiting then
				return layer
			end
		end
		return nil
	end

	local function remove(layer: DialogLayer)
		if IsValid(layer.panel) then
			layer.panel:Remove()
		end
		local origin = layer.origin
		if origin ~= nil and layer.from ~= nil then
			origin.hide(false)
		end
		for i, other in ipairs(layers) do
			if other == layer then
				table.remove(layers, i)
				break
			end
		end
		if #layers == 0 then
			overlay:SetVisible(false)
		end
	end

	-- Brings back a dialog that a stacked one hid; it enters again.
	local function reveal(layer: DialogLayer)
		layer.panel:SetVisible(true)
		layer.place(overlay:GetSize())
		layer.presence.set(0)
		layer.presence.to(1, 0.25, "outQuad")
	end

	local function close()
		local layer = top()
		if layer == nil then
			return
		end
		layer.exiting = true
		-- Back into its origin if that is still there.
		local origin = layer.origin
		local from = origin and origin.rect()
		if from ~= nil then
			layer.from = from
			layer.morph.to(0, MORPH_OUT, "outQuart")
		else
			layer.presence.to(0, 0.1, "outQuad")
		end
		local under = top()
		if under ~= nil then
			reveal(under)
		elseif from ~= nil then
			backdrop.to(0, MORPH_OUT, "smooth")
		else
			backdrop.to(0, 0.1, "out")
		end
	end

	overlay.Think = function(self: Panel)
		for i = #layers, 1, -1 do
			local layer = assert(layers[i])
			if layer.exiting and layer.presence.done() and layer.morph.done() and (top() ~= nil or backdrop.done()) then
				remove(layer)
			end
		end
	end

	overlay.OnMousePressed = function(self: Panel, keyCode: number): boolean
		close()
		return true
	end

	-- Dialogs that are gone are off the stack, so a late callback's relayout places nothing.
	overlay.PerformLayout = function(self: Panel, w: number, h: number)
		for _, layer in ipairs(layers) do
			layer.place(w, h)
		end
	end

	local function relayout()
		overlay:InvalidateLayout()
	end

	local function showCustom(build: (parent: Panel, relayout: () => void) => DonatosUiFloating, stacked?: boolean, origin?: DonatosUiOrigin)
		local showing = overlay:IsVisible()
		if stacked then
			local covered = top()
			if covered ~= nil then
				covered.panel:SetVisible(false)
			end
		else
			-- A dialog shown unstacked replaces the whole stack, the dialogs hidden under the
			-- top one too, so closing it reveals none of them. Leaving ones finish leaving.
			for i = #layers, 1, -1 do
				local layer = assert(layers[i])
				if not layer.exiting then
					remove(layer)
				end
			end
		end
		-- Over a showing (or leaving) dialog the backdrop carries on from where it is.
		if not showing then
			backdrop.set(0)
		end

		local floating = build(overlay, relayout)
		local panel = floating.panel
		local from = origin and origin.rect()
		local layer: DialogLayer = {
			panel = panel,
			place = floating.place,
			presence = theme.tween(0),
			exiting = false,
			origin = origin,
			morph = theme.tween(from ~= nil and 0 or 1),
			from = from,
		}
		table.insert(layers, layer)

		local scaled = false
		local opacity = 0
		local paint = panel.Paint
		panel.Paint = function(self: Panel, w: number, h: number): boolean
			local t = layer.presence.value()
			opacity = t
			theme.captureBehind("dialog", opacity)
			local scale = layer.exiting and Lerp(t, 0.95, 1) or Lerp(t, 1.05, 1)
			scaled = theme.pushScale(self, scale, w / 2, h / 2)
			return paint(self, w, h)
		end
		panel.PaintOver = function(self: Panel, w: number, h: number): boolean
			theme.popScale(scaled)
			scaled = false
			theme.coverBehind("dialog", self, opacity)
			return true
		end

		floating.place(overlay:GetSize())
		backdrop.to(1, 0.15, "out")
		if origin ~= nil and from ~= nil then
			origin.hide(true)
			panel:SetPaintedManually(true)
			-- The morph brings it in; it is there at full size from the start.
			layer.presence.set(1)
			layer.morph.to(1, MORPH_IN, "outQuart")
		else
			layer.presence.to(1, 0.25, "outQuad")
		end
		overlay:SetVisible(true)
		overlay:MoveToFront()
	end

	local function show(dialog: DonatosUiDialog, stacked?: boolean)
		showCustom(function(parent: Panel, relayoutDialog: () => void): DonatosUiFloating
			local box = vgui.Create("DPanel", parent)
			box.Paint = function(self: Panel, w: number, h: number): boolean
				theme.box(px(24), 0, 0, w, h, colors.surface)
				theme.ring(px(24), 0, 0, w, h, colors.frameRing)
				return true
			end

			local content, add = stack(box, px(16), px(20))
			local header, addHeader = stack(content.panel, px(6))
			addHeader(text(header.panel, { text = dialog.title, font = theme.font("section"), color = colors.text, lineHeight = 26 }))
			if dialog.description ~= nil then
				addHeader(text(header.panel, { text = dialog.description, font = theme.font("body"), color = colors.muted, lineHeight = 20 }))
			end
			add(header)
			local makeBody = dialog.body
			if makeBody ~= nil then
				add(makeBody(content.panel, relayoutDialog))
			end
			local buttons: DButton[] = {}
			for _, action in ipairs(dialog.actions) do
				table.insert(buttons, button(content.panel, action))
			end
			add(row(content.panel, px(8), buttons))

			box.PerformLayout = function(self: Panel, w: number, h: number)
				content.panel:SetSize(w, content.layout(w))
			end

			return {
				panel = box,
				place = function(areaWidth: number, areaHeight: number)
					local w = math.min(px(420), areaWidth - px(32))
					local h = content.layout(w)
					box:SetSize(w, h)
					box:SetPos((areaWidth - w) / 2, math.max((areaHeight - h) / 2, px(16)))
				end,
			}
		end, stacked)
	end

	return {
		show = show,
		showCustom = showCustom,
		close = close,
		isOpen = function(): boolean
			return top() ~= nil
		end,
		cover = function(w: number, h: number)
			overlay:SetPos(0, 0)
			overlay:SetSize(w, h)
		end,
	}
end

return {
	blankPanel = blankPanel,
	text = text,
	painted = painted,
	chip = chip,
	chipWidth = chipWidth,
	stack = stack,
	grid = grid,
	flow = flow,
	scroll = scroll,
	button = button,
	buttonMetrics = buttonMetrics,
	row = row,
	column = column,
	switch = switch,
	checkbox = checkbox,
	dropdown = dropdown,
	popover = popover,
	closeDropdown = closeDropdown,
	progress = progress,
	textEntry = textEntry,
	searchField = searchField,
	avatar = avatar,
	dialogHost = dialogHost,
}
