-- Client: visual tokens for the donatos menu (a dark shadcn-style theme), scaled to the screen,
-- and the drawing and text helpers every widget shares.

local theme = {}

-- GMod's 2D pipeline crushes dark tones: drawing grey 16 shows 8, 24 shows 17, and from 96 up
-- it is the identity (measured with a grey ramp in the client). Theme colours are written as
-- they should appear, and lifted through the inverse of that response.
local RESPONSE: { drawn: number; shown: number }[] = {
	{ drawn = 0, shown = 0 },
	{ drawn = 8, shown = 2 },
	{ drawn = 16, shown = 8 },
	{ drawn = 24, shown = 17 },
	{ drawn = 32, shown = 26 },
	{ drawn = 40, shown = 35 },
	{ drawn = 48, shown = 44 },
	{ drawn = 56, shown = 53 },
	{ drawn = 64, shown = 62 },
	{ drawn = 72, shown = 70 },
	{ drawn = 80, shown = 79 },
	{ drawn = 96, shown = 96 },
}

local function lift(shown: number): number
	for i = 2, #RESPONSE do
		local low = assert(RESPONSE[i - 1])
		local high = assert(RESPONSE[i])
		if shown <= high.shown then
			local f = (shown - low.shown) / (high.shown - low.shown)
			return math.Round(Lerp(f, low.drawn, high.drawn))
		end
	end
	return shown
end

-- An opaque colour that appears on screen as (r, g, b).
local function shown(r: number, g: number, b: number): Color
	return Color(lift(r), lift(g), lift(b), 255)
end

-- The forward response: what a drawn grey shows as.
local function crush(drawn: number): number
	for i = 2, #RESPONSE do
		local low = assert(RESPONSE[i - 1])
		local high = assert(RESPONSE[i])
		if drawn <= high.drawn then
			return Lerp((drawn - low.drawn) / (high.drawn - low.drawn), low.shown, high.shown)
		end
	end
	return drawn
end

local function toLinear(value: number): number
	local c = value / 255
	return c <= 0.04045 and c / 12.92 or ((c + 0.055) / 1.055) ^ 2.4
end

-- GMod blends translucent draws in linear light, where the web blends sRGB values, so the same
-- alpha comes out far stronger (white at 24 over black shows 86, not 24). This finds the alpha
-- that shows like the web's `alpha`. Near-black scales whatever is below, which has a closed form
-- (1 - (1 - a)^2.2); anything else is matched over the menu background, and is close over
-- lighter surfaces.
local BLEND_BASE: number[] = { 14, 14, 16 }
local webAlphas: Table<Color, number> = setmetatable({}, { __mode = "k" })

local function blendAlpha(color: Color, alpha: number): number
	local a = math.Clamp(alpha / 255, 0, 1)
	if math.max(color.r, color.g, color.b) <= 16 then
		return math.Round((1 - (1 - a) ^ 2.2) * 255)
	end
	local best, spread = a, 0
	for i, channel in ipairs({ color.r, color.g, color.b }) do
		local baseShown = assert(BLEND_BASE[i])
		local base = toLinear(lift(baseShown))
		local top = toLinear(channel)
		if math.abs(top - base) > spread then
			spread = math.abs(top - base)
			local target = toLinear(lift(a * crush(channel) + (1 - a) * baseShown))
			best = (target - base) / (top - base)
		end
	end
	return math.Round(math.Clamp(best, 0, 1) * 255)
end

-- `color` drawn at what the web would show as `alpha`.
local function translucent(r: number, g: number, b: number, alpha: number): Color
	local color = Color(r, g, b, 255)
	color.a = blendAlpha(color, alpha)
	webAlphas[color] = alpha
	return color
end

-- `color` with its web alpha scaled by `factor` (for disabled and fading states).
function theme.fade(color: Color, factor: number): Color
	local faded = Color(color.r, color.g, color.b, 255)
	local alpha = (webAlphas[color] or color.a) * factor
	faded.a = blendAlpha(faded, alpha)
	webAlphas[faded] = alpha
	return faded
end

theme.colors = {
	background = shown(14, 14, 16),
	card = shown(24, 24, 27),
	popover = shown(24, 24, 27),
	secondary = shown(39, 39, 42),
	secondaryHover = shown(52, 52, 57),
	text = Color(250, 250, 250),
	textDim = translucent(250, 250, 250, 180),
	muted = Color(161, 161, 170),
	primary = Color(212, 212, 212),
	primaryHover = Color(190, 190, 194),
	primaryText = shown(24, 24, 27),
	border = translucent(255, 255, 255, 24),
	outlineFill = translucent(255, 255, 255, 24),
	outlineHover = translucent(255, 255, 255, 38),
	input = translucent(255, 255, 255, 40),
	destructive = Color(248, 113, 113),
	overlay = translucent(0, 0, 0, 150),
	filterBar = shown(24, 24, 26),
	headerShade = translucent(12, 12, 14, 115),
	badge = translucent(255, 255, 255, 51),
	track = shown(39, 39, 42),
	scrollGrip = translucent(255, 255, 255, 40),
	selection = translucent(96, 165, 250, 120),
}

local colors = theme.colors

-- Header gradient stops: the design's colours at 0.6 alpha, composited over the background.
local function overBackground(r: number, g: number, b: number): Color
	return shown(Lerp(0.6, 14, r), Lerp(0.6, 14, g), Lerp(0.6, 16, b))
end

local GRADIENT: Color[] = {
	overBackground(238, 119, 82),
	overBackground(231, 60, 126),
	overBackground(35, 166, 213),
	overBackground(35, 213, 171),
}

local scale = 1

-- Scales a length in the web UI's CSS pixels to the screen. Like the old DHTML menu's zoom, 1 at
-- 1920x1080, growing with larger screens and never shrinking below 1, so text stays readable.
function theme.px(value: number): number
	return math.Round(value * scale)
end

-- A GMod font's size is its full cell height, about 1.17 times the CSS font-size for Roboto:
-- 14 here matches the web UI's 12px text (text-xs), 16 its 14px (text-sm), 12 its 10px.
-- Line heights (`leading` in widgets.text) are relative to that cell height too.
local FONTS: { name: string; face: string; size: number; weight: number }[] = {
	{ name = "title", face = "Roboto", size = 17, weight = 400 },
	{ name = "body", face = "Roboto", size = 14, weight = 400 },
	{ name = "bodyRegular", face = "Roboto", size = 14, weight = 400 },
	{ name = "small", face = "Roboto", size = 14, weight = 400 },
	{ name = "smallBold", face = "Roboto Medium", size = 12, weight = 500 },
	{ name = "price", face = "Roboto", size = 17, weight = 400 },
	{ name = "heading", face = "Roboto", size = 17, weight = 400 },
	{ name = "dialogTitle", face = "Roboto Medium", size = 17, weight = 500 },
	{ name = "input", face = "Roboto", size = 16, weight = 400 },
}

-- Recomputes the scale and recreates the fonts for the current resolution.
function theme.refresh()
	scale = math.max(1, math.min(ScrW() / 1920, ScrH() / 1080))
	for _, font in ipairs(FONTS) do
		surface.CreateFont(`donatos.${font.name}`, {
			font = font.face,
			size = theme.px(font.size),
			weight = font.weight,
			extended = true,
			antialias = true,
		})
	end
end

local type DonatosFont =
	| "title"
	| "body"
	| "bodyRegular"
	| "small"
	| "smallBold"
	| "price"
	| "heading"
	| "dialogTitle"
	| "input"

function theme.font(name: DonatosFont): string
	return `donatos.${name}`
end

function theme.textSize(text: string, font: string): (number, number)
	surface.SetFont(font)
	return surface.GetTextSize(text)
end

function theme.fontHeight(font: string): number
	local _, h = theme.textSize("Ay", font)
	return h
end

-- Word-wraps `text` to `width`, keeping its line breaks; a word wider than a line is
-- broken between characters.
function theme.wrap(text: string, font: string, width: number): string[]
	surface.SetFont(font)
	local lines: string[] = {}
	for paragraph in string.gmatch(`${text}\n`, "(.-)\r?\n") do
		local line = ""
		for word in string.gmatch(paragraph, "%S+") do
			local candidate = line == "" and word or `${line} ${word}`
			local candidateWidth = surface.GetTextSize(candidate)
			if candidateWidth <= width then
				line = candidate
			else
				if line ~= "" then
					table.insert(lines, line)
				end
				line = ""
				for char in string.gmatch(word, utf8.charpattern) do
					local extended = line .. char
					local extendedWidth = surface.GetTextSize(extended)
					if line ~= "" and extendedWidth > width then
						table.insert(lines, line)
						line = char
					else
						line = extended
					end
				end
			end
		end
		table.insert(lines, line)
	end
	return lines
end

------------------------------------------------------------------------------ rounded boxes

-- draw.RoundedBox's corner textures are close to 1-bit at small radii, so corners are drawn
-- from masks rendered once per radius: each texel holds the exact coverage of a quarter
-- circle (4x4 supersampled), drawn 1:1 with point sampling. "outside" masks hold the rest of the
-- square, and "ring" masks the one-pixel band between the circle and the next smaller one.
local CORNER_TEXTURE_FLAGS = 1 + 4 + 8 + 256 + 512 -- point sample, clamp S/T, no mips, no LOD
local cornerMasks: Table<string, DonatosMask> = {}

local type DonatosCornerKind = "inside" | "outside" | "ring"

local type DonatosMask = { material: IMaterial; extent: number }

-- Bakes a `size` x `size` alpha mask into a render target named `name`: `alphaAt(x, y)` gives
-- each texel's alpha (0-255). Returned with the fraction of the texture it fills.
local function bakeMask(name: string, size: number, alphaAt: (x: number, y: number) => number): DonatosMask
	local textureSize = 4
	while textureSize < size do
		textureSize = textureSize * 2
	end
	local target = GetRenderTargetEx(name, textureSize, textureSize, RT_SIZE_LITERAL, MATERIAL_RT_DEPTH_NONE, CORNER_TEXTURE_FLAGS, 0, IMAGE_FORMAT_BGRA8888)

	-- render.Clear inside the pushed target leaves it opaque black; this clears to transparent.
	render.ClearRenderTarget(target, Color(255, 255, 255, 0))
	render.PushRenderTarget(target)
	render.OverrideAlphaWriteEnable(true, true)
	cam.Start2D()
	render.OverrideBlend(true, BLEND_ONE, BLEND_ZERO, BLENDFUNC_ADD, BLEND_ONE, BLEND_ZERO, BLENDFUNC_ADD)
	draw.NoTexture()
	for y = 0, size - 1 do
		for x = 0, size - 1 do
			local alpha = math.Round(alphaAt(x, y))
			-- surface skips fully transparent draws; those texels keep the clear.
			if alpha > 0 then
				surface.SetDrawColor(255, 255, 255, alpha)
				surface.DrawRect(x, y, 1, 1)
			end
		end
	end
	render.OverrideBlend(false)
	cam.End2D()
	render.OverrideAlphaWriteEnable(false)
	render.PopRenderTarget()

	local material = CreateMaterial(name, "UnlitGeneric", {
		["$basetexture"] = target:GetName(),
		["$translucent"] = 1,
		["$vertexalpha"] = 1,
		["$vertexcolor"] = 1,
	})
	return { material = material, extent = size / textureSize }
end

local SAMPLES = 4

-- The fraction of the pixel at (x, y) for which `inside(sampleX, sampleY)` holds.
local function coverage(x: number, y: number, inside: (sx: number, sy: number) => boolean): number
	local hits = 0
	for sy = 0, SAMPLES - 1 do
		for sx = 0, SAMPLES - 1 do
			if inside(x + (sx + 0.5) / SAMPLES, y + (sy + 0.5) / SAMPLES) then
				hits = hits + 1
			end
		end
	end
	return hits / (SAMPLES * SAMPLES)
end

local function cornerMask(radius: number, kind: DonatosCornerKind): DonatosMask
	local key = `${radius}${kind}`
	local cached = cornerMasks[key]
	if cached ~= nil then
		return cached
	end

	local function within(r: number): (sx: number, sy: number) => boolean
		return function(sx: number, sy: number): boolean
			return (radius - sx) ^ 2 + (radius - sy) ^ 2 <= r * r
		end
	end
	local mask = bakeMask(`donatos_corner_v4_${key}`, radius, function(x: number, y: number): number
		local covered = coverage(x, y, within(radius))
		if kind == "outside" then
			covered = 1 - covered
		elseif kind == "ring" then
			covered = covered - coverage(x, y, within(radius - 1))
		end
		return covered * 255
	end)
	cornerMasks[key] = mask
	return mask
end

local function drawCorner(mask: DonatosMask, x: number, y: number, radius: number, flipX: boolean, flipY: boolean)
	local e = mask.extent
	surface.SetMaterial(mask.material)
	surface.DrawTexturedRectUV(x, y, radius, radius, flipX and e or 0, flipY and e or 0, flipX and 0 or e, flipY and 0 or e)
end

-- A rounded box with anti-aliased corners; the flags choose which corners are rounded.
function theme.box(
	radius: number,
	x: number,
	y: number,
	w: number,
	h: number,
	color: Color,
	tl?: boolean,
	tr?: boolean,
	bl?: boolean,
	br?: boolean
)
	x, y, w, h = math.Round(x), math.Round(y), math.Round(w), math.Round(h)
	local r = math.min(math.Round(radius), math.floor(math.min(w, h) / 2))
	surface.SetDrawColor(color)
	draw.NoTexture()
	if r <= 0 then
		surface.DrawRect(x, y, w, h)
		return
	end
	surface.DrawRect(x + r, y, w - r * 2, h)
	surface.DrawRect(x, y + r, r, h - r * 2)
	surface.DrawRect(x + w - r, y + r, r, h - r * 2)

	local mask = cornerMask(r, "inside")
	local corners: { on: boolean; cx: number; cy: number; fx: boolean; fy: boolean }[] = {
		{ on = tl ~= false, cx = x, cy = y, fx = false, fy = false },
		{ on = tr ~= false, cx = x + w - r, cy = y, fx = true, fy = false },
		{ on = bl ~= false, cx = x, cy = y + h - r, fx = false, fy = true },
		{ on = br ~= false, cx = x + w - r, cy = y + h - r, fx = true, fy = true },
	}
	for _, corner in ipairs(corners) do
		if corner.on then
			surface.SetDrawColor(color)
			drawCorner(mask, corner.cx, corner.cy, r, corner.fx, corner.fy)
		else
			draw.NoTexture()
			surface.SetDrawColor(color)
			surface.DrawRect(corner.cx, corner.cy, r, r)
		end
	end
end

-- Paints `color` outside a circle inscribed in the square at (x, y): drawn over a square image,
-- it leaves an anti-aliased circle, provided `color` is what lies behind.
function theme.circleCutout(x: number, y: number, size: number, color: Color)
	local r = math.floor(size / 2)
	local mask = cornerMask(r, "outside")
	surface.SetDrawColor(color)
	drawCorner(mask, x, y, r, false, false)
	drawCorner(mask, x + size - r, y, r, true, false)
	drawCorner(mask, x, y + size - r, r, false, true)
	drawCorner(mask, x + size - r, y + size - r, r, true, true)
end

-- A one-pixel rounded border; the flags choose which corners are rounded, as for `theme.box`.
function theme.ring(
	radius: number,
	x: number,
	y: number,
	w: number,
	h: number,
	color: Color,
	tl?: boolean,
	tr?: boolean,
	bl?: boolean,
	br?: boolean
)
	x, y, w, h = math.Round(x), math.Round(y), math.Round(w), math.Round(h)
	local r = math.min(math.Round(radius), math.floor(math.min(w, h) / 2))
	local rtl = (tl ~= false and r > 0) and r or 0
	local rtr = (tr ~= false and r > 0) and r or 0
	local rbl = (bl ~= false and r > 0) and r or 0
	local rbr = (br ~= false and r > 0) and r or 0
	surface.SetDrawColor(color)
	draw.NoTexture()
	surface.DrawRect(x + rtl, y, w - rtl - rtr, 1)
	surface.DrawRect(x + rbl, y + h - 1, w - rbl - rbr, 1)
	surface.DrawRect(x, y + math.max(rtl, 1), 1, h - math.max(rtl, 1) - math.max(rbl, 1))
	surface.DrawRect(x + w - 1, y + math.max(rtr, 1), 1, h - math.max(rtr, 1) - math.max(rbr, 1))
	if r <= 0 then
		return
	end
	local mask = cornerMask(r, "ring")
	if rtl > 0 then
		drawCorner(mask, x, y, r, false, false)
	end
	if rtr > 0 then
		drawCorner(mask, x + w - r, y, r, true, false)
	end
	if rbl > 0 then
		drawCorner(mask, x, y + h - r, r, false, true)
	end
	if rbr > 0 then
		drawCorner(mask, x + w - r, y + h - r, r, true, true)
	end
end

-- A filled rounded box with a one-pixel border over its edge, as a web element draws them.
function theme.outlined(radius: number, x: number, y: number, w: number, h: number, fill: Color, border: Color)
	theme.box(radius, x, y, w, h, fill)
	theme.ring(radius, x, y, w, h, border)
end

local function sampleGradient(t: number): Color
	local position = math.Clamp(t, 0, 1) * (#GRADIENT - 1)
	local index = math.min(math.floor(position) + 1, #GRADIENT - 1)
	local from = assert(GRADIENT[index])
	local to = assert(GRADIENT[index + 1])
	local f = position - (index - 1)
	return Color(
		Lerp(f, from.r, to.r),
		Lerp(f, from.g, to.g),
		Lerp(f, from.b, to.b),
		Lerp(f, from.a, to.a)
	)
end

-- The header gradient's colour at `x` of a header `w` wide, at the current moment.
function theme.gradientAt(x: number, w: number): Color
	local cycle = (RealTime() % 10) / 10
	local eased = (1 - math.cos(cycle * math.pi * 2)) / 2
	return sampleGradient(eased * 0.75 + 0.25 * x / w)
end

-- The header's slowly drifting four-colour gradient (a quarter of it visible at a time), with
-- its top corners rounded by `radius` in the gradient's colour at each edge.
function theme.paintGradient(w: number, h: number, radius: number)
	local function at(x: number): Color
		return theme.gradientAt(x, w)
	end
	local corner = radius * 2
	local strip = math.max(theme.px(4), 2)
	for x = corner, w - corner - 1, strip do
		surface.SetDrawColor(at(x))
		surface.DrawRect(x, 0, math.min(strip, w - corner - x), h)
	end
	theme.box(radius, 0, 0, corner, h, at(radius), true, false, false, false)
	theme.box(radius, w - corner, 0, corner, h, at(w - radius), false, true, false, false)
end

-- A ring of dots with a rotating bright head.
function theme.spinner(cx: number, cy: number, radius: number, color: Color)
	local dots = 8
	local head = math.floor(RealTime() * 12) % dots
	local dotRadius = math.max(radius * 0.22, 1)
	for i = 0, dots - 1 do
		local angle = i / dots * math.pi * 2
		local age = (head - i) % dots
		local dot = theme.fade(color, 1 - age / dots * 0.85)
		theme.box(
			dotRadius,
			cx + math.cos(angle) * radius - dotRadius,
			cy + math.sin(angle) * radius - dotRadius,
			dotRadius * 2,
			dotRadius * 2,
			dot
		)
	end
end

local type DonatosIcon = "more" | "moreHorizontal" | "close" | "chevronDown" | "bag" | "cube" | "calendar"

-- Icons are shapes on a 24-unit grid, like the web UI's Hugeicons, with 2-unit strokes.
local HALF_STROKE = 1

local function segmentDistance(px: number, py: number, ax: number, ay: number, bx: number, by: number): number
	local dx, dy = bx - ax, by - ay
	local t = math.Clamp(((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy), 0, 1)
	return math.sqrt((px - ax - dx * t) ^ 2 + (py - ay - dy * t) ^ 2)
end

local function pathDistance(px: number, py: number, points: [number, number][], closed?: boolean): number
	local best = math.huge
	local count = #points
	for i = 1, closed and count or count - 1 do
		local a = assert(points[i])
		local b = assert(points[i % count + 1])
		best = math.min(best, segmentDistance(px, py, a[1], a[2], b[1], b[2]))
	end
	return best
end

-- Distance to the outline of a rounded rectangle.
local function roundRectDistance(px: number, py: number, x: number, y: number, w: number, h: number, r: number): number
	local qx = math.abs(px - x - w / 2) - (w / 2 - r)
	local qy = math.abs(py - y - h / 2) - (h / 2 - r)
	local outside = math.sqrt(math.max(qx, 0) ^ 2 + math.max(qy, 0) ^ 2)
	return math.abs(outside + math.min(math.max(qx, qy), 0) - r)
end

local function dotsDistance(px: number, py: number, dots: [number, number][], radius: number): number
	local best = math.huge
	for _, dot in ipairs(dots) do
		best = math.min(best, math.sqrt((px - dot[1]) ^ 2 + (py - dot[2]) ^ 2) - radius)
	end
	return best
end

local CUBE_OUTLINE: [number, number][] = { { 12, 2.5 }, { 20.5, 7 }, { 20.5, 17 }, { 12, 21.5 }, { 3.5, 17 }, { 3.5, 7 } }

-- How far a grid point lies outside each icon's ink (<= 0 is inked).
local ICON_SHAPES: { [K in DonatosIcon]: (px: number, py: number) => number } = {
	more = function(px: number, py: number): number
		return dotsDistance(px, py, { { 12, 5 }, { 12, 12 }, { 12, 19 } }, 1.75)
	end,
	moreHorizontal = function(px: number, py: number): number
		return dotsDistance(px, py, { { 5, 12 }, { 12, 12 }, { 19, 12 } }, 1.75)
	end,
	close = function(px: number, py: number): number
		return math.min(segmentDistance(px, py, 5, 5, 19, 19), segmentDistance(px, py, 19, 5, 5, 19)) - HALF_STROKE
	end,
	chevronDown = function(px: number, py: number): number
		return pathDistance(px, py, { { 6, 9 }, { 12, 15 }, { 18, 9 } }) - HALF_STROKE
	end,
	bag = function(px: number, py: number): number
		-- A rounded bag with its handle curving down inside the top.
		local body = roundRectDistance(px, py, 3.5, 3, 17, 18.5, 4.5)
		local handle = py >= 7 and math.abs(math.sqrt((px - 12) ^ 2 + (py - 7) ^ 2) - 3.5) or math.huge
		return math.min(body, handle) - HALF_STROKE
	end,
	cube = function(px: number, py: number): number
		local edges = pathDistance(px, py, CUBE_OUTLINE, true)
		local inner = pathDistance(px, py, { { 3.5, 7 }, { 12, 11.5 }, { 20.5, 7 } })
		inner = math.min(inner, segmentDistance(px, py, 12, 11.5, 12, 21.5))
		return math.min(edges, inner) - HALF_STROKE
	end,
	calendar = function(px: number, py: number): number
		local d = roundRectDistance(px, py, 2.5, 3.5, 19, 18.5, 4)
		d = math.min(d, segmentDistance(px, py, 3, 9, 21, 9))
		d = math.min(d, segmentDistance(px, py, 7.5, 2, 7.5, 5), segmentDistance(px, py, 16.5, 2, 16.5, 5))
		d = d - HALF_STROKE
		return math.min(d, dotsDistance(px, py, { { 8, 13.5 }, { 12, 13.5 }, { 16, 13.5 }, { 8, 17.5 }, { 12, 17.5 } }, 1))
	end,
}

local WHITE = Color(255, 255, 255)
local iconMasks: Table<string, DonatosMask> = {}

-- Bakes `icon` at `size` pixels: each texel's ink coverage, with the alpha converted for
-- GMod's linear blending (see blendAlpha) so edges look as they would in a browser.
local function iconMask(icon: DonatosIcon, size: number): DonatosMask
	local key = `${icon}${size}`
	local cached = iconMasks[key]
	if cached ~= nil then
		return cached
	end
	local shape = ICON_SHAPES[icon]
	local unit = 24 / size
	local mask = bakeMask(`donatos_icon_v1_${key}`, size, function(x: number, y: number): number
		local covered = coverage(x, y, function(sx: number, sy: number): boolean
			return shape(sx * unit, sy * unit) <= 0
		end)
		return covered > 0 and blendAlpha(WHITE, covered * 255) or 0
	end)
	iconMasks[key] = mask
	return mask
end

-- Draws `icon` in `color`, centred in a `size` box at (x, y).
function theme.icon(icon: DonatosIcon, x: number, y: number, size: number, color: Color)
	local pixels = math.max(math.Round(size), 4)
	local mask = iconMask(icon, pixels)
	local left = math.Round(x + (size - pixels) / 2)
	local top = math.Round(y + (size - pixels) / 2)
	surface.SetMaterial(mask.material)
	surface.SetDrawColor(color)
	surface.DrawTexturedRectUV(left, top, pixels, pixels, 0, 0, mask.extent, mask.extent)
end

theme.refresh()

return theme
