-- Client: the donatos menu window. It renders from the synced state (remote config and the
-- local player's data) and re-renders whenever the server pushes either.

local log = require("utils.log")
local async = require("utils.async")
local state = require("utils.state")
local gallery = require("ui.gallery")
local history = require("ui.history")
local items = require("ui.items")
local shop = require("ui.shop")
local theme = require("ui.theme")
local views = require("ui.views")
local widgets = require("ui.widgets")

local colors = theme.colors
local px = theme.px

local menuState = state.menu

local current: DonatosMenuState = {
	tab = "shop",
	scroll = {},
	query = "",
	section = nil,
	instant = true,
	searchEntry = nil,
}

-- The window's corner radius; the top bar and the dialog overlay follow it.
local RADIUS = 24

local lastUsedAt = RealTime()

local function markUsed()
	lastUsedAt = RealTime()
end

local function getFrame(): Panel | nil
	local frame = menuState.frame
	if frame ~= nil and IsValid(frame) then
		return frame
	end
	return nil
end

local function destroy()
	gallery.closeViewer(true)
	local frame = menuState.frame
	if IsValid(frame) then
		frame:Remove()
	end
	menuState.frame = nil
end

local function remoteData(): NonNullable<DonatosRemoteData> | nil
	local ply = LocalPlayer()
	if not IsValid(ply) then
		return nil
	end
	return ply:Donatos()._remoteData.data
end

local function steamID64(): string | nil
	local ply = LocalPlayer()
	return IsValid(ply) and ply:SteamID64() or nil
end

local function canPay(): boolean
	return state.remoteConfig.value ~= nil and steamID64() ~= nil
end

-- The window enters and leaves like HeroUI's modal: fading in while settling from 1.05 to 1
-- over 250ms ease-out-quad, and out to 0.95 over 100ms.
local windowIn = theme.tween(0)
local closing = false

local function hide()
	markUsed()
	local frame = getFrame()
	if frame ~= nil and frame:IsVisible() and not closing then
		closing = true
		gallery.closeViewer(true)
		-- Input stays with the window for its 100ms exit: Set*InputEnabled cascades to every
		-- child, and MakePopup turns it back on for the window alone.
		windowIn.to(0, 0.1, "outQuad")
	end
end

-- The selected tab's indicator, kept across top bar rebuilds so it can slide (HeroUI's tabs:
-- 250ms ease-out-fluid).
local indicatorX = theme.tween(0)
local indicatorW = theme.tween(0)

local render: () => void = function() end
-- The account popover under the bar's balance: the player, a top-up and the colour scheme,
-- which each player picks for themselves (kept between sessions). A scheme picked shows at
-- once: the colours change in place and the bar and page are built again from them, with the
-- popover still open over them.
local function openAccount(anchor: Panel, ctx: DonatosMenuContext)
	widgets.popover(anchor, px(296), function(parent: Panel, width: number): number
		local pad = px(16)
		local y = pad

		local ply = LocalPlayer()
		local face = px(40)
		if IsValid(ply) then
			local avatar = widgets.avatar(parent, face, ply, function(): Color[]
				return { colors.surface }
			end)
			avatar:SetPos(pad, y)
		end
		local name = IsValid(ply) and ply:Nick() or ""
		local who = widgets.painted(parent, face, function(w: number, h: number)
			local data = remoteData()
			local balance = data and data.player.balance or 0
			local nameFont, balanceFont = theme.font("medium"), theme.font("small")
			draw.SimpleText(name, nameFont, 0, h / 2 - px(1), colors.text, TEXT_ALIGN_LEFT, TEXT_ALIGN_BOTTOM)
			draw.SimpleText(`${views.formatNumber(balance)} ${views.bonuses(balance)}`, balanceFont, 0, h / 2 + px(2), colors.muted, TEXT_ALIGN_LEFT, TEXT_ALIGN_TOP)
		end)
		who.panel:SetPos(pad + face + px(12), y)
		who.panel:SetSize(width - pad * 2 - face - px(12), face)
		y = y + face + px(14)

		local topUp = widgets.button(parent, {
			label = "Пополнить баланс",
			icon = "plus",
			variant = "primary",
			disabled = not canPay(),
			onClick = function()
				widgets.closeDropdown()
				views.topUp(ctx)
			end,
		})
		topUp:SetPos(pad, y)
		topUp:SetWide(width - pad * 2)
		y = y + topUp:GetTall() + pad

		local line = widgets.painted(parent, 1, function(w: number, h: number)
			surface.SetDrawColor(colors.separator)
			surface.DrawRect(0, 0, w, h)
		end)
		line.panel:SetPos(0, y)
		line.panel:SetSize(width, 1)
		y = y + 1 + px(14)

		-- The swatches, one per scheme; the heading names the one hovered, else the current.
		local schemes = theme.schemes()
		local swatches: DButton[] = {}
		local heading = widgets.painted(parent, px(18), function(w: number, h: number)
			local shown = theme.scheme
			for i, swatch in ipairs(swatches) do
				if swatch:IsHovered() then
					shown = assert(schemes[i]).name
				end
			end
			local label = ""
			for _, entry in ipairs(schemes) do
				if entry.name == shown then
					label = entry.label
				end
			end
			local font = theme.font("small")
			draw.SimpleText("Оформление", font, 0, h / 2, colors.muted, TEXT_ALIGN_LEFT, TEXT_ALIGN_CENTER)
			draw.SimpleText(label, font, w, h / 2, colors.textSoft, TEXT_ALIGN_RIGHT, TEXT_ALIGN_CENTER)
		end)
		heading.panel:SetPos(pad, y)
		heading.panel:SetSize(width - pad * 2, px(18))
		y = y + px(18) + px(12)

		local size = px(32)
		local gap = (width - pad * 2 - size * #schemes) / math.max(#schemes - 1, 1)
		for i, entry in ipairs(schemes) do
			local swatch = vgui.Create("DButton", parent) as DButton
			swatch:SetText("")
			swatch:SetSize(size, size)
			swatch:SetPos(math.Round(pad + (i - 1) * (size + gap)), y)
			local hover = theme.tween(0)
			swatch.Paint = function(self: DButton, w: number, h: number): boolean
				local picked = entry.name == theme.scheme
				hover.to(self:IsHovered() and 1 or 0, 0.15, "smooth")
				-- The current one is ringed, a hovered one faintly.
				local ring = picked and colors.text or theme.mix(nil, colors.defaultHover, hover.value())
				if ring ~= nil then
					theme.box(w / 2, 0, 0, w, h, ring)
					theme.box(w / 2 - px(2), px(2), px(2), w - px(4), h - px(4), colors.surface)
				end
				local inset = px(4)
				theme.outlined(w / 2 - inset, inset, inset, w - inset * 2, h - inset * 2, entry.swatch, colors.frameRing)
				return true
			end
			swatch.DoClick = function(self: DButton)
				if entry.name ~= theme.scheme then
					theme.setScheme(entry.name)
					render()
				end
			end
			table.insert(swatches, swatch)
		end
		return y + size + pad
	end)
end

-- The open window's dialog host, for Escape.
local frameDialogs: DonatosUiDialogHost | nil = nil

-- The gradient top bar: server, page tabs, balance with top-up, and the player.
local function buildTopBar(frame: Panel, ctx: DonatosMenuContext): Panel
	local bar = vgui.Create("DPanel", frame)
	bar:SetTall(px(60))
	bar.Paint = function(self: Panel, w: number, h: number): boolean
		theme.paintGradient(w, h, px(RADIUS))
		return true
	end

	local data = remoteData()
	-- The badge is a to-do count: items waiting to be activated.
	local waiting = data and #data.inventoryItems or 0
	local tabs = widgets.blankPanel(bar)
	tabs.Paint = function(self: Panel, w: number, h: number): boolean
		theme.box(h / 2, 0, 0, w, h, colors.barTabs)
		local inset = px(4)
		theme.box((h - inset * 2) / 2, indicatorX.value(), inset, indicatorW.value(), h - inset * 2, colors.barPill)
		return true
	end
	local tabSpecs: { tab: DonatosMenuTab; label: string; icon: DonatosIcon; badge?: number }[] = {
		{ tab = "shop", label = "Магазин", icon = "bag" },
		{ tab = "items", label = "Мои предметы", icon = "cube", badge = waiting },
		{ tab = "history", label = "История", icon = "clock" },
	}
	local tabButtons: DButton[] = {}
	for _, spec in ipairs(tabSpecs) do
		local tabButton: DButton | nil = nil
		tabButton = widgets.button(tabs, {
			label = spec.label,
			icon = spec.icon,
			size = "sm",
			variant = "segment",
			active = current.tab == spec.tab,
			badge = spec.badge,
			selection = function(): (number, number)
				local left = indicatorX.value() - (tabButton and tabButton:GetX() or 0)
				return left, left + indicatorW.value()
			end,
			onClick = function()
				ctx.showTab(spec.tab)
			end,
		})
		table.insert(tabButtons, tabButton)
	end

	-- The account: avatar and balance in one pill, opening the account popover.
	local balanceValue = data and data.player.balance or 0
	local balanceText = views.formatNumber(balanceValue)
	local balanceUnit = views.bonuses(balanceValue)
	local account = vgui.Create("DButton", bar) as DButton
	account:SetText("")
	local accountHover = theme.tween(0)
	local ply = LocalPlayer()
	local face = px(28)
	local avatar: Panel | nil = nil
	if IsValid(ply) then
		avatar = widgets.avatar(account, face, ply, function(): Color[]
			local center = account:GetX() + px(4) + face / 2
			local behind = { colors.window, theme.gradientAt(center, bar:GetWide()), colors.barShade }
			local hovered = accountHover.value()
			if hovered > 0 then
				table.insert(behind, theme.fade(colors.barHover, hovered))
			end
			return behind
		end)
		avatar:SetPos(px(4), px(4))
		avatar:SetMouseInputEnabled(false)
	end
	local textX = avatar ~= nil and px(4) + face + px(10) or px(14)
	account.Paint = function(self: DButton, w: number, h: number): boolean
		accountHover.to(self:IsHovered() and 1 or 0, 0.15, "smooth")
		theme.box(h / 2, 0, 0, w, h, colors.barShade)
		local hovered = accountHover.value()
		if hovered > 0 then
			theme.box(h / 2, 0, 0, w, h, theme.fade(colors.barHover, hovered))
		end
		local font = theme.font("medium")
		local y = (h - theme.fontHeight(font)) / 2
		draw.SimpleText(balanceText, font, textX, y, colors.barText)
		draw.SimpleText(balanceUnit, font, textX + theme.textSize(`${balanceText} `, font), y, colors.barTextDim)
		local chevron = px(16)
		theme.icon("chevronDown", w - px(10) - chevron, (h - chevron) / 2, chevron, colors.barTextDim)
		return true
	end
	account.DoClick = function(self: DButton)
		openAccount(self, ctx)
	end

	local close = widgets.button(bar, { icon = "close", size = "sm", variant = "shade", onClick = ctx.close })

	bar.PerformLayout = function(self: Panel, w: number, h: number)
		local x = px(12)
		local inset = px(4)
		local tx = inset
		for i, btn in ipairs(tabButtons) do
			btn:SetPos(tx, inset)
			local spec = assert(tabSpecs[i])
			if spec.tab == current.tab then
				if indicatorW.target() == 0 then
					indicatorX.set(tx)
					indicatorW.set(btn:GetWide())
				else
					indicatorX.to(tx, 0.25, "outFluid")
					indicatorW.to(btn:GetWide(), 0.25, "outFluid")
				end
			end
			tx = tx + btn:GetWide()
		end
		tabs:SetPos(x, (h - px(40)) / 2)
		tabs:SetSize(tx + inset, px(40))

		local right = w - px(14) - close:GetWide()
		close:SetPos(right, (h - close:GetTall()) / 2)
		local accountWidth = textX + theme.textSize(`${balanceText} ${balanceUnit}`, theme.font("medium")) + px(8) + px(16) + px(10)
		right = right - px(12) - accountWidth
		account:SetPos(right, (h - px(36)) / 2)
		account:SetSize(accountWidth, px(36))
	end

	return bar
end

local function create(): Panel
	destroy()
	log.debug("Creating menu")

	local frame = vgui.Create("EditablePanel")
	menuState.frame = frame
	-- The design's 1200x680 window, scaled with the screen, inside a 20 margin on small screens.
	local width = math.min(px(1200), ScrW() - 40)
	local height = math.min(px(680), ScrH() - 40)
	frame:SetSize(math.Round(width), math.Round(height))
	frame:Center()
	local scaled = false
	frame.Paint = function(self: Panel, w: number, h: number): boolean
		local t = windowIn.value()
		theme.captureBehind("window", t)
		scaled = theme.pushScale(self, closing and Lerp(t, 0.95, 1) or Lerp(t, 1.05, 1), w / 2, h / 2)
		theme.box(px(RADIUS), 0, 0, w, h, colors.window)
		return true
	end
	frame.PaintOver = function(self: Panel, w: number, h: number): boolean
		theme.ring(px(RADIUS), 0, 0, w, h, colors.frameRing)
		theme.popScale(scaled)
		scaled = false
		theme.coverBehind("window", self, windowIn.value())
		return true
	end
	frame.Think = function(self: Panel)
		-- Fades out as the picture viewer comes in over it, and back as it leaves.
		self:SetAlpha(math.Round(255 * (1 - gallery.cover())))
		if closing and windowIn.done() then
			closing = false
			self:SetVisible(false)
		end
	end

	local dialogs = widgets.dialogHost(frame, px(RADIUS))
	frameDialogs = dialogs
	local header: Panel | nil = nil
	local body: Panel | nil = nil
	local area: () => DonatosUiScroll | nil = function()
		return nil
	end

	frame.PerformLayout = function(self: Panel, w: number, h: number)
		dialogs.cover(w, h)
		local top = 0
		if header ~= nil and IsValid(header) then
			header:SetPos(0, 0)
			header:SetSize(w, px(60))
			top = px(60)
		end
		if body ~= nil and IsValid(body) then
			body:SetPos(0, top)
			body:SetSize(w, h - top)
		end
	end

	local ctx: DonatosMenuContext = {
		dialogs = dialogs,
		config = function()
			return state.remoteConfig.value
		end,
		data = remoteData,
		loaded = function()
			local ply = LocalPlayer()
			return IsValid(ply) and ply:Donatos()._remoteData.isLoaded
		end,
		canPay = canPay,
		rerender = function()
			render()
		end,
		showTab = function(tab: DonatosMenuTab)
			if current.tab ~= tab then
				current.tab = tab
				render()
			end
		end,
		close = hide,
		state = current,
	}

	-- Rebuilds the header and the current tab, keeping each tab's scroll position.
	local renderedTab: DonatosMenuTab | nil = nil

	-- Rebuilds the top bar and the current page, keeping each page's scroll position and the
	-- search field's focus.
	local function renderFrame()
		local previous = area()
		if renderedTab ~= nil and previous ~= nil and IsValid(previous.panel) then
			current.scroll[renderedTab] = previous.scroll()
		end
		local search = current.searchEntry
		local searching = search ~= nil and IsValid(search) and search:HasFocus()
		current.searchEntry = nil
		if header ~= nil and IsValid(header) then
			header:Remove()
		end
		if body ~= nil and IsValid(body) then
			body:Remove()
		end

		header = buildTopBar(frame, ctx)
		local content = widgets.blankPanel(frame)
		body = content
		if current.tab == "shop" then
			area = shop.shop(content, ctx)
		elseif current.tab == "history" then
			area = history.history(content, ctx)
		else
			area = items.items(content, ctx)
		end
		renderedTab = current.tab

		frame:InvalidateLayout(true)
		content:InvalidateLayout(true)
		local scrollArea = area()
		local saved = current.scroll[current.tab]
		if scrollArea ~= nil and saved ~= nil then
			scrollArea.panel:InvalidateLayout(true)
			scrollArea.setScroll(saved)
		end
		-- The page just set it; read it back without the narrowing from the reset above.
		local entry = current.searchEntry as DTextEntry | nil
		if searching and entry ~= nil and IsValid(entry) then
			entry:RequestFocus()
			entry:SetCaretPos(#entry:GetValue())
		end
	end

	render = function()
		if IsValid(frame) then
			renderFrame()
		end
	end
	renderFrame()
	return frame
end

-- donatos.OpenUI and the server's openUi name the old tabs; both item tabs are «Мои предметы».
local TABS: Table<string, DonatosMenuTab> = {
	shop = "shop",
	inventory = "items",
	activeItems = "items",
	items = "items",
	history = "history",
}

local function open(tab?: string): Panel
	markUsed()

	local dev = donatos.dev
	if dev and dev.enabled then
		destroy()
	end

	local requested = tab and TABS[tab]
	if requested ~= nil then
		current.tab = requested
	end

	-- Brought up over an open picture viewer (by the server or another addon), the window
	-- would take its input while still hidden under it.
	gallery.closeViewer(true)

	local frame = getFrame()
	local entering = frame == nil or closing or not frame:IsVisible()
	if frame == nil then
		frame = create()
	else
		render()
	end

	if entering then
		-- Reopened mid-exit, it turns back from where it is.
		if not closing then
			windowIn.set(0)
		end
		closing = false
		windowIn.to(1, 0.25, "outQuad")
	end
	frame:SetVisible(true)
	frame:MakePopup()
	return frame
end

-- Called when the server pushes new data: re-render if the menu is showing.
local function refresh()
	local frame = getFrame()
	if frame ~= nil and frame:IsVisible() then
		render()
	end
end

local function performGc()
	local frame = menuState.frame
	if frame == nil then
		return
	end
	if not IsValid(frame) then
		menuState.frame = nil
		return
	end
	if frame:IsVisible() or RealTime() - lastUsedAt < 5 * 60 then
		return
	end
	destroy()
end

destroy()

-- Closes the topmost layer: the picture viewer, a dropdown, then a dialog, then the menu
-- itself.
local function closeTopLayer()
	local dialogs = frameDialogs
	if gallery.closeViewer() or widgets.closeDropdown() then
		return
	elseif dialogs ~= nil and dialogs.isOpen() then
		dialogs.close()
		return
	end
	hide()
end

-- A click outside the window (on the game world) closes the topmost layer, so with a dialog
-- open it closes just the dialog.
hook.Add("GUIMousePressed", state.hookId("menu"), function()
	local frame = getFrame()
	if frame ~= nil and frame:IsVisible() and not closing then
		closeTopLayer()
	end
end)

-- Escape closes the topmost layer instead of opening the pause menu.
hook.Add("OnPauseMenuShow", state.hookId("menu"), function(): boolean | nil
	local frame = getFrame()
	if frame == nil or not frame:IsVisible() then
		return nil
	end
	if not closing then
		closeTopLayer()
	end
	return false
end)

-- Under the picture viewer the window isn't drawn (it stays open, keeping its state): the
-- viewer fades in over the game alone, and out over the window, back as it starts leaving.
gallery.setOnCover(function(covering: boolean)
	local frame = getFrame()
	if frame ~= nil then
		frame:SetPaintedManually(covering)
	end
end)

hook.Add("OnScreenSizeChanged", state.hookId("menu"), function()
	theme.refresh()
	destroy()
end)

async.run(suspend function()
	while true do
		state.delay(60)
		performGc()
	end
end)

return {
	open = open,
	refresh = refresh,
}
