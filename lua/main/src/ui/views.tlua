-- Client: what the menu's pages share: the context they render from, formatting, empty
-- states, and the dialogs more than one page opens.

local netMessage = require("donatos.net")
local images = require("ui.images")
local theme = require("ui.theme")
local widgets = require("ui.widgets")

local colors = theme.colors
local px = theme.px

type DonatosMenuTab = "shop" | "items" | "history"

interface DonatosMenuContext {
	dialogs: DonatosUiDialogHost;
	config: () => DonatosRemoteConfig | nil;
	data: () => NonNullable<DonatosRemoteData> | nil;
	loaded: () => boolean;
	canPay: () => boolean;
	-- Re-renders after a local state change.
	rerender: () => void;
	showTab: (tab: DonatosMenuTab) => void;
	close: () => void;
	state: DonatosMenuState;
}

interface DonatosMenuState {
	tab: DonatosMenuTab;
	scroll: Table<string, number>;
	query: string;
	-- The shop section the category bar shows as current.
	section: number | nil;
	-- The item dialog's "Активировать сразу" switch, remembered between purchases.
	instant: boolean;
	searchEntry: DTextEntry | nil;
}

local DEFAULT_ERROR = "Не удалось выполнить действие. Попробуйте еще раз."

------------------------------------------------------------------------------ formatting

-- 9300 -> "9 300".
local function formatNumber(value: number | string): string
	local digits = tostring(value)
	local sign, whole, rest = string.match(digits, "^(-?)(%d+)(.*)$")
	if whole == nil then
		return digits
	end
	local grouped = string.reverse((string.gsub(string.reverse(whole), "(%d%d%d)", "%1 ")))
	return `${sign}${string.TrimLeft(grouped)}${rest}`
end

-- A variant's duration, short: "30 дн.". The API's duration is in days; 0 is permanent and
-- nil (JSON null) a one-time good, which activation uses up without an active item.
local function formatDays(duration?: number): string
	if duration == nil then
		return "Разовый"
	elseif duration == 0 then
		return "Навсегда"
	end
	return `${duration} дн.`
end

local function plural(count: number, one: string, few: string, many: string): string
	local tens = count % 100
	local units = count % 10
	if tens >= 11 and tens <= 14 then
		return many
	elseif units == 1 then
		return one
	elseif units >= 2 and units <= 4 then
		return few
	end
	return many
end

-- "бонус" agreeing with `count`: "1 бонус", "2 бонуса", "5 бонусов" (also after "за" and "на").
local function bonuses(count: number): string
	return plural(math.abs(count), "бонус", "бонуса", "бонусов")
end

-- The same after "от" or "не хватает": "1 бонуса", "2 бонусов".
local function bonusesGenitive(count: number): string
	return plural(math.abs(count), "бонуса", "бонусов", "бонусов")
end

-- A variant's duration, long: "30 дней".
local function formatDaysLong(duration?: number): string
	if duration == nil then
		return "Разовый товар"
	elseif duration == 0 then
		return "Навсегда"
	end
	return `${duration} ${plural(duration, "день", "дня", "дней")}`
end

-- A duration on its chip: "на 30 дн." ("на 30 дней" when `long`), "Навсегда", "Разовый".
local function formatTerm(duration?: number, long?: boolean): string
	local text = long and formatDaysLong(duration) or formatDays(duration)
	return (duration ~= nil and duration > 0) and `на ${text}` or text
end

-- The icon on a duration's chip: a clock for a term, none for a permanent or one-time good.
local function durationIcon(duration?: number): DonatosIcon | nil
	return (duration ~= nil and duration > 0) and "clock" or nil
end

-- The chip colours for a variant's duration (background, text): green when permanent, blue
-- for a term, neutral for a one-time good.
local function durationColors(duration?: number): (Color, Color)
	if duration == nil then
		return colors.default, colors.textSoft
	elseif duration == 0 then
		return colors.successSoft, colors.success
	end
	return colors.accentSoft, colors.accentText
end

-- Why goods can't be bought or activated here (`unavailable`, from the server), for the player.
-- The server's refusals have their own texts (`UNAVAILABLE` in `donatos/net/server.tlua`).
local UNAVAILABLE: { [K in DonatosUnavailableReason]: string } = {
	notSetUp = "Товар ещё не настроен на сервере",
}

local function unavailableText(reason: DonatosUnavailableReason): string
	return UNAVAILABLE[reason]
end

-- Time left from seconds: "12 дн.", "5 ч.", "40 мин.".
local function formatRemaining(seconds: number): string
	if seconds >= 86400 then
		return `${math.ceil(seconds / 86400)} дн.`
	elseif seconds >= 3600 then
		return `${math.ceil(seconds / 3600)} ч.`
	end
	return `${math.max(math.ceil(seconds / 60), 1)} мин.`
end

-- Lowercases Russian and Latin letters (string.lower leaves Cyrillic alone).
local function lower(value: string): string
	local result = string.lower(value)
	result = string.gsub(result, "\208([\144-\159])", function(byte: string): string
		return `\208${string.char(string.byte(byte) + 32)}`
	end)
	result = string.gsub(result, "\208([\160-\175])", function(byte: string): string
		return `\209${string.char(string.byte(byte) - 32)}`
	end)
	result = string.gsub(result, "\208\129", "\209\145")
	return result
end

------------------------------------------------------------------------------ dialogs

local function showError(ctx: DonatosMenuContext, message?: string)
	ctx.dialogs.show({
		title = "Ошибка",
		description = message ~= nil and message ~= "" and message or DEFAULT_ERROR,
		actions = { { label = "Закрыть", variant = "secondary", onClick = ctx.dialogs.close } },
	})
end

local function cancelAction(ctx: DonatosMenuContext, label?: string): DonatosUiButton
	return { label = label or "Отмена", variant = "secondary", onClick = ctx.dialogs.close }
end

------------------------------------------------------------------------------ top-up

-- The pay page's quick amounts and limits (its createOrderSchema): whole bonuses from 10 to
-- 10 000, 1 ₽ each. gm-donate takes any positive sum; it is held to the same maximum.
local TOP_UP_AMOUNTS: number[] = { 100, 250, 500, 1000 }
local TOP_UP_MIN = 10
local TOP_UP_MAX = 10000

local IGS_NOTICE = "Это сторонний сервис, который подключён администратором сервера и не имеет отношения к Donatos. Доступны скины, криптовалюта и другие методы. Поддержка по этому сервису не предоставляется."

local type TopUpMethod = "donatos" | "igs"

-- A QR code from the API: modules per side, and the rows' modules ("1" dark).
local type DonatosQrGrid = { size: number; modules: string; logo?: DonatosLogo }

-- `logo` goes beside the title.
local type QrSpec = { title: string; text: string; grid: DonatosQrGrid; methods: boolean; logo?: DonatosLogo }

-- The icons a payment method may name.
local METHOD_ICONS: Table<string, DonatosIcon> = { card = "card", wallet = "wallet" }

-- "#RRGGBB" as a Color; nil when it isn't one.
local function hexColor(value: string): Color | nil
	local r, g, b = string.match(value, "^#(%x%x)(%x%x)(%x%x)$")
	if r == nil or g == nil or b == nil then
		return nil
	end
	return Color(tonumber(r, 16) as number, tonumber(g, 16) as number, tonumber(b, 16) as number)
end

-- A payment method's button as the API describes it: its brand's colours and logo, or ours.
local function methodButton(method: DonatosPaymentMethod): DonatosUiButton
	local options: DonatosUiButton = { size = "lg", variant = "secondary" }
	local brand = method.colors
	if brand ~= nil then
		local fill, hover, ink = hexColor(brand.fill), hexColor(brand.hover), hexColor(brand.ink)
		if fill ~= nil and hover ~= nil and ink ~= nil then
			options.brand = { fill = fill, hover = hover, ink = ink }
		end
	end
	local logo = method.logo
	if logo ~= nil and logo.width > 0 and logo.height > 0 then
		options.logo = { url = logo.url, id = logo.id, aspect = logo.width / logo.height, fallback = method.name }
		options.label = method.label
	else
		options.label = method.label ~= nil and `${method.label} ${method.name}` or method.name
	end
	local icon = method.icon
	options.icon = icon ~= nil and METHOD_ICONS[icon] or nil
	return options
end

-- A centred round badge for the top-up's waiting and done states; `paint` draws its centre.
local function badge(parent: Panel, background: Color, paint: (cx: number, cy: number) => void): DonatosUiBlock
	local size = px(56)
	return widgets.painted(parent, size, function(w: number, h: number)
		local x = (w - size) / 2
		theme.box(size / 2, x, 0, size, size, background)
		paint(x + size / 2, size / 2)
	end)
end

-- The «Пополнение баланса» dialog: an amount (quick amounts or any in the field), the method
-- when gm-donate is enabled, the receipt email and terms for our orders; then our order's SBP
-- QR code (T-Kassa's pay page when there is none) or gm-donate's page. It stays open while the
-- player pays, waiting for the balance to grow. `preset` is the amount to start with (what an item is short of).
-- Shown stacked, so closing it returns to the dialog it was opened from.
local function topUp(ctx: DonatosMenuContext, preset?: number)
	ctx.dialogs.showCustom(function(parent: Panel, relayout: () => void): DonatosUiFloating
		local config = ctx.config()
		local igs = config ~= nil and config.igs.enabled
		local method: TopUpMethod = "donatos"
		local amount: number | nil = preset ~= nil and math.Clamp(math.ceil(preset), TOP_UP_MIN, TOP_UP_MAX) or TOP_UP_AMOUNTS[1]
		local errorText: string | nil = nil
		-- The page to open again while waiting: gm-donate's, or T-Kassa's for our order.
		local payUrl: string | nil = nil
		-- The balance when waiting started; any more than that means the payment arrived.
		local waitingFrom: number | nil = nil
		-- The receipt email: the remembered one (masked, from the API) unless the player changes it.
		local data = ctx.data()
		local rememberedEmail = data and data.player.receiptEmail
		local editingEmail = rememberedEmail == nil
		local email = ""
		local rememberEmail = true
		local agreed = false
		-- Our order, once made: its id and SBP code, and why another way to pay didn't open.
		local orderId: number | nil = nil
		local sbpGrid: DonatosQrGrid | nil = nil
		local paymentMethods: DonatosPaymentMethod[] = {}
		local methodError: string | nil = nil
		-- The site, for the terms.
		local site = config ~= nil and string.match(config.payUrl, "^https?://[^/]+") or nil

		local function balance(): number | nil
			local current = ctx.data()
			return current and current.player.balance
		end

		local function amountValid(): boolean
			local value = amount
			if value == nil or value ~= math.floor(value) then
				return false
			end
			return value >= (method == "igs" and 1 or TOP_UP_MIN) and value <= TOP_UP_MAX
		end

		local function emailValid(): boolean
			return not editingEmail or string.match(email, "^[^%s@]+@[^%s@]+%.[^%s@]+$") ~= nil
		end

		-- Everything "Продолжить" needs: our orders also need the receipt email and the terms.
		local function valid(): boolean
			return amountValid() and (method == "igs" or emailValid() and agreed)
		end

		local box = vgui.Create("DPanel", parent)
		box.Paint = function(self: Panel, w: number, h: number): boolean
			theme.box(px(24), 0, 0, w, h, colors.surface)
			theme.ring(px(24), 0, 0, w, h, colors.frameRing)
			return true
		end
		-- Clicks inside the dialog must not reach the overlay, which closes it.
		box.OnMousePressed = function(self: Panel, keyCode: number): boolean
			return true
		end

		-- The current state's content; switching state replaces it.
		local body: DonatosUiBlock | nil = nil
		local function setBody(block: DonatosUiBlock)
			local old = body
			if old ~= nil and IsValid(old.panel) then
				old.panel:Remove()
			end
			body = block
			relayout()
		end

		local function heading(content: Panel, title: string, align?: "left" | "center"): DonatosUiBlock
			return widgets.text(content, { text = title, font = theme.font("section"), color = colors.text, lineHeight = 26, align = align })
		end

		------------------------------------------------------------------ done

		local function doneBlock(): DonatosUiBlock
			local content, add = widgets.stack(box, px(12), px(20))
			add(badge(content.panel, colors.successSoft, function(cx: number, cy: number)
				local size = px(24)
				theme.icon("check", cx - size / 2, cy - size / 2, size, colors.success)
			end))
			add(heading(content.panel, "Баланс пополнен", "center"))
			local current = balance()
			if current ~= nil then
				add(widgets.text(content.panel, {
					text = `На балансе теперь ${formatNumber(current)} ${bonuses(current)}.`,
					font = theme.font("body"),
					color = colors.muted,
					lineHeight = 20,
					align = "center",
				}))
			end
			add(widgets.column(content.panel, px(8), {
				widgets.button(content.panel, { label = "Готово", onClick = ctx.dialogs.close }),
			}))
			return content
		end

		------------------------------------------------------------------ waiting

		local function reopen()
			local url = payUrl
			if url ~= nil then
				gui.OpenURL(url)
			end
		end

		-- Shows the done state once the server pushes the grown balance.
		local function awaitBalance(panel: Panel)
			panel.Think = function(self: Panel)
				local current = balance()
				local from = waitingFrom
				if current == nil then
					return
				elseif from == nil then
					waitingFrom = current
				elseif current > from then
					setBody(doneBlock())
				end
			end
		end

		local function waitingBlock(): DonatosUiBlock
			local content, add = widgets.stack(box, px(12), px(20))
			add(badge(content.panel, colors.accentSoft, function(cx: number, cy: number)
				theme.spinner(cx, cy, px(12), colors.accentText)
			end))
			add(heading(content.panel, "Ждём оплаты…", "center"))
			add(widgets.text(content.panel, {
				text = method == "igs"
						and "Страница оплаты открылась в оверлее Steam или в браузере. Бонусы придут сами после оплаты, это может занять несколько минут."
					or "Страница оплаты открылась в оверлее Steam или в браузере.",
				font = theme.font("body"),
				color = colors.muted,
				lineHeight = 20,
				align = "center",
			}))
			add(widgets.column(content.panel, px(8), {
				widgets.button(content.panel, { label = "Открыть страницу ещё раз", variant = "soft", onClick = reopen }),
				widgets.button(content.panel, { label = "Закрыть", variant = "secondary", onClick = ctx.dialogs.close }),
			}))
			awaitBalance(content.panel)
			return content
		end

		local function wait()
			errorText = nil
			waitingFrom = balance()
			setBody(waitingBlock())
		end

		------------------------------------------------------------------ QR codes

		-- One of our order's QR codes: SBP's, with the other ways to pay under it, or the one a
		-- method's link came with (T-Pay's).
		local qrBlock: (spec: QrSpec) => DonatosUiBlock

		local function sbpSpec(grid: DonatosQrGrid): QrSpec
			return {
				title = "Оплата через СБП",
				text = "Отсканируйте код камерой телефона или в приложении банка.",
				grid = grid,
				methods = true,
				logo = grid.logo,
			}
		end

		qrBlock = function(spec: QrSpec): DonatosUiBlock
			local content, add = widgets.stack(box, px(12), px(20))
			local titleLogo = spec.logo
			if titleLogo ~= nil and titleLogo.width > 0 and titleLogo.height > 0 then
				-- The title after its logo, centred together; the logo fades in once downloaded.
				add(widgets.painted(content.panel, px(26), function(w: number, h: number)
					local font = theme.font("section")
					local size = px(24)
					local logoWidth = math.Round(size * titleLogo.width / titleLogo.height)
					local x = (w - (logoWidth + px(8) + theme.textSize(spec.title, font))) / 2
					local material, readyAt = images.image(titleLogo.url, titleLogo.id)
					if material ~= nil then
						surface.SetMaterial(material)
						surface.SetDrawColor(255, 255, 255, 255 * images.fadeIn(readyAt))
						surface.DrawTexturedRect(math.Round(x), math.Round((h - size) / 2), logoWidth, size)
					end
					draw.SimpleText(spec.title, font, x + logoWidth + px(8), (h - theme.fontHeight(font)) / 2, colors.text)
				end))
			else
				add(heading(content.panel, spec.title, "center"))
			end
			methodError = nil

			-- Each row's dark runs as { first column, length }: one rectangle per run.
			local grid = spec.grid
			local runs: { row: number; col: number; len: number }[] = {}
			for row = 0, grid.size - 1 do
				local start: number | nil = nil
				for col = 0, grid.size do
					local dark = col < grid.size and string.byte(grid.modules, row * grid.size + col + 1) == 49
					if dark and start == nil then
						start = col
					elseif not dark and start ~= nil then
						table.insert(runs, { row = row, col = start, len = col - start })
						start = nil
					end
				end
			end
			-- Whole pixels per module keep the code sharp; four modules of quiet zone around it.
			local cells = grid.size + 8
			local module = math.max(math.floor(px(240) / cells), 2)
			local side = module * cells
			add(widgets.painted(content.panel, side, function(w: number, h: number)
				local x = math.floor((w - side) / 2)
				-- Black on white in every scheme: banking apps read it best.
				theme.box(px(12), x, 0, side, side, color_white)
				surface.SetDrawColor(0, 0, 0, 255)
				for _, run in ipairs(runs) do
					surface.DrawRect(x + (run.col + 4) * module, (run.row + 4) * module, run.len * module, module)
				end
			end))

			add(widgets.text(content.panel, {
				text = spec.text,
				font = theme.font("body"),
				color = colors.muted,
				lineHeight = 20,
				align = "center",
			}))

			-- "Ждём оплаты…", or why a way to pay didn't open.
			local status = widgets.blankPanel(content.panel)
			local errorOptions: DonatosUiTextOptions = { text = "", font = theme.font("small"), color = colors.danger, lineHeight = 18, align = "center" }
			local errorLine = widgets.text(status, errorOptions)
			local waitingLine = widgets.painted(status, px(20), function(w: number, h: number)
				local font = theme.font("small")
				local label = "Ждём оплаты…"
				local radius = px(7)
				local width = radius * 2 + px(8) + theme.textSize(label, font)
				local x = (w - width) / 2
				theme.spinner(x + radius, h / 2, radius, colors.muted)
				draw.SimpleText(label, font, x + radius * 2 + px(8), (h - theme.fontHeight(font)) / 2, colors.muted)
			end)
			add({
				panel = status,
				layout = function(width: number): number
					local message = methodError
					errorLine.panel:SetVisible(message ~= nil)
					waitingLine.panel:SetVisible(message == nil)
					local line = waitingLine
					if message ~= nil then
						errorOptions.text = message
						line = errorLine
					end
					local h = line.layout(width)
					line.panel:SetPos(0, 0)
					line.panel:SetSize(width, h)
					return h
				end,
			})

			if spec.methods then
				-- The other ways to pay, as the API lists them: two to a row, an odd last one alone.
				local entries: { method: DonatosPaymentMethod; options: DonatosUiButton; button: DButton }[] = {}
				local holder = widgets.blankPanel(content.panel)
				local function open(method: DonatosPaymentMethod, options: DonatosUiButton)
					local direct = method.url
					if direct ~= nil then
						gui.OpenURL(direct)
						return
					end
					local id = orderId
					if id == nil then
						return
					end
					for _, entry in ipairs(entries) do
						if entry.options.pending then
							return
						end
					end
					methodError = nil
					options.pending = true
					relayout()
					netMessage.toServer("paymentMethodLink", { orderId = id, method = method.id }, function(result)
						options.pending = false
						-- Closed or moved on meanwhile.
						if not IsValid(box) or body == nil or body.panel ~= content.panel then
							return
						end
						if not result.success then
							methodError = result.error ~= "" and result.error or "Не удалось открыть этот способ оплаты"
							relayout()
							return
						end
						-- What the method shows is the API's to say.
						local screen = result.data
						local qr = screen.qr
						if qr ~= nil then
							setBody(qrBlock({ title = screen.title, text = screen.text, grid = qr, methods = false }))
						else
							gui.OpenURL(screen.url)
						end
					end)
				end
				for _, method in ipairs(paymentMethods) do
					local options = methodButton(method)
					options.onClick = function()
						open(method, options)
					end
					table.insert(entries, { method = method, options = options, button = widgets.button(holder, options) })
				end
				add({
					panel = holder,
					layout = function(width: number): number
						local gap = px(8)
						local half = math.floor((width - gap) / 2)
						local y = 0
						for i, entry in ipairs(entries) do
							local h = entry.button:GetTall()
							local alone = i == #entries and i % 2 == 1
							entry.button:SetPos(i % 2 == 0 and width - half or 0, y)
							entry.button:SetSize(alone and width or half, h)
							if i % 2 == 0 or alone then
								y = y + h + (i < #entries and gap or 0)
							end
						end
						return y
					end,
				})
				add(widgets.column(content.panel, px(8), {
					widgets.button(content.panel, { label = "Закрыть", variant = "ghost", onClick = ctx.dialogs.close }),
				}))
			else
				add(widgets.column(content.panel, px(8), {
					widgets.button(content.panel, {
						label = "Другие способы оплаты",
						variant = "secondary",
						onClick = function()
							local sbp = sbpGrid
							if sbp ~= nil then
								setBody(qrBlock(sbpSpec(sbp)))
							end
						end,
					}),
					widgets.button(content.panel, { label = "Закрыть", variant = "ghost", onClick = ctx.dialogs.close }),
				}))
			end
			awaitBalance(content.panel)
			return content
		end

		------------------------------------------------------------------ form

		local function formBlock(): DonatosUiBlock
			local content, add = widgets.stack(box, px(20), px(20))
			-- The title, and the balance under it while it is known.
			add(widgets.painted(content.panel, balance() ~= nil and px(48) or px(26), function(w: number, h: number)
				local titleFont = theme.font("section")
				draw.SimpleText("Пополнение баланса", titleFont, 0, (px(26) - theme.fontHeight(titleFont)) / 2, colors.text)
				local current = balance()
				if current ~= nil then
					local font = theme.font("small")
					draw.SimpleText(`На балансе ${formatNumber(current)} ${bonuses(current)}`, font, 0, px(28) + (px(20) - theme.fontHeight(font)) / 2, colors.muted)
				end
			end))

			local form = widgets.blankPanel(content.panel)
			local function caption(label: string): DonatosUiBlock
				return widgets.painted(form, px(20), function(w: number, h: number)
					local font = theme.font("smallMedium")
					draw.SimpleText(label, font, 0, (h - theme.fontHeight(font)) / 2, colors.textSoft)
				end)
			end

			-- Amount: a field with the limits beside its caption (red while the amount is outside
			-- them), and quick amounts under it.
			local amountCaption = widgets.painted(form, px(20), function(w: number, h: number)
				local font = theme.font("smallMedium")
				draw.SimpleText("Сумма", font, 0, (h - theme.fontHeight(font)) / 2, colors.textSoft)
				local small = theme.font("small")
				local limits = `от ${method == "igs" and 1 or formatNumber(TOP_UP_MIN)} до ${formatNumber(TOP_UP_MAX)}`
				draw.SimpleText(limits, small, w, (h - theme.fontHeight(small)) / 2, amountValid() and colors.muted or colors.danger, TEXT_ALIGN_RIGHT)
			end)
			local field, entry = widgets.textEntry(form, "Сумма", true)
			entry:SetFont(theme.font("cardTitle"))
			if amount ~= nil then
				entry:SetValue(tostring(amount))
			end
			-- "бонусов" inside the field's right end, agreeing with the amount.
			local paintField = field.Paint as (self: Panel, w: number, h: number) => boolean
			field.Paint = function(self: Panel, w: number, h: number): boolean
				paintField(self, w, h)
				local value = amount
				draw.SimpleText(value ~= nil and bonuses(value) or "бонусов", theme.font("body"), w - px(14), h / 2, colors.muted, TEXT_ALIGN_RIGHT, TEXT_ALIGN_CENTER)
				return true
			end
			field.PerformLayout = function(self: Panel, w: number, h: number)
				entry:SetPos(px(14), 0)
				entry:SetSize(w - px(14) - px(84), h)
			end
			local quick: DonatosUiButton[] = {}
			local quickButtons: DButton[] = {}
			local function syncQuick()
				for i, options in ipairs(quick) do
					options.variant = amount == TOP_UP_AMOUNTS[i] and "soft" or "secondary"
				end
			end
			local function clearError()
				if errorText ~= nil then
					errorText = nil
					relayout()
				end
			end
			for _, value in ipairs(TOP_UP_AMOUNTS) do
				local options: DonatosUiButton = { label = formatNumber(value), size = "sm" }
				options.onClick = function()
					amount = value
					entry:SetValue(tostring(value))
					syncQuick()
					clearError()
				end
				table.insert(quick, options)
				table.insert(quickButtons, widgets.button(form, options))
			end
			syncQuick()
			entry.OnChange = function(self: DTextEntry)
				-- Digits only, and few enough that no amount shows as "1e+20".
				local text = self:GetValue()
				amount = (string.match(text, "^%d+$") ~= nil and #text <= 9) and tonumber(text) or nil
				syncQuick()
				clearError()
			end

			-- Method, when gm-donate is enabled: the pay page or gm-donate, with its notice.
			local methodCaption: DonatosUiBlock | nil = nil
			local methodButtons: DButton[] = {}
			local notice: DonatosUiBlock | nil = nil
			if igs then
				methodCaption = caption("Способ оплаты")
				local methods: { method: TopUpMethod; options: DonatosUiButton }[] = {
					{ method = "donatos", options = { label = "Карта / СБП", icon = "card" } },
					{ method = "igs", options = { label = "Другое", icon = "wallet" } },
				}
				local function syncMethods()
					for _, spec in ipairs(methods) do
						spec.options.variant = spec.method == method and "soft" or "secondary"
					end
				end
				for _, spec in ipairs(methods) do
					spec.options.onClick = function()
						method = spec.method
						errorText = nil
						syncMethods()
						relayout()
					end
					table.insert(methodButtons, widgets.button(form, spec.options))
				end
				syncMethods()
				notice = widgets.text(form, { text = IGS_NOTICE, font = theme.font("small"), color = colors.muted, lineHeight = 18 })
			end

			-- Our orders: the receipt email (the remembered one, or a field and "remember") and
			-- the terms, as on the pay page.
			local receiptCaption = caption("Почта для чека")
			local emailField, emailEntry = widgets.textEntry(form, "name@example.com", false)
			emailEntry:SetValue(email)
			emailEntry.OnChange = function(self: DTextEntry)
				email = string.Trim(self:GetValue())
				clearError()
			end
			local rememberBox = widgets.checkbox(form, {
				on = rememberEmail,
				label = "Запомнить почту",
				onChange = function(on: boolean)
					rememberEmail = on
				end,
			})
			local rememberedLine = widgets.painted(form, px(36), function(w: number, h: number)
				local font = theme.font("body")
				local prefix = "Чек придёт на "
				local y = (h - theme.fontHeight(font)) / 2
				draw.SimpleText(prefix, font, 0, y, colors.muted)
				draw.SimpleText(rememberedEmail or "", font, theme.textSize(prefix, font), y, colors.text)
			end)
			local changeEmail = widgets.button(form, {
				label = "Изменить",
				size = "sm",
				variant = "ghost",
				onClick = function()
					editingEmail = true
					relayout()
					emailEntry:RequestFocus()
				end,
			})
			local termsBox = widgets.checkbox(form, {
				on = agreed,
				label = "Я соглашаюсь с условиями и политикой конфиденциальности",
				links = site ~= nil and {
					{ text = "условиями", url = `${site}/legal/tos` },
					{ text = "политикой конфиденциальности", url = `${site}/legal/privacy-policy` },
				} or nil,
				onChange = function(on: boolean)
					agreed = on
				end,
			})

			-- What the balance comes to; the line is left out while the balance is unknown.
			local summary: DonatosUiBlock | nil = nil
			if balance() ~= nil then
				summary = widgets.painted(form, px(20), function(w: number, h: number)
					local current = balance()
					local value = amount
					if current == nil or value == nil or not amountValid() then
						return
					end
					local font = theme.font("body")
					local y = (h - theme.fontHeight(font)) / 2
					draw.SimpleText("Баланс после пополнения", font, 0, y, colors.muted)
					draw.SimpleText(`${formatNumber(current + value)} ${bonuses(current + value)}`, theme.font("medium"), w, y, colors.text, TEXT_ALIGN_RIGHT)
				end)
			end

			local separator = widgets.blankPanel(form)
			separator.Paint = function(self: Panel, w: number, h: number): boolean
				surface.SetDrawColor(colors.separator)
				surface.DrawRect(0, 0, w, h)
				return true
			end
			separator:SetVisible(summary ~= nil)

			local errorOptions: DonatosUiTextOptions = { text = "", font = theme.font("small"), color = colors.danger, lineHeight = 18 }
			local errorBlock = widgets.text(form, errorOptions)

			add({
				panel = form,
				layout = function(width: number): number
					local y = 0
					local function place(block: DonatosUiBlock, gapAfter: number)
						local h = block.layout(width)
						block.panel:SetPos(0, y)
						block.panel:SetSize(width, h)
						y = y + h + gapAfter
					end
					place(amountCaption, px(8))
					field:SetPos(0, y)
					field:SetSize(width, px(44))
					y = y + px(44) + px(8)
					local gap = px(8)
					local cell = (width - gap * (#quickButtons - 1)) / #quickButtons
					for i, btn in ipairs(quickButtons) do
						btn:SetPos(math.floor((i - 1) * (cell + gap)), y)
						btn:SetSize(math.floor(cell), px(32))
					end
					y = y + px(32)

					local captionBlock = methodCaption
					if captionBlock ~= nil then
						y = y + px(20)
						place(captionBlock, px(8))
						local half = (width - gap) / 2
						for i, btn in ipairs(methodButtons) do
							btn:SetPos(math.floor((i - 1) * (half + gap)), y)
							btn:SetSize(math.floor(half), px(36))
						end
						y = y + px(36)
					end
					local noticeBlock = notice
					if noticeBlock ~= nil then
						noticeBlock.panel:SetVisible(method == "igs")
						if method == "igs" then
							y = y + px(8)
							place(noticeBlock, 0)
						end
					end

					local ours = method == "donatos"
					receiptCaption.panel:SetVisible(ours)
					emailField:SetVisible(ours and editingEmail)
					rememberBox.panel:SetVisible(ours and editingEmail)
					rememberedLine.panel:SetVisible(ours and not editingEmail)
					changeEmail:SetVisible(ours and not editingEmail)
					termsBox.panel:SetVisible(ours)
					if ours then
						y = y + px(20)
						place(receiptCaption, px(8))
						if editingEmail then
							emailField:SetPos(0, y)
							emailField:SetSize(width, px(36))
							y = y + px(36) + px(10)
							place(rememberBox, 0)
						else
							local changeWidth = changeEmail:GetWide()
							changeEmail:SetPos(width - changeWidth, y + (px(36) - changeEmail:GetTall()) / 2)
							rememberedLine.panel:SetPos(0, y)
							rememberedLine.panel:SetSize(width - changeWidth - px(8), px(36))
							y = y + px(36)
						end
						y = y + px(14)
						place(termsBox, 0)
					end

					local summaryBlock = summary
					if summaryBlock ~= nil then
						-- Set off from the form by a rule.
						y = y + px(20)
						separator:SetPos(0, y)
						separator:SetSize(width, math.max(px(1), 1))
						y = y + px(16)
						place(summaryBlock, 0)
					end
					local message = errorText
					errorBlock.panel:SetVisible(message ~= nil)
					if message ~= nil then
						errorOptions.text = message
						y = y + px(8)
						place(errorBlock, 0)
					end
					return y
				end,
			})

			local cancel: DonatosUiButton = { label = "Отмена", variant = "secondary", onClick = ctx.dialogs.close }
			local proceed: DonatosUiButton = { label = "Оплатить" }
			local footer = widgets.blankPanel(content.panel)
			local cancelButton = widgets.button(footer, cancel)
			local proceedButton = widgets.button(footer, proceed)
			proceedButton.Think = function(self: DButton)
				proceed.disabled = not valid()
				-- Our bonuses are a ruble each; gm-donate prices its own.
				local value = amount
				if method == "igs" then
					proceed.label = "Перейти к оплате"
				else
					proceed.label = value ~= nil and amountValid() and `Оплатить ${formatNumber(value)} ₽` or "Оплатить"
				end
			end
			proceed.onClick = function()
				local value = amount
				if value == nil or not valid() then
					return
				end
				errorText = nil
				proceed.pending = true
				cancel.disabled = true
				relayout()
				-- False when closed while the order or link was being made: the player changed their mind.
				local function settled(): boolean
					proceed.pending = false
					cancel.disabled = false
					return IsValid(box) and body ~= nil and body.panel == content.panel
				end
				local function failed(message: string, fallback: string)
					errorText = message ~= "" and message or fallback
					relayout()
				end
				if method == "donatos" then
					netMessage.toServer("createOrder", {
						amount = value,
						email = editingEmail and email or nil,
						rememberEmail = editingEmail and rememberEmail,
					}, function(result)
						if not settled() then
							return
						end
						if not result.success then
							failed(result.error, "Не удалось создать заказ")
							return
						end
						payUrl = result.data.payUrl
						orderId = result.data.orderId
						paymentMethods = result.data.methods
						local sbp = result.data.sbp
						if sbp ~= nil then
							errorText = nil
							waitingFrom = balance()
							sbpGrid = sbp
							setBody(qrBlock(sbpSpec(sbp)))
						else
							gui.OpenURL(result.data.payUrl)
							wait()
						end
					end)
					return
				end
				netMessage.toServer("createIgsPaymentUrl", { sum = value }, function(result)
					if not settled() then
						return
					end
					if result.success then
						payUrl = result.data.url
						gui.OpenURL(result.data.url)
						wait()
					else
						failed(result.error, "Не удалось создать ссылку на оплату")
					end
				end)
			end
			-- "Отмена" as wide as its label, the payment taking the rest.
			add({
				panel = footer,
				layout = function(width: number): number
					local h = proceedButton:GetTall()
					local cancelWidth = cancelButton:GetWide()
					cancelButton:SetPos(0, 0)
					proceedButton:SetPos(cancelWidth + px(8), 0)
					proceedButton:SetSize(width - cancelWidth - px(8), h)
					return h
				end,
			})
			return content
		end

		body = formBlock()

		return {
			panel = box,
			place = function(areaWidth: number, areaHeight: number)
				local w = math.min(px(440), areaWidth - px(32))
				local h = 0
				local current = body
				if current ~= nil then
					h = current.layout(w)
					current.panel:SetPos(0, 0)
					current.panel:SetSize(w, h)
				end
				box:SetSize(w, h)
				box:SetPos((areaWidth - w) / 2, math.max((areaHeight - h) / 2, px(16)))
			end,
		}
	end, true)
end

------------------------------------------------------------------------------ page parts

interface DonatosEmptyState {
	icon: DonatosIcon;
	title: string;
	text?: string;
	action?: DonatosUiButton;
}

-- A centred icon, title, line of text and optional button, filling `parent`.
local function emptyState(parent: Panel, spec: DonatosEmptyState): Panel
	local panel = widgets.blankPanel(parent)
	local content, add = widgets.stack(panel, px(12))
	add(widgets.painted(content.panel, px(48), function(w: number, h: number)
		local size = px(48)
		local x = (w - size) / 2
		theme.box(size / 2, x, 0, size, size, colors.default)
		theme.icon(spec.icon, x + (size - px(20)) / 2, (size - px(20)) / 2, px(20), colors.muted)
	end))
	add(widgets.text(content.panel, { text = spec.title, font = theme.font("cardTitle"), color = colors.text, align = "center" }))
	if spec.text ~= nil then
		add(widgets.text(content.panel, { text = spec.text, font = theme.font("body"), color = colors.muted, lineHeight = 20, align = "center" }))
	end
	if spec.action ~= nil then
		local btn = widgets.button(content.panel, spec.action)
		local actionRow = widgets.blankPanel(content.panel)
		btn:SetParent(actionRow)
		add({
			panel = actionRow,
			layout = function(width: number): number
				btn:SetPos((width - btn:GetWide()) / 2, px(4))
				return btn:GetTall() + px(4)
			end,
		})
	end
	panel.PerformLayout = function(self: Panel, w: number, h: number)
		local width = math.min(px(340), w)
		local height = content.layout(width)
		content.panel:SetSize(width, height)
		content.panel:SetPos((w - width) / 2, math.max((h - height) / 2, 0))
	end
	return panel
end

local function loading(parent: Panel): Panel
	local panel = widgets.blankPanel(parent)
	panel.Paint = function(self: Panel, w: number, h: number): boolean
		theme.spinner(w / 2, h / 2, px(10), colors.muted)
		return true
	end
	return panel
end

return {
	formatNumber = formatNumber,
	formatDays = formatDays,
	formatTerm = formatTerm,
	formatDaysLong = formatDaysLong,
	durationColors = durationColors,
	durationIcon = durationIcon,
	plural = plural,
	bonuses = bonuses,
	bonusesGenitive = bonusesGenitive,
	formatRemaining = formatRemaining,
	unavailableText = unavailableText,
	lower = lower,
	showError = showError,
	cancelAction = cancelAction,
	topUp = topUp,
	emptyState = emptyState,
	loading = loading,
}
