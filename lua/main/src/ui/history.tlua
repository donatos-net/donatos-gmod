-- Client: «История», the player's balance history: «Оплачено всего», then the operations
-- grouped by day, newest first, a page of the API's entries at a time.

local netMessage = require("donatos.net")
local theme = require("ui.theme")
local views = require("ui.views")
local widgets = require("ui.widgets")

local colors = theme.colors
local px = theme.px

------------------------------------------------------------------------------ cache

-- The loaded pages. The menu state has no place for them, so they live here, for one
-- player; any change to the balance starts them over, as every entry moves it.
local type HistoryCache = {
	playerId: number;
	balance: number;
	-- nil until the first page arrives.
	entries: DonatosHistoryEntry[] | nil;
	nextCursor: number | nil;
	-- Rubles paid, from the newest page; nil from an API without it.
	ordersTotal: number | nil;
	loading: boolean;
	-- The last request's error, and its cursor for «Повторить».
	error: string | nil;
	failedCursor: number | nil;
}

local history: HistoryCache | nil = nil

-- The page's body while it is on screen, so a reply re-renders only while it is.
local livePage: Panel | nil = nil

-- Requests the page after `cursor` (the newest page when nil) and re-renders when it lands.
-- A reply for a cache that has since been replaced is dropped.
local function fetch(ctx: DonatosMenuContext, cache: HistoryCache, cursor: number | nil)
	cache.loading = true
	cache.error = nil
	netMessage.toServer("getHistory", { cursor = cursor }, function(result)
		if history ~= cache then
			return
		end
		cache.loading = false
		if result.success then
			local entries: DonatosHistoryEntry[] = cursor ~= nil and cache.entries or {}
			for _, entry in ipairs(result.data.entries) do
				table.insert(entries, entry)
			end
			cache.entries = entries
			cache.nextCursor = result.data.nextCursor
			if cursor == nil then
				local summary = result.data.summary
				cache.ordersTotal = summary and summary.ordersTotal
			end
		else
			cache.error = result.error ~= "" and result.error or "Не удалось загрузить историю"
			cache.failedCursor = cursor
		end
		local page = livePage
		if page ~= nil and IsValid(page) then
			ctx.rerender()
		end
	end)
end

-- The player's cache, refetching the newest page for another player or a changed balance.
-- The old entries stay on screen until the new page replaces them.
local function cacheFor(ctx: DonatosMenuContext, data: NonNullable<DonatosRemoteData>): HistoryCache
	local player = data.player
	local cache = history
	if cache ~= nil and cache.playerId == player.id and cache.balance == player.balance then
		return cache
	end
	local fresh: HistoryCache = {
		playerId = player.id,
		balance = player.balance,
		entries = cache ~= nil and cache.playerId == player.id and cache.entries or nil,
		nextCursor = nil,
		ordersTotal = cache ~= nil and cache.playerId == player.id and cache.ordersTotal or nil,
		loading = false,
		error = nil,
		failedCursor = nil,
	}
	history = fresh
	fetch(ctx, fresh, nil)
	return fresh
end

local type HistoryLine = { createdAt: number; delta: number; kind: string; title: string }

-- A purchase paid partly from free and partly from paid bonuses comes as two adjacent
-- entries with the same time, kind and description: they make one line.
local function historyLines(entries: DonatosHistoryEntry[]): HistoryLine[]
	local lines: HistoryLine[] = {}
	local previous: DonatosHistoryEntry | nil = nil
	local last: HistoryLine | nil = nil
	for _, entry in ipairs(entries) do
		if previous ~= nil and last ~= nil
			and previous.createdAt == entry.createdAt
			and previous.kind == entry.kind
			and previous.description == entry.description
		then
			last.delta = last.delta + entry.delta
		else
			local title = entry.title ~= nil and entry.title ~= "" and entry.title or entry.description
			last = { createdAt = entry.createdAt, delta = entry.delta, kind = entry.kind, title = title ~= "" and title or "Операция" }
			table.insert(lines, last)
		end
		previous = entry
	end
	return lines
end

------------------------------------------------------------------------------ formatting

local MONTHS: string[] = { "января", "февраля", "марта", "апреля", "мая", "июня", "июля", "августа", "сентября", "октября", "ноября", "декабря" }

-- A day's heading: "Сегодня", "Вчера", "6 февраля"; the year only when it is not this one.
local function dayTitle(time: number): string
	local day = os.date("%Y-%m-%d", time)
	local now = os.time()
	if day == os.date("%Y-%m-%d", now) then
		return "Сегодня"
	elseif day == os.date("%Y-%m-%d", now - 86400) then
		return "Вчера"
	end
	local date = os.date("*t", time)
	local year = date.year ~= os.date("*t", now).year and ` ${date.year}` or ""
	return `${date.day} ${MONTHS[date.month] or ""}${year}`
end

-- "+500", "−200" (a real minus sign), "0".
local function formatDelta(delta: number): string
	if delta < 0 then
		return `−${views.formatNumber(-delta)}`
	elseif delta > 0 then
		return `+${views.formatNumber(delta)}`
	end
	return "0"
end

local type KindLook = { icon: DonatosIcon; label: string }

-- Each ledger kind's icon and the short label under the line's title.
local KINDS: Table<string, KindLook> = {
	purchase_bonus = { icon = "plus", label = "Пополнение" },
	spend_bonus = { icon = "bag", label = "Покупка" },
	refund_item = { icon = "undo", label = "Возврат за предмет" },
	refund_bonus_purchase = { icon = "undo", label = "Возврат по заказу" },
	chargeback_bonus_purchase = { icon = "undo", label = "Отмена платежа" },
	admin_grant = { icon = "shield", label = "Администратор" },
	purchase_bonus_reward = { icon = "gift", label = "Подарочные бонусы" },
	refund_purchase_bonus_reward = { icon = "undo", label = "Возврат подарочных бонусов" },
	system_adjustment = { icon = "wallet", label = "Перенос баланса" },
}
local OTHER_KIND: KindLook = { icon = "wallet", label = "Операция" }

------------------------------------------------------------------------------ list

local CARD_RADIUS = 16
local ROW_HEIGHT = 60
local ROW_PAD = 16
local ICON_BOX = 36

-- One operation: the kind's icon in a circle, the title over "Покупка · 17:56", the amount.
local function historyRow(parent: Panel, line: HistoryLine, first: boolean, last: boolean): DonatosUiBlock
	local panel = widgets.blankPanel(parent)
	local hover = theme.tween(0)
	local kind = KINDS[line.kind] or OTHER_KIND
	local subtitle = `${kind.label} · ${os.date("%H:%M", line.createdAt)}`
	local amount = formatDelta(line.delta)
	local amountColor = line.delta > 0 and colors.success or colors.text
	local titleFont = theme.font("medium")
	local smallFont = theme.font("small")
	local title = ""

	panel.Paint = function(self: Panel, w: number, h: number): boolean
		hover.to(self:IsHovered() and 1 or 0, 0.15, "smooth")
		local fill = theme.mix(colors.surface, colors.surfaceHover, hover.value()) or colors.surface
		theme.box(px(CARD_RADIUS), 0, 0, w, h, fill, first, first, last, last)
		local box = px(ICON_BOX)
		local x, top = px(ROW_PAD), math.Round((h - box) / 2)
		theme.box(box / 2, x, top, box, box, colors.default)
		theme.icon(kind.icon, x + box * 0.25, top + box * 0.25, box * 0.5, colors.textSoft)
		local textX = x + box + px(12)
		if not last then
			-- Under the text only.
			surface.SetDrawColor(colors.separator)
			surface.DrawRect(textX, h - 1, w - textX, 1)
		end
		draw.SimpleText(title, titleFont, textX, h / 2 - px(1), colors.text, TEXT_ALIGN_LEFT, TEXT_ALIGN_BOTTOM)
		draw.SimpleText(subtitle, smallFont, textX, h / 2 + px(2), colors.muted, TEXT_ALIGN_LEFT, TEXT_ALIGN_TOP)
		draw.SimpleText(amount, titleFont, w - px(ROW_PAD), h / 2, amountColor, TEXT_ALIGN_RIGHT, TEXT_ALIGN_CENTER)
		return true
	end

	return {
		panel = panel,
		layout = function(width: number): number
			local textX = px(ROW_PAD) + px(ICON_BOX) + px(12)
			local amountWidth = theme.textSize(amount, titleFont) + px(24)
			title = theme.clamp(line.title, titleFont, math.max(width - textX - px(ROW_PAD) - amountWidth, px(40)), 1)[1] or ""
			return px(ROW_HEIGHT)
		end,
	}
end

-- One day's operations in a card.
local function dayCard(parent: Panel, lines: HistoryLine[]): DonatosUiBlock
	local panel = widgets.blankPanel(parent)
	local rows: DonatosUiBlock[] = {}
	for i, line in ipairs(lines) do
		table.insert(rows, historyRow(panel, line, i == 1, i == #lines))
	end
	return {
		panel = panel,
		layout = function(width: number): number
			local y = 0
			for _, row in ipairs(rows) do
				local h = row.layout(width)
				row.panel:SetPos(0, y)
				row.panel:SetSize(width, h)
				y = y + h
			end
			return y
		end,
	}
end

local type HistoryDay = { title: string; lines: HistoryLine[] }

-- The lines split into days, in order.
local function byDay(lines: HistoryLine[]): HistoryDay[]
	local days: HistoryDay[] = {}
	local current: HistoryDay | nil = nil
	for _, line in ipairs(lines) do
		local title = dayTitle(line.createdAt)
		if current == nil or current.title ~= title then
			current = { title = title, lines = {} }
			table.insert(days, current)
		end
		table.insert(current.lines, line)
	end
	return days
end

local function dayHeading(parent: Panel, title: string): DonatosUiBlock
	return widgets.painted(parent, px(28), function(w: number, h: number)
		draw.SimpleText(title, theme.font("smallMedium"), px(4), h - px(4), colors.muted, TEXT_ALIGN_LEFT, TEXT_ALIGN_BOTTOM)
	end)
end

-- «Оплачено всего»: the rubles the player has paid in successful orders (as the dashboard
-- counts them), in a card above the days.
local function summaryCard(parent: Panel, ordersTotal: number): DonatosUiBlock
	local value = views.formatNumber(ordersTotal)
	local unit = "₽"
	return widgets.painted(parent, px(76), function(w: number, h: number)
		local cardWidth = math.min(w, px(320))
		theme.box(px(CARD_RADIUS), 0, 0, cardWidth, h, colors.surface)
		local box = px(44)
		local x, top = px(ROW_PAD), math.Round((h - box) / 2)
		theme.box(box / 2, x, top, box, box, colors.accentSoft)
		theme.icon("wallet", x + box * 0.25, top + box * 0.25, box * 0.5, colors.accentText)
		local textX = x + box + px(14)
		local priceFont = theme.font("price")
		local unitFont = theme.font("smallMedium")
		draw.SimpleText("Оплачено всего", theme.font("small"), textX, h / 2 - px(1), colors.muted, TEXT_ALIGN_LEFT, TEXT_ALIGN_BOTTOM)
		local valueY = h / 2 + px(1)
		draw.SimpleText(value, priceFont, textX, valueY, colors.text)
		draw.SimpleText(unit, unitFont, textX + theme.textSize(value, priceFont) + px(5), theme.baseline(valueY, priceFont, unitFont), colors.muted)
	end)
end

------------------------------------------------------------------------------ status

-- A line of text under the list (after a spinner while `spinning`), with an optional
-- button at its right end.
local function note(parent: Panel, message: string, color: Color, spinning: boolean, action: DonatosUiButton | nil): DonatosUiBlock
	local panel = widgets.blankPanel(parent)
	local btn: DButton | nil = nil
	if action ~= nil then
		btn = widgets.button(panel, action)
	end
	local font = theme.font("small")
	local shown = message

	panel.Paint = function(self: Panel, w: number, h: number): boolean
		local x = px(ROW_PAD)
		if spinning then
			theme.spinner(x + px(6), h / 2, px(6), colors.muted)
			x = x + px(20)
		end
		draw.SimpleText(shown, font, x, h / 2, color, TEXT_ALIGN_LEFT, TEXT_ALIGN_CENTER)
		return true
	end

	return {
		panel = panel,
		layout = function(width: number): number
			local h = px(44)
			local right = width - px(ROW_PAD)
			local actionButton = btn
			if actionButton ~= nil then
				right = right - actionButton:GetWide()
				actionButton:SetPos(right, (h - actionButton:GetTall()) / 2)
				right = right - px(12)
			end
			shown = theme.clamp(message, font, math.max(right - px(ROW_PAD) - px(20), px(40)), 1)[1] or ""
			return h
		end,
	}
end

-- «Показать ещё», centred.
local function more(parent: Panel, action: DonatosUiButton): DonatosUiBlock
	local panel = widgets.blankPanel(parent)
	local btn = widgets.button(panel, action)
	return {
		panel = panel,
		layout = function(width: number): number
			btn:SetPos((width - btn:GetWide()) / 2, 0)
			return btn:GetTall()
		end,
	}
end

-- What goes under the list: the error, the first page loading, or «Показать ещё».
local function status(parent: Panel, ctx: DonatosMenuContext, cache: HistoryCache, lines: HistoryLine[] | nil): DonatosUiBlock | nil
	local errorText = cache.error
	if errorText ~= nil then
		local failedCursor = cache.failedCursor
		return note(parent, errorText, colors.danger, false, {
			label = "Повторить",
			variant = "secondary",
			size = "sm",
			onClick = function()
				fetch(ctx, cache, failedCursor)
				ctx.rerender()
			end,
		})
	elseif lines == nil then
		return note(parent, "Загружаем историю...", colors.muted, true, nil)
	end
	local cursor = cache.nextCursor
	if cursor ~= nil then
		return more(parent, {
			label = "Показать ещё",
			variant = "secondary",
			size = "sm",
			pending = cache.loading,
			onClick = function()
				if cache.loading then
					return
				end
				fetch(ctx, cache, cursor)
				ctx.rerender()
			end,
		})
	end
	return nil
end

------------------------------------------------------------------------------ page

local function emptyHistory(parent: Panel): Panel
	return views.emptyState(parent, {
		icon = "clock",
		title = "Пока нет операций",
		text = "Здесь появятся пополнения, покупки и возвраты бонусов.",
	})
end

local function page(parent: Panel, ctx: DonatosMenuContext): () => DonatosUiScroll | nil
	local body = widgets.blankPanel(parent)
	body:Dock(FILL)
	local area: DonatosUiScroll | nil = nil
	livePage = body

	local data = ctx.data()
	if not ctx.loaded() then
		views.loading(body):Dock(FILL)
	elseif data == nil then
		emptyHistory(body):Dock(FILL)
	else
		local cache = cacheFor(ctx, data)
		local entries = cache.entries
		local lines = entries and historyLines(entries)
		if lines ~= nil and #lines == 0 and cache.error == nil then
			emptyHistory(body):Dock(FILL)
		else
			local scrollArea = widgets.scroll(body, function(canvas: Panel): DonatosUiBlock
				local content, add = widgets.stack(canvas, px(8), px(24), px(20))
				local ordersTotal = cache.ordersTotal
				if ordersTotal ~= nil then
					add(summaryCard(content.panel, ordersTotal))
				end
				if lines ~= nil then
					for _, day in ipairs(byDay(lines)) do
						add(dayHeading(content.panel, day.title))
						add(dayCard(content.panel, day.lines))
					end
				end
				local below = status(content.panel, ctx, cache, lines)
				if below ~= nil then
					add(below)
				end
				-- Room below the last block.
				add(widgets.painted(content.panel, px(4), function() end))
				return content
			end)
			scrollArea.panel:Dock(FILL)
			area = scrollArea
		end
	end

	return function(): DonatosUiScroll | nil
		return area
	end
end

return {
	history = page,
}
