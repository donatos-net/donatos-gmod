-- Client: goods images and payment logos, downloaded on first use and kept in data/donatos/img/,
-- saved by the API's id for the file. An id names one content for good (by its hash), so a saved
-- file never goes stale: later sessions load it from disk without asking the network. A client
-- that can't reach the site gets the image by its id through the server
-- (`donatos.image-relay`). Until an image is ready (and for good, if it can't be had) there is
-- no material, and the menu draws as it would without images.

local relay = require("donatos.image-relay")
local theme = require("ui.theme")

local DIRECTORY = "donatos/img"
-- Downloads at a time; the rest wait their turn.
local MAX_DOWNLOADS = 4
-- A download that hasn't answered by then counts as failed, so it can't hold a slot forever.
local DOWNLOAD_TIMEOUT = 30
-- Decoding an image stalls the frame, so a page full of saved images loads one per frame.
local LOADS_PER_FRAME = 1
local FADE_IN = 0.25

-- queued -> downloading -> saved -> ready, or failed (for the rest of the session).
local type ImageState = "queued" | "downloading" | "saved" | "ready" | "failed"

local type ImageEntry = {
	url: string;
	-- The API's id for the file, which the server can fetch it by.
	id: string;
	state: ImageState;
	-- Under data/.
	path: string;
	material?: IMaterial;
	-- RealTime() when the material became ready.
	readyAt: number;
}

local entries: Table<string, ImageEntry> = {}
local queue: string[] = {}
local downloading = 0
local loadFrame, loadsThisFrame = -1, 0

local function fail(entry: ImageEntry)
	entry.state = "failed"
	entry.material = nil
end

local pump: () => void = function() end

-- Set once a direct download has failed where the server's got through: the site is blocked
-- here, so the rest of the session goes through the server without waiting on it first.
local direct = true

-- Downloads `url` straight from the site; `done` gets an image's bytes, or nil.
local function fetchDirect(url: string, done: (body: string | nil) => void)
	local settled = false
	local function settle(body: string | nil)
		if settled then
			return
		end
		settled = true
		-- Only an image: a proxy's or captive portal's HTML page would otherwise be saved, and
		-- loaded, every session.
		done((body ~= nil and relay.isImage(body)) and body or nil)
	end
	timer.Simple(DOWNLOAD_TIMEOUT, function()
		settle(nil)
	end)
	local ok = pcall(http.Fetch, url, function(body: string, size: number, headers: table, code: number)
		settle((code == 200 and body ~= nil and #body > 0) and body or nil)
	end, function(reason: string)
		settle(nil)
	end)
	if not ok then
		settle(nil)
	end
end

local function download(entry: ImageEntry)
	local url, id = entry.url, entry.id
	entry.state = "downloading"
	downloading = downloading + 1
	local function settle(body: string | nil)
		downloading = downloading - 1
		if body ~= nil then
			file.CreateDir(DIRECTORY)
			file.Write(entry.path, body)
		end
		if body ~= nil and file.Exists(entry.path, "DATA") then
			entry.state = "saved"
		else
			fail(entry)
		end
		pump()
	end
	local function throughServer(failedDirect: boolean)
		relay.fetch(id, function(body: string | nil)
			if body ~= nil and failedDirect then
				direct = false
			end
			settle(body)
		end)
	end
	if not direct then
		throughServer(false)
		return
	end
	fetchDirect(url, function(body: string | nil)
		if body ~= nil then
			settle(body)
		else
			throughServer(true)
		end
	end)
end

pump = function()
	while downloading < MAX_DOWNLOADS and #queue > 0 do
		local key = table.remove(queue, 1) as string
		local entry = entries[key]
		if entry ~= nil and entry.state == "queued" then
			download(entry)
		end
	end
end

-- Turns a saved file into a material, unless this frame has decoded enough already.
local function load(entry: ImageEntry)
	local frame = FrameNumber()
	if frame ~= loadFrame then
		loadFrame, loadsThisFrame = frame, 0
	end
	if loadsThisFrame >= LOADS_PER_FRAME then
		return
	end
	loadsThisFrame = loadsThisFrame + 1
	-- Material() reads .jpg / .png files from data/ by this relative path.
	local material = Material(`../data/${entry.path}`, "smooth mips")
	-- A file that doesn't decode can still give a material, with the error texture in it.
	local texture = material ~= nil and material:GetTexture("$basetexture") or nil
	if material == nil or material:IsError() or texture == nil or texture:IsError() then
		-- A broken file is fetched again next session.
		file.Delete(entry.path)
		fail(entry)
		return
	end
	entry.material = material
	entry.state = "ready"
	entry.readyAt = RealTime()
end

-- The image at `url` (a JPEG, or a PNG when the URL ends in .png), and when it became ready;
-- nil until then. `id` is the API's id for the file. The first call starts loading it.
local function image(url: string, id: string): (IMaterial | nil, number)
	local entry = entries[id]
	if entry == nil then
		-- Material() picks the decoder by extension.
		local extension = string.EndsWith(url, ".png") and "png" or "jpg"
		local path = `${DIRECTORY}/${util.SHA256(id)}.${extension}`
		local saved = file.Exists(path, "DATA")
		entry = { url = url, id = id, state = saved and "saved" or "queued", path = path, readyAt = 0 }
		entries[id] = entry
		if not saved then
			table.insert(queue, id)
			pump()
		end
	end
	if entry.state == "saved" then
		load(entry)
	end
	return entry.material, entry.readyAt
end

-- How far an image that became ready at `readyAt` has faded in (0-1, eased).
local function fadeIn(readyAt: number): number
	local t = math.Clamp((RealTime() - readyAt) / FADE_IN, 0, 1)
	return 1 - (1 - t) ^ 3
end

-- UVs that show an `imageWidth` x `imageHeight` image over a `w` x `h` box like CSS
-- `object-fit: cover`: scaled to fill the box and cropped about the centre. GMod resamples a
-- .jpg / .png to a power-of-two texture, stretching it to fill, so UVs 0-1 span the whole image and
-- the aspect ratio comes from the image's own size, not the texture's.
local function cover(imageWidth: number, imageHeight: number, w: number, h: number): (number, number, number, number)
	if imageWidth <= 0 or imageHeight <= 0 or w <= 0 or h <= 0 then
		return 0, 0, 1, 1
	end
	local imageAspect = imageWidth / imageHeight
	local boxAspect = w / h
	if imageAspect > boxAspect then
		local inset = (1 - boxAspect / imageAspect) / 2
		return inset, 0, 1 - inset, 1
	end
	local inset = (1 - imageAspect / boxAspect) / 2
	return 0, inset, 1, 1 - inset
end

-- Where a `pictureWidth` x `pictureHeight` picture sits, whole and centred, in a `w` x `h`
-- area, like CSS `object-fit: contain`.
local function contain(pictureWidth: number, pictureHeight: number, w: number, h: number): (number, number, number, number)
	if pictureWidth <= 0 or pictureHeight <= 0 or w <= 0 or h <= 0 then
		return 0, 0, math.max(w, 0), math.max(h, 0)
	end
	local scale = math.min(w / pictureWidth, h / pictureHeight)
	local iw, ih = math.Round(pictureWidth * scale), math.Round(pictureHeight * scale)
	return math.Round((w - iw) / 2), math.Round((h - ih) / 2), iw, ih
end

-- Whether the image at `url` has transparency: those are stored as PNG, all others as JPEG.
local function transparent(url: string): boolean
	return string.EndsWith(url, ".png")
end

-- A transparent picture floats over a soft light behind it (on dark cards, where a dark
-- picture would sink into the card) and casts a soft shadow on the card below it.
-- The light's alpha is converted like a translucent colour's (see theme.translucent): white
-- over a dark card blends in linear light, where a web alpha shows several times as strong.
local LIGHT = theme.overDark(255, 255, 255, 0.05 * 255)
local SHADOW = Color(0, 0, 0, 255)
local OPAQUE_WHITE = Color(255, 255, 255, 255)

-- Draws a transparent picture `iw` x `ih` centred at (cx, cy), turned `tilt` degrees, over its
-- light and shadow; `opacity` (0-1) fades it all in.
local function floating(material: IMaterial, cx: number, cy: number, iw: number, ih: number, tilt: number, opacity: number)
	local size = math.max(iw, ih)
	if not theme.light then
		theme.spot(cx - size * 0.6, cy - size * 0.6, size * 1.2, size * 1.2, LIGHT, LIGHT.a / 255 * opacity)
	end
	local foot = cy + ih / 2
	theme.spot(cx - iw * 0.45, foot - size * 0.08, iw * 0.9, size * 0.16, SHADOW, (theme.light and 0.18 or 0.5) * opacity)
	surface.SetMaterial(material)
	surface.SetDrawColor(opacity >= 1 and OPAQUE_WHITE or theme.fade(OPAQUE_WHITE, opacity))
	surface.DrawTexturedRectRotated(cx, cy, iw, ih, tilt)
end

return {
	image = image,
	fadeIn = fadeIn,
	cover = cover,
	contain = contain,
	transparent = transparent,
	floating = floating,
}
