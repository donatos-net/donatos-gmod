-- Client: what the menu's pages share: the context they render from, formatting, page
-- headers, empty states, and the dialogs more than one page opens.

local netMessage = require("donatos.net")
local theme = require("ui.theme")
local widgets = require("ui.widgets")

local colors = theme.colors
local px = theme.px

type DonatosMenuTab = "shop" | "items"

interface DonatosMenuContext {
	dialogs: DonatosUiDialogHost;
	config: () => DonatosRemoteConfig | nil;
	data: () => NonNullable<DonatosRemoteData> | nil;
	loaded: () => boolean;
	-- Opens the pay page; `deposit` is the amount to preselect, or "true" for none.
	openPayUrl: (deposit: string) => void;
	canPay: () => boolean;
	-- Re-renders after a local state change.
	rerender: () => void;
	showTab: (tab: DonatosMenuTab) => void;
	close: () => void;
	state: DonatosMenuState;
}

interface DonatosMenuState {
	tab: DonatosMenuTab;
	scroll: Table<string, number>;
	query: string;
	-- The shop section the category bar shows as current.
	section: number | nil;
	-- The item dialog's "Активировать сразу" switch, remembered between purchases.
	instant: boolean;
	searchEntry: DTextEntry | nil;
}

local DEFAULT_ERROR = "Не удалось выполнить действие. Попробуйте еще раз."

------------------------------------------------------------------------------ formatting

-- 9300 -> "9 300".
local function formatNumber(value: number | string): string
	local digits = tostring(value)
	local sign, whole, rest = string.match(digits, "^(-?)(%d+)(.*)$")
	if whole == nil then
		return digits
	end
	local grouped = string.reverse((string.gsub(string.reverse(whole), "(%d%d%d)", "%1 ")))
	return `${sign}${string.TrimLeft(grouped)}${rest}`
end

-- A duration in days, short: "30 дн."; nil or 0 is permanent.
local function formatDays(duration?: number): string
	if duration == nil or duration == 0 then
		return "Навсегда"
	end
	return `${duration} дн.`
end

local function plural(count: number, one: string, few: string, many: string): string
	local tens = count % 100
	local units = count % 10
	if tens >= 11 and tens <= 14 then
		return many
	elseif units == 1 then
		return one
	elseif units >= 2 and units <= 4 then
		return few
	end
	return many
end

-- A duration in days, long: "30 дней".
local function formatDaysLong(duration?: number): string
	if duration == nil or duration == 0 then
		return "Навсегда"
	end
	return `${duration} ${plural(duration, "день", "дня", "дней")}`
end

-- Time left from seconds: "12 дн.", "5 ч.", "40 мин.".
local function formatRemaining(seconds: number): string
	if seconds >= 86400 then
		return `${math.ceil(seconds / 86400)} дн.`
	elseif seconds >= 3600 then
		return `${math.ceil(seconds / 3600)} ч.`
	end
	return `${math.max(math.ceil(seconds / 60), 1)} мин.`
end

-- Lowercases Russian and Latin letters (string.lower leaves Cyrillic alone).
local function lower(value: string): string
	local result = string.lower(value)
	result = string.gsub(result, "\208([\144-\159])", function(byte: string): string
		return `\208${string.char(string.byte(byte) + 32)}`
	end)
	result = string.gsub(result, "\208([\160-\175])", function(byte: string): string
		return `\209${string.char(string.byte(byte) - 32)}`
	end)
	result = string.gsub(result, "\208\129", "\209\145")
	return result
end

------------------------------------------------------------------------------ dialogs

local function showError(ctx: DonatosMenuContext, message?: string)
	ctx.dialogs.show({
		title = "Ошибка",
		description = message ~= nil and message ~= "" and message or DEFAULT_ERROR,
		actions = { { label = "Закрыть", variant = "secondary", onClick = ctx.dialogs.close } },
	})
end

local function cancelAction(ctx: DonatosMenuContext, label?: string): DonatosUiButton
	return { label = label or "Отмена", variant = "secondary", onClick = ctx.dialogs.close }
end

local QUICK_AMOUNTS: number[] = { 100, 300, 500, 1000 }

local function igsDeposit(ctx: DonatosMenuContext)
	local sum: number | nil = 100
	local errorText: string | nil = nil
	local continueButton: DonatosUiButton = { label = "Продолжить" }
	local backButton: DonatosUiButton = { label = "Назад", variant = "secondary", onClick = ctx.dialogs.close }
	local relayout: () => void = function() end
	local quick: DonatosUiButton[] = {}
	local function syncQuick()
		for i, options in ipairs(quick) do
			options.variant = sum == QUICK_AMOUNTS[i] and "primary" or "secondary"
		end
	end

	continueButton.onClick = function()
		local amount = sum
		if amount == nil or amount <= 0 then
			errorText = "Укажите корректную сумму пополнения"
			relayout()
			return
		end
		errorText = nil
		continueButton.pending = true
		backButton.disabled = true
		netMessage.toServer("createIgsPaymentUrl", { sum = amount }, function(result)
			continueButton.pending = false
			backButton.disabled = false
			if result.success then
				gui.OpenURL(result.data.url)
				ctx.dialogs.close()
			else
				errorText = result.error ~= "" and result.error or "Не удалось создать ссылку на оплату"
				relayout()
			end
		end)
	end

	ctx.dialogs.show({
		title = "Пополнить через gm-donate",
		description = "Это сторонний сервис, который подключен администратором сервера и не имеет отношения к Donatos. Доступны скины, криптовалюта и другие методы. Поддержка по этому сервису не предоставляется.",
		actions = { backButton, continueButton },
		body = function(parent: Panel, bodyRelayout: () => void): DonatosUiBlock
			relayout = bodyRelayout
			local panel = widgets.blankPanel(parent)
			local field, entry = widgets.textEntry(panel, "Сумма пополнения", true)
			entry:SetValue(tostring(sum))

			local quickButtons: DButton[] = {}
			for _, amount in ipairs(QUICK_AMOUNTS) do
				local options: DonatosUiButton = { label = formatNumber(amount), size = "sm", fill = true }
				options.onClick = function()
					sum = amount
					errorText = nil
					entry:SetValue(tostring(amount))
					syncQuick()
					relayout()
				end
				table.insert(quick, options)
				table.insert(quickButtons, widgets.button(panel, options))
			end
			syncQuick()

			entry.OnChange = function(self: DTextEntry)
				sum = tonumber(self:GetValue())
				errorText = nil
				syncQuick()
			end

			local errorOptions: DonatosUiTextOptions = { text = "", font = theme.font("small"), color = colors.danger }
			local errorBlock = widgets.text(panel, errorOptions)

			return {
				panel = panel,
				layout = function(width: number): number
					local gap = px(8)
					local cell = (width - gap * (#quickButtons - 1)) / #quickButtons
					for i, btn in ipairs(quickButtons) do
						btn:SetPos(math.floor((i - 1) * (cell + gap)), 0)
						btn:SetSize(math.floor(cell), px(32))
					end
					local y = px(32) + px(12)
					field:SetPos(0, y)
					field:SetSize(width, px(36))
					y = y + px(36)
					local message = errorText
					errorBlock.panel:SetVisible(message ~= nil)
					if message ~= nil then
						errorOptions.text = message
						local h = errorBlock.layout(width)
						errorBlock.panel:SetPos(0, y + px(8))
						errorBlock.panel:SetSize(width, h)
						y = y + px(8) + h
					end
					return y
				end,
			}
		end,
	})
end

-- Top-up: straight to the pay page, or a choice of it and gm-donate when that is enabled.
local function topUp(ctx: DonatosMenuContext, anchor: Panel, deposit?: string)
	local config = ctx.config()
	if config == nil or not config.igs.enabled then
		ctx.openPayUrl(deposit or "true")
		return
	end
	widgets.dropdown(anchor, {
		{
			label = "Пополнить баланс",
			disabled = not ctx.canPay(),
			onClick = function()
				ctx.openPayUrl(deposit or "true")
			end,
		},
		{
			label = "Другие способы (gm-donate)",
			onClick = function()
				igsDeposit(ctx)
			end,
		},
	})
end

------------------------------------------------------------------------------ page parts

-- A page's title row: the title (read every frame), `extra` panels at the right.
local function pageHeader(parent: Panel, title: () => string, extra?: Panel[]): Panel
	local header = vgui.Create("DPanel", parent)
	header:SetTall(px(36))
	local font = theme.font("title")
	header.Paint = function(self: Panel, w: number, h: number): boolean
		draw.SimpleText(title(), font, 0, h / 2, colors.text, TEXT_ALIGN_LEFT, TEXT_ALIGN_CENTER)
		return true
	end
	local others = extra or {}
	for _, child in ipairs(others) do
		child:SetParent(header)
	end
	header.PerformLayout = function(self: Panel, w: number, h: number)
		local right = w + px(8)
		for i = #others, 1, -1 do
			local child = assert(others[i])
			right = right - px(8) - child:GetWide()
			child:SetPos(right, (h - child:GetTall()) / 2)
		end
	end
	return header
end

interface DonatosEmptyState {
	icon: DonatosIcon;
	title: string;
	text?: string;
	action?: DonatosUiButton;
}

-- A centred icon, title, line of text and optional button, filling `parent`.
local function emptyState(parent: Panel, spec: DonatosEmptyState): Panel
	local panel = widgets.blankPanel(parent)
	local content, add = widgets.stack(panel, px(12))
	add(widgets.painted(content.panel, px(48), function(w: number, h: number)
		local size = px(48)
		local x = (w - size) / 2
		theme.box(size / 2, x, 0, size, size, colors.default)
		theme.icon(spec.icon, x + (size - px(20)) / 2, (size - px(20)) / 2, px(20), colors.muted)
	end))
	add(widgets.text(content.panel, { text = spec.title, font = theme.font("cardTitle"), color = colors.text, align = "center" }))
	if spec.text ~= nil then
		add(widgets.text(content.panel, { text = spec.text, font = theme.font("body"), color = colors.muted, lineHeight = 20, align = "center" }))
	end
	if spec.action ~= nil then
		local btn = widgets.button(content.panel, spec.action)
		local actionRow = widgets.blankPanel(content.panel)
		btn:SetParent(actionRow)
		add({
			panel = actionRow,
			layout = function(width: number): number
				btn:SetPos((width - btn:GetWide()) / 2, px(4))
				return btn:GetTall() + px(4)
			end,
		})
	end
	panel.PerformLayout = function(self: Panel, w: number, h: number)
		local width = math.min(px(340), w)
		local height = content.layout(width)
		content.panel:SetSize(width, height)
		content.panel:SetPos((w - width) / 2, math.max((h - height) / 2, 0))
	end
	return panel
end

local function loading(parent: Panel): Panel
	local panel = widgets.blankPanel(parent)
	panel.Paint = function(self: Panel, w: number, h: number): boolean
		theme.spinner(w / 2, h / 2, px(10), colors.muted)
		return true
	end
	return panel
end

return {
	formatNumber = formatNumber,
	formatDays = formatDays,
	formatDaysLong = formatDaysLong,
	formatRemaining = formatRemaining,
	lower = lower,
	showError = showError,
	cancelAction = cancelAction,
	igsDeposit = igsDeposit,
	topUp = topUp,
	pageHeader = pageHeader,
	emptyState = emptyState,
	loading = loading,
}
