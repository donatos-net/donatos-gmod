-- Client: visual tokens for the donatos menu (a dark shadcn-style theme), scaled to the screen,
-- and the drawing and text helpers every widget shares.

local theme = {}

-- GMod's 2D pipeline crushes dark tones: drawing grey 16 shows 8, 24 shows 17, and from 96 up
-- it is the identity (measured with a grey ramp in the client). Theme colours are written as
-- they should appear, and lifted through the inverse of that response.
local RESPONSE: { drawn: number; shown: number }[] = {
	{ drawn = 0, shown = 0 },
	{ drawn = 8, shown = 2 },
	{ drawn = 16, shown = 8 },
	{ drawn = 24, shown = 17 },
	{ drawn = 32, shown = 26 },
	{ drawn = 40, shown = 35 },
	{ drawn = 48, shown = 44 },
	{ drawn = 56, shown = 53 },
	{ drawn = 64, shown = 62 },
	{ drawn = 72, shown = 70 },
	{ drawn = 80, shown = 79 },
	{ drawn = 96, shown = 96 },
}

local function lift(shown: number): number
	for i = 2, #RESPONSE do
		local low = assert(RESPONSE[i - 1])
		local high = assert(RESPONSE[i])
		if shown <= high.shown then
			local f = (shown - low.shown) / (high.shown - low.shown)
			return math.Round(Lerp(f, low.drawn, high.drawn))
		end
	end
	return shown
end

-- An opaque colour that appears on screen as (r, g, b).
local function shown(r: number, g: number, b: number): Color
	return Color(lift(r), lift(g), lift(b), 255)
end

-- The forward response: what a drawn grey shows as.
local function crush(drawn: number): number
	for i = 2, #RESPONSE do
		local low = assert(RESPONSE[i - 1])
		local high = assert(RESPONSE[i])
		if drawn <= high.drawn then
			return Lerp((drawn - low.drawn) / (high.drawn - low.drawn), low.shown, high.shown)
		end
	end
	return drawn
end

local function toLinear(value: number): number
	local c = value / 255
	return c <= 0.04045 and c / 12.92 or ((c + 0.055) / 1.055) ^ 2.4
end

-- GMod blends translucent draws in linear light, where the web blends sRGB values, so the same
-- alpha comes out far stronger (white at 24 over black shows 86, not 24). This finds the alpha
-- that shows like the web's `alpha`. Near-black scales whatever is below, which has a closed form
-- (1 - (1 - a)^2.2); anything else is matched over the menu background, and is close over
-- lighter surfaces.
local BLEND_BASE: number[] = { 14, 14, 16 }
local webAlphas: Table<Color, number> = setmetatable({}, { __mode = "k" })

local function blendAlpha(color: Color, alpha: number): number
	local a = math.Clamp(alpha / 255, 0, 1)
	if math.max(color.r, color.g, color.b) <= 16 then
		return math.Round((1 - (1 - a) ^ 2.2) * 255)
	end
	local best, spread = a, 0
	for i, channel in ipairs({ color.r, color.g, color.b }) do
		local baseShown = assert(BLEND_BASE[i])
		local base = toLinear(lift(baseShown))
		local top = toLinear(channel)
		if math.abs(top - base) > spread then
			spread = math.abs(top - base)
			local target = toLinear(lift(a * crush(channel) + (1 - a) * baseShown))
			best = (target - base) / (top - base)
		end
	end
	return math.Round(math.Clamp(best, 0, 1) * 255)
end

-- `color` drawn at what the web would show as `alpha`.
local function translucent(r: number, g: number, b: number, alpha: number): Color
	local color = Color(r, g, b, 255)
	color.a = blendAlpha(color, alpha)
	webAlphas[color] = alpha
	return color
end

-- `color` with its web alpha scaled by `factor` (for disabled and fading states).
function theme.fade(color: Color, factor: number): Color
	local faded = Color(color.r, color.g, color.b, 255)
	local alpha = (webAlphas[color] or color.a) * factor
	faded.a = blendAlpha(faded, alpha)
	webAlphas[faded] = alpha
	return faded
end

-- HeroUI v3's dark theme, as the menu's design uses it.
theme.colors = {
	-- The window: near-black glass over the blurred game (rgba(4, 4, 5, 0.88) on the web).
	glass = translucent(lift(4), lift(4), lift(5), 224),
	frameRing = translucent(255, 255, 255, 30),
	surface = shown(24, 24, 27),
	surfaceHover = shown(31, 31, 34),
	-- HeroUI's surface-secondary: a table's frame and header.
	surfaceSecondary = shown(35, 35, 37),
	surfaceRing = shown(46, 46, 49),
	panel = shown(18, 18, 20),
	group = shown(28, 28, 30),
	default = shown(39, 39, 42),
	defaultHover = shown(52, 52, 57),
	separator = shown(33, 33, 36),
	text = Color(252, 252, 252),
	textSoft = Color(212, 212, 216),
	textDim = translucent(255, 255, 255, 191),
	muted = Color(159, 159, 169),
	faint = Color(113, 113, 122),
	accent = Color(4, 133, 247),
	accentHover = Color(30, 147, 248),
	accentText = Color(24, 142, 247),
	accentSoft = translucent(4, 133, 247, 31),
	accentSoftHover = translucent(4, 133, 247, 51),
	success = Color(41, 205, 112),
	successSoft = translucent(23, 201, 100, 38),
	danger = Color(248, 113, 113),
	inverse = Color(252, 252, 252),
	inverseHover = Color(228, 228, 231),
	inverseText = shown(6, 6, 7),
	inverseMuted = Color(82, 82, 91),
	-- On the gradient top bar.
	barShade = translucent(0, 0, 0, 77),
	barTabs = translucent(0, 0, 0, 56),
	barHover = translucent(255, 255, 255, 20),
	barSelected = translucent(255, 255, 255, 56),
	overlay = translucent(0, 0, 0, 140),
	scrollGrip = translucent(255, 255, 255, 40),
	selection = translucent(96, 165, 250, 120),
}

-- Header gradient stops ("ocean": cyan, the accent blue, indigo, teal) at 0.6 alpha,
-- composited over the background.
local function overBackground(r: number, g: number, b: number): Color
	return shown(Lerp(0.6, 14, r), Lerp(0.6, 14, g), Lerp(0.6, 16, b))
end

local GRADIENT: Color[] = {
	overBackground(6, 182, 212),
	overBackground(4, 133, 247),
	overBackground(99, 102, 241),
	overBackground(20, 184, 166),
}

local scale = 1

-- Scales a length in the web UI's CSS pixels to the screen. Like the old DHTML menu's zoom, 1 at
-- 1920x1080, growing with larger screens and never shrinking below 1, so text stays readable.
function theme.px(value: number): number
	return math.Round(value * scale)
end

-- A GMod font's size is its full cell height, about 1.17 times the CSS font-size for Roboto:
-- 16 here matches the design's 14px text. The design's weight 600 is drawn as Roboto Medium.
-- (The design uses Inter, which GMod doesn't ship.)
local FONTS: { name: string; face: string; size: number; weight: number }[] = {
	{ name = "chip", face = "Roboto Medium", size = 14, weight = 500 },
	{ name = "small", face = "Roboto", size = 15, weight = 400 },
	{ name = "smallMedium", face = "Roboto Medium", size = 15, weight = 500 },
	{ name = "body", face = "Roboto", size = 16, weight = 400 },
	{ name = "medium", face = "Roboto Medium", size = 16, weight = 500 },
	{ name = "cardTitle", face = "Roboto Medium", size = 18, weight = 500 },
	{ name = "reading", face = "Roboto", size = 18, weight = 400 },
	{ name = "section", face = "Roboto Medium", size = 20, weight = 500 },
	{ name = "price", face = "Roboto Medium", size = 23, weight = 500 },
	{ name = "title", face = "Roboto Medium", size = 26, weight = 500 },
	{ name = "dialogTitle", face = "Roboto Medium", size = 28, weight = 500 },
	{ name = "priceLarge", face = "Roboto Medium", size = 37, weight = 500 },
	{ name = "input", face = "Roboto", size = 16, weight = 400 },
}

-- Recomputes the scale and recreates the fonts for the current resolution.
function theme.refresh()
	scale = math.max(1, math.min(ScrW() / 1920, ScrH() / 1080))
	for _, font in ipairs(FONTS) do
		surface.CreateFont(`donatos.${font.name}`, {
			font = font.face,
			size = theme.px(font.size),
			weight = font.weight,
			extended = true,
			antialias = true,
		})
	end
end

local type DonatosFont =
	| "chip"
	| "small"
	| "smallMedium"
	| "body"
	| "medium"
	| "cardTitle"
	| "reading"
	| "section"
	| "price"
	| "title"
	| "dialogTitle"
	| "priceLarge"
	| "input"

function theme.font(name: DonatosFont): string
	return `donatos.${name}`
end

function theme.textSize(text: string, font: string): (number, number)
	surface.SetFont(font)
	return surface.GetTextSize(text)
end

function theme.fontHeight(font: string): number
	local _, h = theme.textSize("Ay", font)
	return h
end

-- Word-wraps `text` to `width`, keeping its line breaks; a word wider than a line is
-- broken between characters.
function theme.wrap(text: string, font: string, width: number): string[]
	surface.SetFont(font)
	local lines: string[] = {}
	for paragraph in string.gmatch(`${text}\n`, "(.-)\r?\n") do
		local line = ""
		for word in string.gmatch(paragraph, "%S+") do
			local candidate = line == "" and word or `${line} ${word}`
			local candidateWidth = surface.GetTextSize(candidate)
			if candidateWidth <= width then
				line = candidate
			else
				if line ~= "" then
					table.insert(lines, line)
				end
				line = ""
				for char in string.gmatch(word, utf8.charpattern) do
					local extended = line .. char
					local extendedWidth = surface.GetTextSize(extended)
					if line ~= "" and extendedWidth > width then
						table.insert(lines, line)
						line = char
					else
						line = extended
					end
				end
			end
		end
		table.insert(lines, line)
	end
	return lines
end

-- Like `theme.wrap`, but at most `maxLines` lines; a cut last line ends with an ellipsis.
function theme.clamp(text: string, font: string, width: number, maxLines: number): string[]
	local lines = theme.wrap(text, font, width)
	if #lines <= maxLines then
		return lines
	end
	local kept: string[] = {}
	for i = 1, maxLines do
		kept[i] = assert(lines[i])
	end
	surface.SetFont(font)
	local last = string.TrimRight(assert(kept[maxLines]))
	while last ~= "" and surface.GetTextSize(`${last}…`) > width do
		-- Drops the last character (GMod's utf8.offset rejects negative counts).
		last = string.TrimRight((string.gsub(last, `${utf8.charpattern}$`, "")))
	end
	kept[maxLines] = `${last}…`
	return kept
end

-- The y at which to draw text in `font` so that its baseline lines up with text in
-- `anchorFont` drawn at `anchorY`. Roboto's baseline sits at about 0.8 of the cell.
function theme.baseline(anchorY: number, anchorFont: string, font: string): number
	return math.Round(anchorY + (theme.fontHeight(anchorFont) - theme.fontHeight(font)) * 0.8)
end

------------------------------------------------------------------------------ rounded boxes

-- draw.RoundedBox's corner textures are close to 1-bit at small radii, so corners are drawn
-- from masks rendered once per radius: each texel holds the exact coverage of a quarter
-- circle (4x4 supersampled), drawn 1:1 with point sampling. "outside" masks hold the rest of the
-- square, and "ring" masks the one-pixel band between the circle and the next smaller one.
local CORNER_TEXTURE_FLAGS = 1 + 4 + 8 + 256 + 512 -- point sample, clamp S/T, no mips, no LOD
local cornerMasks: Table<string, DonatosMask> = {}

local type DonatosCornerKind = "inside" | "outside" | "ring"

local type DonatosMask = { material: IMaterial; extent: number }

-- Bakes a `size` x `size` alpha mask into a render target named `name`: `alphaAt(x, y)` gives
-- each texel's alpha (0-255). Returned with the fraction of the texture it fills.
local function bakeMask(name: string, size: number, alphaAt: (x: number, y: number) => number): DonatosMask
	local textureSize = 4
	while textureSize < size do
		textureSize = textureSize * 2
	end
	local target = GetRenderTargetEx(name, textureSize, textureSize, RT_SIZE_LITERAL, MATERIAL_RT_DEPTH_NONE, CORNER_TEXTURE_FLAGS, 0, IMAGE_FORMAT_BGRA8888)

	-- render.Clear inside the pushed target leaves it opaque black; this clears to transparent.
	render.ClearRenderTarget(target, Color(255, 255, 255, 0))
	render.PushRenderTarget(target)
	render.OverrideAlphaWriteEnable(true, true)
	cam.Start2D()
	-- Masks bake on first use, which can be mid-paint inside a scaled or fading panel
	-- (theme.pushScale, Panel:SetAlpha); the texels must take neither.
	cam.PushModelMatrix(Matrix(), false)
	local alphaMultiplier = surface.GetAlphaMultiplier()
	surface.SetAlphaMultiplier(1)
	render.OverrideBlend(true, BLEND_ONE, BLEND_ZERO, BLENDFUNC_ADD, BLEND_ONE, BLEND_ZERO, BLENDFUNC_ADD)
	draw.NoTexture()
	for y = 0, size - 1 do
		for x = 0, size - 1 do
			local alpha = math.Round(alphaAt(x, y))
			-- surface skips fully transparent draws; those texels keep the clear.
			if alpha > 0 then
				surface.SetDrawColor(255, 255, 255, alpha)
				surface.DrawRect(x, y, 1, 1)
			end
		end
	end
	render.OverrideBlend(false)
	surface.SetAlphaMultiplier(alphaMultiplier)
	cam.PopModelMatrix()
	cam.End2D()
	render.OverrideAlphaWriteEnable(false)
	render.PopRenderTarget()

	local material = CreateMaterial(name, "UnlitGeneric", {
		["$basetexture"] = target:GetName(),
		["$translucent"] = 1,
		["$vertexalpha"] = 1,
		["$vertexcolor"] = 1,
	})
	return { material = material, extent = size / textureSize }
end

local SAMPLES = 4

-- The fraction of the pixel at (x, y) for which `inside(sampleX, sampleY)` holds.
local function coverage(x: number, y: number, inside: (sx: number, sy: number) => boolean): number
	local hits = 0
	for sy = 0, SAMPLES - 1 do
		for sx = 0, SAMPLES - 1 do
			if inside(x + (sx + 0.5) / SAMPLES, y + (sy + 0.5) / SAMPLES) then
				hits = hits + 1
			end
		end
	end
	return hits / (SAMPLES * SAMPLES)
end

local function cornerMask(radius: number, kind: DonatosCornerKind): DonatosMask
	local key = `${radius}${kind}`
	local cached = cornerMasks[key]
	if cached ~= nil then
		return cached
	end

	local function within(r: number): (sx: number, sy: number) => boolean
		return function(sx: number, sy: number): boolean
			return (radius - sx) ^ 2 + (radius - sy) ^ 2 <= r * r
		end
	end
	local mask = bakeMask(`donatos_corner_v4_${key}`, radius, function(x: number, y: number): number
		local covered = coverage(x, y, within(radius))
		if kind == "outside" then
			covered = 1 - covered
		elseif kind == "ring" then
			covered = covered - coverage(x, y, within(radius - 1))
		end
		return covered * 255
	end)
	cornerMasks[key] = mask
	return mask
end

local function drawCorner(mask: DonatosMask, x: number, y: number, radius: number, flipX: boolean, flipY: boolean)
	local e = mask.extent
	surface.SetMaterial(mask.material)
	surface.DrawTexturedRectUV(x, y, radius, radius, flipX and e or 0, flipY and e or 0, flipX and 0 or e, flipY and 0 or e)
end

-- A rounded box with anti-aliased corners; the flags choose which corners are rounded.
function theme.box(
	radius: number,
	x: number,
	y: number,
	w: number,
	h: number,
	color: Color,
	tl?: boolean,
	tr?: boolean,
	bl?: boolean,
	br?: boolean
)
	x, y, w, h = math.Round(x), math.Round(y), math.Round(w), math.Round(h)
	local r = math.min(math.Round(radius), math.floor(math.min(w, h) / 2))
	surface.SetDrawColor(color)
	draw.NoTexture()
	if r <= 0 then
		surface.DrawRect(x, y, w, h)
		return
	end
	surface.DrawRect(x + r, y, w - r * 2, h)
	surface.DrawRect(x, y + r, r, h - r * 2)
	surface.DrawRect(x + w - r, y + r, r, h - r * 2)

	local mask = cornerMask(r, "inside")
	local corners: { on: boolean; cx: number; cy: number; fx: boolean; fy: boolean }[] = {
		{ on = tl ~= false, cx = x, cy = y, fx = false, fy = false },
		{ on = tr ~= false, cx = x + w - r, cy = y, fx = true, fy = false },
		{ on = bl ~= false, cx = x, cy = y + h - r, fx = false, fy = true },
		{ on = br ~= false, cx = x + w - r, cy = y + h - r, fx = true, fy = true },
	}
	for _, corner in ipairs(corners) do
		if corner.on then
			surface.SetDrawColor(color)
			drawCorner(mask, corner.cx, corner.cy, r, corner.fx, corner.fy)
		else
			draw.NoTexture()
			surface.SetDrawColor(color)
			surface.DrawRect(corner.cx, corner.cy, r, r)
		end
	end
end

-- Paints `color` outside a circle inscribed in the square at (x, y): drawn over a square image,
-- it leaves an anti-aliased circle, provided `color` is what lies behind.
function theme.circleCutout(x: number, y: number, size: number, color: Color)
	local r = math.floor(size / 2)
	local mask = cornerMask(r, "outside")
	surface.SetDrawColor(color)
	drawCorner(mask, x, y, r, false, false)
	drawCorner(mask, x + size - r, y, r, true, false)
	drawCorner(mask, x, y + size - r, r, false, true)
	drawCorner(mask, x + size - r, y + size - r, r, true, true)
end

-- Paints `color` outside the rounded corners of a box, for shapes drawn square (a gradient):
-- `color` must be what lies behind each chosen corner.
function theme.roundCutout(
	radius: number,
	x: number,
	y: number,
	w: number,
	h: number,
	color: Color,
	tl?: boolean,
	tr?: boolean,
	bl?: boolean,
	br?: boolean
)
	x, y, w, h = math.Round(x), math.Round(y), math.Round(w), math.Round(h)
	local r = math.min(math.Round(radius), math.floor(math.min(w, h) / 2))
	if r <= 0 then
		return
	end
	local mask = cornerMask(r, "outside")
	surface.SetDrawColor(color)
	if tl ~= false then
		drawCorner(mask, x, y, r, false, false)
	end
	if tr ~= false then
		drawCorner(mask, x + w - r, y, r, true, false)
	end
	if bl ~= false then
		drawCorner(mask, x, y + h - r, r, false, true)
	end
	if br ~= false then
		drawCorner(mask, x + w - r, y + h - r, r, true, true)
	end
end

-- A one-pixel rounded border; the flags choose which corners are rounded, as for `theme.box`.
function theme.ring(
	radius: number,
	x: number,
	y: number,
	w: number,
	h: number,
	color: Color,
	tl?: boolean,
	tr?: boolean,
	bl?: boolean,
	br?: boolean
)
	x, y, w, h = math.Round(x), math.Round(y), math.Round(w), math.Round(h)
	local r = math.min(math.Round(radius), math.floor(math.min(w, h) / 2))
	local rtl = (tl ~= false and r > 0) and r or 0
	local rtr = (tr ~= false and r > 0) and r or 0
	local rbl = (bl ~= false and r > 0) and r or 0
	local rbr = (br ~= false and r > 0) and r or 0
	surface.SetDrawColor(color)
	draw.NoTexture()
	surface.DrawRect(x + rtl, y, w - rtl - rtr, 1)
	surface.DrawRect(x + rbl, y + h - 1, w - rbl - rbr, 1)
	surface.DrawRect(x, y + math.max(rtl, 1), 1, h - math.max(rtl, 1) - math.max(rbl, 1))
	surface.DrawRect(x + w - 1, y + math.max(rtr, 1), 1, h - math.max(rtr, 1) - math.max(rbr, 1))
	if r <= 0 then
		return
	end
	local mask = cornerMask(r, "ring")
	if rtl > 0 then
		drawCorner(mask, x, y, r, false, false)
	end
	if rtr > 0 then
		drawCorner(mask, x + w - r, y, r, true, false)
	end
	if rbl > 0 then
		drawCorner(mask, x, y + h - r, r, false, true)
	end
	if rbr > 0 then
		drawCorner(mask, x + w - r, y + h - r, r, true, true)
	end
end

-- A filled rounded box with a one-pixel border over its edge, as a web element draws them.
function theme.outlined(radius: number, x: number, y: number, w: number, h: number, fill: Color, border: Color)
	theme.box(radius, x, y, w, h, fill)
	theme.ring(radius, x, y, w, h, border)
end

-- The same stops at full strength, for progress bars.
local VIVID: Color[] = {
	Color(6, 182, 212),
	Color(4, 133, 247),
	Color(99, 102, 241),
	Color(20, 184, 166),
}

local function sampleGradient(stops: Color[], t: number): Color
	local position = math.Clamp(t, 0, 1) * (#stops - 1)
	local index = math.min(math.floor(position) + 1, #stops - 1)
	local from = assert(stops[index])
	local to = assert(stops[index + 1])
	local f = position - (index - 1)
	return Color(
		Lerp(f, from.r, to.r),
		Lerp(f, from.g, to.g),
		Lerp(f, from.b, to.b),
		Lerp(f, from.a, to.a)
	)
end

-- The header gradient's colour at `x` of a header `w` wide, at the current moment; `vivid`
-- takes the full-strength stops.
function theme.gradientAt(x: number, w: number, vivid?: boolean): Color
	local cycle = (RealTime() % 10) / 10
	local eased = (1 - math.cos(cycle * math.pi * 2)) / 2
	return sampleGradient(vivid and VIVID or GRADIENT, eased * 0.75 + 0.25 * x / w)
end

-- The header's slowly drifting four-colour gradient (a quarter of it visible at a time), with
-- its top corners rounded by `radius` in the gradient's colour at each edge.
function theme.paintGradient(w: number, h: number, radius: number)
	local function at(x: number): Color
		return theme.gradientAt(x, w)
	end
	local corner = radius * 2
	local strip = math.max(theme.px(4), 2)
	for x = corner, w - corner - 1, strip do
		surface.SetDrawColor(at(x))
		surface.DrawRect(x, 0, math.min(strip, w - corner - x), h)
	end
	theme.box(radius, 0, 0, corner, h, at(radius), true, false, false, false)
	theme.box(radius, w - corner, 0, corner, h, at(w - radius), false, true, false, false)
end

------------------------------------------------------------------------------ motion

-- HeroUI's easing curves (@heroui/styles themes/shared/theme.css), as cubic Béziers.
local function bezier(x1: number, y1: number, x2: number, y2: number): (t: number) => number
	local function at(u: number, a: number, b: number): number
		return 3 * (1 - u) ^ 2 * u * a + 3 * (1 - u) * u ^ 2 * b + u ^ 3
	end
	return function(t: number): number
		if t <= 0 then
			return 0
		elseif t >= 1 then
			return 1
		end
		-- Newton's method for the u where x(u) = t.
		local u = t
		for _ = 1, 8 do
			local slope = 3 * (1 - u) ^ 2 * x1 + 6 * (1 - u) * u * (x2 - x1) + 3 * u ^ 2 * (1 - x2)
			if math.abs(slope) < 1e-6 then
				break
			end
			u = math.Clamp(u - (at(u, x1, x2) - t) / slope, 0, 1)
		end
		return at(u, y1, y2)
	end
end

type DonatosEase = "smooth" | "out" | "outQuad" | "outQuart" | "outFluid"

local EASES: { [K in DonatosEase]: (t: number) => number } = {
	smooth = bezier(0.25, 0.1, 0.25, 1),
	out = bezier(0, 0, 0.58, 1),
	outQuad = bezier(0.25, 0.46, 0.45, 0.94),
	outQuart = bezier(0.165, 0.84, 0.44, 1),
	outFluid = bezier(0.32, 0.72, 0, 1),
}

interface DonatosTween {
	-- The value now.
	value: () => number;
	-- Starts moving from the current value to `target` over `duration` seconds; a no-op when
	-- `target` is already where it is heading.
	to: (target: number, duration: number, ease: DonatosEase) => void;
	-- Jumps to `target`.
	set: (target: number) => void;
	target: () => number;
	-- Whether it has arrived.
	done: () => boolean;
}

-- A number that eases towards its target, like a CSS transition.
function theme.tween(initial: number): DonatosTween
	local from, goal, start, duration = initial, initial, 0, 0
	local curve = EASES.smooth
	local function progress(): number
		if duration <= 0 then
			return 1
		end
		return math.Clamp((RealTime() - start) / duration, 0, 1)
	end
	local function value(): number
		local t = progress()
		return t >= 1 and goal or Lerp(curve(t), from, goal)
	end
	return {
		value = value,
		to = function(target: number, seconds: number, ease: DonatosEase)
			if target == goal then
				return
			end
			from = value()
			goal = target
			start = RealTime()
			duration = seconds
			curve = EASES[ease]
		end,
		set = function(target: number)
			from, goal, duration = target, target, 0
		end,
		target = function(): number
			return goal
		end,
		done = function(): boolean
			return progress() >= 1
		end,
	}
end

-- `a` blended into `b` by `t`; nil is transparent. Translucent colours blend their web
-- alphas (see `translucent`), so the result fades like the web's transition would.
function theme.mix(a: Color | nil, b: Color | nil, t: number): Color | nil
	if t <= 0 or b == a then
		return a
	elseif t >= 1 then
		return b
	end
	local from = a or Color((b as Color).r, (b as Color).g, (b as Color).b, 0)
	local to = b or Color(from.r, from.g, from.b, 0)
	local fromAlpha = a ~= nil and (webAlphas[from] or from.a) or 0
	local toAlpha = b ~= nil and (webAlphas[to] or to.a) or 0
	local mixed = Color(Lerp(t, from.r, to.r), Lerp(t, from.g, to.g), Lerp(t, from.b, to.b), 255)
	local alpha = Lerp(t, fromAlpha, toAlpha)
	mixed.a = alpha >= 255 and 255 or blendAlpha(mixed, alpha)
	webAlphas[mixed] = alpha
	return mixed
end

-- Scales what is drawn next by `scale` about the point (ox, oy) of `panel`, as a CSS transform
-- does. Returns whether a matrix was pushed: pass that to `theme.popScale` once drawing is
-- done (in PaintOver, to include the panel's children).
function theme.pushScale(panel: Panel, scale: number, ox: number, oy: number): boolean
	if math.abs(scale - 1) < 0.001 then
		return false
	end
	local x, y = panel:LocalToScreen(ox, oy)
	local origin = Vector(x, y, 0)
	local matrix = Matrix()
	matrix:Translate(origin)
	matrix:Scale(Vector(scale, scale, 1))
	matrix:Translate(-origin)
	cam.PushModelMatrix(matrix, true)
	render.PushFilterMag(TEXFILTER.ANISOTROPIC)
	render.PushFilterMin(TEXFILTER.ANISOTROPIC)
	return true
end

function theme.popScale(pushed: boolean)
	if pushed then
		render.PopFilterMin()
		render.PopFilterMag()
		cam.PopModelMatrix()
	end
end

------------------------------------------------------------------------------ group fades

-- Panel:SetAlpha fades each draw of a panel tree on its own, so mid-fade the layers (the
-- window, a card on it, the card's text) show through one another and the cards look more
-- solid than the window. CSS opacity fades the group as one picture. That is done here by
-- copying the screen before the group draws, then laying the copy back over it at
-- 1 - opacity.
local behindTargets: Table<string, IMaterial> = {}

local function behindMaterial(name: string): IMaterial
	local key = `${name}_${ScrW()}x${ScrH()}`
	local cached = behindTargets[key]
	if cached ~= nil then
		return cached
	end
	local texture = GetRenderTargetEx(`donatos_behind_${key}`, ScrW(), ScrH(), RT_SIZE_FULL_FRAME_BUFFER, MATERIAL_RT_DEPTH_NONE, CORNER_TEXTURE_FLAGS, 0, IMAGE_FORMAT_BGRA8888)
	local material = CreateMaterial(`donatos_behind_${key}`, "UnlitGeneric", {
		["$basetexture"] = texture:GetName(),
		["$vertexalpha"] = 1,
		["$vertexcolor"] = 1,
	})
	behindTargets[key] = material
	return material
end

-- First thing in the Paint of a group that is fading (`opacity` < 1): remembers what is
-- behind it.
function theme.captureBehind(name: string, opacity: number)
	if opacity < 1 then
		render.CopyRenderTargetToTexture(behindMaterial(name):GetTexture("$basetexture"))
	end
end

-- Last thing in the group's PaintOver (after its children, unscaled): fades the group by
-- covering it with what was behind it. The cover spans the screen, unclipped, because a group
-- scaled up (theme.pushScale) draws past its own bounds; outside the group the copy is what is
-- already there. Its alpha is converted like a near-black colour's (see blendAlpha), so the
-- dark window fades the way CSS opacity would rather than lagging behind its text.
function theme.coverBehind(name: string, panel: Panel, opacity: number)
	if opacity >= 1 then
		return
	end
	local sx, sy = panel:LocalToScreen(0, 0)
	local clipping = DisableClipping(true)
	surface.SetMaterial(behindMaterial(name))
	surface.SetDrawColor(255, 255, 255, math.Round(255 * (1 - math.Clamp(opacity, 0, 1)) ^ 2.2))
	surface.DrawTexturedRect(-sx, -sy, ScrW(), ScrH())
	DisableClipping(clipping)
end

------------------------------------------------------------------------------ blur

local blurMaterial = Material("pp/blurscreen")

-- The points of a rounded rectangle, for a stencil mask.
local function roundedPolygon(w: number, h: number, r: number): PolygonVertex[]
	local points: PolygonVertex[] = {}
	local steps = 8
	local centres: [number, number, number][] = {
		{ w - r, r, -90 },
		{ w - r, h - r, 0 },
		{ r, h - r, 90 },
		{ r, r, 180 },
	}
	for _, centre in ipairs(centres) do
		for i = 0, steps do
			local angle = math.rad(centre[3] + i / steps * 90)
			table.insert(points, { x = centre[1] + math.cos(angle) * r, y = centre[2] + math.sin(angle) * r, u = 0, v = 0 })
		end
	end
	return points
end

-- Blurs what is on screen behind `panel` (drawn first in its Paint), inside a rounded box of
-- `radius`. The design's 64px backdrop blur is approximated with three passes.
function theme.blur(panel: Panel, w: number, h: number, radius: number)
	local sx, sy = panel:LocalToScreen(0, 0)
	render.ClearStencil()
	render.SetStencilEnable(true)
	render.SetStencilWriteMask(255)
	render.SetStencilTestMask(255)
	render.SetStencilReferenceValue(1)
	render.SetStencilFailOperation(STENCIL_KEEP)
	render.SetStencilZFailOperation(STENCIL_KEEP)
	render.SetStencilPassOperation(STENCIL_REPLACE)
	render.SetStencilCompareFunction(STENCIL_ALWAYS)
	render.OverrideColorWriteEnable(true, false)
	draw.NoTexture()
	surface.SetDrawColor(255, 255, 255, 255)
	surface.DrawPoly(roundedPolygon(w, h, radius))
	render.OverrideColorWriteEnable(false, false)

	render.SetStencilCompareFunction(STENCIL_EQUAL)
	render.SetStencilPassOperation(STENCIL_KEEP)
	surface.SetMaterial(blurMaterial)
	surface.SetDrawColor(255, 255, 255, 255)
	for pass = 1, 3 do
		blurMaterial:SetFloat("$blur", pass * 2.5)
		blurMaterial:Recompute()
		render.UpdateScreenEffectTexture()
		surface.DrawTexturedRect(-sx, -sy, ScrW(), ScrH())
	end
	render.SetStencilEnable(false)
end

-- A ring of dots with a rotating bright head.
function theme.spinner(cx: number, cy: number, radius: number, color: Color)
	local dots = 8
	local head = math.floor(RealTime() * 12) % dots
	local dotRadius = math.max(radius * 0.22, 1)
	for i = 0, dots - 1 do
		local angle = i / dots * math.pi * 2
		local age = (head - i) % dots
		local dot = theme.fade(color, 1 - age / dots * 0.85)
		theme.box(
			dotRadius,
			cx + math.cos(angle) * radius - dotRadius,
			cy + math.sin(angle) * radius - dotRadius,
			dotRadius * 2,
			dotRadius * 2,
			dot
		)
	end
end

type DonatosIcon = "more" | "moreHorizontal" | "close" | "chevronDown" | "check" | "bag" | "cube" | "calendar" | "search" | "clock" | "card" | "wallet"

-- Icons are shapes on a 24-unit grid, like the web UI's Hugeicons, with 2-unit strokes.
local HALF_STROKE = 1

local function segmentDistance(px: number, py: number, ax: number, ay: number, bx: number, by: number): number
	local dx, dy = bx - ax, by - ay
	local t = math.Clamp(((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy), 0, 1)
	return math.sqrt((px - ax - dx * t) ^ 2 + (py - ay - dy * t) ^ 2)
end

local function pathDistance(px: number, py: number, points: [number, number][], closed?: boolean): number
	local best = math.huge
	local count = #points
	for i = 1, closed and count or count - 1 do
		local a = assert(points[i])
		local b = assert(points[i % count + 1])
		best = math.min(best, segmentDistance(px, py, a[1], a[2], b[1], b[2]))
	end
	return best
end

-- Distance to the outline of a rounded rectangle.
local function roundRectDistance(px: number, py: number, x: number, y: number, w: number, h: number, r: number): number
	local qx = math.abs(px - x - w / 2) - (w / 2 - r)
	local qy = math.abs(py - y - h / 2) - (h / 2 - r)
	local outside = math.sqrt(math.max(qx, 0) ^ 2 + math.max(qy, 0) ^ 2)
	return math.abs(outside + math.min(math.max(qx, qy), 0) - r)
end

local function dotsDistance(px: number, py: number, dots: [number, number][], radius: number): number
	local best = math.huge
	for _, dot in ipairs(dots) do
		best = math.min(best, math.sqrt((px - dot[1]) ^ 2 + (py - dot[2]) ^ 2) - radius)
	end
	return best
end

local CUBE_OUTLINE: [number, number][] = { { 12, 2.5 }, { 20.5, 7 }, { 20.5, 17 }, { 12, 21.5 }, { 3.5, 17 }, { 3.5, 7 } }

-- How far a grid point lies outside each icon's ink (<= 0 is inked).
local ICON_SHAPES: { [K in DonatosIcon]: (px: number, py: number) => number } = {
	more = function(px: number, py: number): number
		return dotsDistance(px, py, { { 12, 5 }, { 12, 12 }, { 12, 19 } }, 1.75)
	end,
	moreHorizontal = function(px: number, py: number): number
		return dotsDistance(px, py, { { 5, 12 }, { 12, 12 }, { 19, 12 } }, 1.75)
	end,
	close = function(px: number, py: number): number
		return math.min(segmentDistance(px, py, 5, 5, 19, 19), segmentDistance(px, py, 19, 5, 5, 19)) - HALF_STROKE
	end,
	chevronDown = function(px: number, py: number): number
		return pathDistance(px, py, { { 6, 9 }, { 12, 15 }, { 18, 9 } }) - HALF_STROKE
	end,
	check = function(px: number, py: number): number
		return pathDistance(px, py, { { 5, 12.5 }, { 9.5, 17 }, { 19, 7 } }) - HALF_STROKE
	end,
	bag = function(px: number, py: number): number
		-- A rounded bag with its handle curving down inside the top.
		local body = roundRectDistance(px, py, 3.5, 3, 17, 18.5, 4.5)
		local handle = py >= 7 and math.abs(math.sqrt((px - 12) ^ 2 + (py - 7) ^ 2) - 3.5) or math.huge
		return math.min(body, handle) - HALF_STROKE
	end,
	cube = function(px: number, py: number): number
		local edges = pathDistance(px, py, CUBE_OUTLINE, true)
		local inner = pathDistance(px, py, { { 3.5, 7 }, { 12, 11.5 }, { 20.5, 7 } })
		inner = math.min(inner, segmentDistance(px, py, 12, 11.5, 12, 21.5))
		return math.min(edges, inner) - HALF_STROKE
	end,
	search = function(px: number, py: number): number
		local lens = math.abs(math.sqrt((px - 11) ^ 2 + (py - 11) ^ 2) - 7)
		return math.min(lens, segmentDistance(px, py, 16.5, 16.5, 20, 20)) - HALF_STROKE
	end,
	calendar = function(px: number, py: number): number
		local d = roundRectDistance(px, py, 2.5, 3.5, 19, 18.5, 4)
		d = math.min(d, segmentDistance(px, py, 3, 9, 21, 9))
		d = math.min(d, segmentDistance(px, py, 7.5, 2, 7.5, 5), segmentDistance(px, py, 16.5, 2, 16.5, 5))
		d = d - HALF_STROKE
		return math.min(d, dotsDistance(px, py, { { 8, 13.5 }, { 12, 13.5 }, { 16, 13.5 }, { 8, 17.5 }, { 12, 17.5 } }, 1))
	end,
	clock = function(px: number, py: number): number
		local face = math.abs(math.sqrt((px - 12) ^ 2 + (py - 12) ^ 2) - 9.5)
		return math.min(face, pathDistance(px, py, { { 12, 7 }, { 12, 12 }, { 15.5, 14 } })) - HALF_STROKE
	end,
	card = function(px: number, py: number): number
		-- A bank card: the magnetic stripe and a short line of digits.
		local d = roundRectDistance(px, py, 2.5, 5, 19, 14, 3)
		d = math.min(d, segmentDistance(px, py, 3, 10, 21, 10))
		return math.min(d, segmentDistance(px, py, 6.5, 15, 10, 15)) - HALF_STROKE
	end,
	wallet = function(px: number, py: number): number
		-- A wallet with its clasp on the right edge.
		local d = roundRectDistance(px, py, 3, 5.5, 18, 14, 3.5)
		d = math.min(d, roundRectDistance(px, py, 14.5, 10, 6.5, 5, 2.5)) - HALF_STROKE
		return math.min(d, dotsDistance(px, py, { { 17.5, 12.5 } }, 1))
	end,
}

local WHITE = Color(255, 255, 255)
local iconMasks: Table<string, DonatosMask> = {}

-- Bakes `icon` at `size` pixels: each texel's ink coverage, with the alpha converted for
-- GMod's linear blending (see blendAlpha) so edges look as they would in a browser.
local function iconMask(icon: DonatosIcon, size: number): DonatosMask
	local key = `${icon}${size}`
	local cached = iconMasks[key]
	if cached ~= nil then
		return cached
	end
	local shape = ICON_SHAPES[icon]
	local unit = 24 / size
	local mask = bakeMask(`donatos_icon_v1_${key}`, size, function(x: number, y: number): number
		local covered = coverage(x, y, function(sx: number, sy: number): boolean
			return shape(sx * unit, sy * unit) <= 0
		end)
		return covered > 0 and blendAlpha(WHITE, covered * 255) or 0
	end)
	iconMasks[key] = mask
	return mask
end

-- Draws `icon` in `color`, centred in a `size` box at (x, y).
function theme.icon(icon: DonatosIcon, x: number, y: number, size: number, color: Color)
	local pixels = math.max(math.Round(size), 4)
	local mask = iconMask(icon, pixels)
	local left = math.Round(x + (size - pixels) / 2)
	local top = math.Round(y + (size - pixels) / 2)
	surface.SetMaterial(mask.material)
	surface.SetDrawColor(color)
	surface.DrawTexturedRectUV(left, top, pixels, pixels, 0, 0, mask.extent, mask.extent)
end

theme.refresh()

return theme
