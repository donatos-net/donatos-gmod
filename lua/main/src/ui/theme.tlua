	ocean = {
		label = "Океан",
		swatch = { 4, 133, 247 },
		light = false,
		accent = { 4, 133, 247 },
		accentForeground = SNOW,
		tint = { 0, 0, 0 },
		gradient = { { 6, 182, 212 }, { 4, 133, 247 }, { 99, 102, 241 }, { 20, 184, 166 } },
		strength = 0.6,
	},
	emerald = {
		label = "Изумруд",
		swatch = { 16, 185, 129 },
		light = false,
		accent = { 5, 150, 105 },
		accentForeground = SNOW,
		tint = { -2, 3, 0 },
		gradient = { { 16, 185, 129 }, { 13, 148, 136 }, { 5, 150, 105 }, { 20, 184, 166 } },
		strength = 0.6,
	},
	amber = {
		label = "Янтарь",
		swatch = { 245, 130, 20 },
		light = false,
		accent = { 234, 88, 12 },
		accentForeground = SNOW,
		tint = { 3, 1, -3 },
		gradient = { { 234, 88, 12 }, { 217, 119, 6 }, { 245, 158, 11 }, { 194, 65, 12 } },
