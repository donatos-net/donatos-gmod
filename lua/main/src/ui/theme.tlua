-- Client: visual tokens for the donatos menu (HeroUI v3's look, in the colour scheme the player
-- picks), scaled to the screen, and the drawing and text helpers every widget shares.

local theme = {}

-- GMod's 2D pipeline crushes dark tones: drawing grey 16 shows 8, 24 shows 17, and from 96 up
-- it is the identity (measured with a grey ramp in the client). Theme colours are written as
-- they should appear, and lifted through the inverse of that response.
local RESPONSE: { drawn: number; shown: number }[] = {
	{ drawn = 0, shown = 0 },
	{ drawn = 8, shown = 2 },
	{ drawn = 16, shown = 8 },
	{ drawn = 24, shown = 17 },
	{ drawn = 32, shown = 26 },
	{ drawn = 40, shown = 35 },
	{ drawn = 48, shown = 44 },
	{ drawn = 56, shown = 53 },
	{ drawn = 64, shown = 62 },
	{ drawn = 72, shown = 70 },
	{ drawn = 80, shown = 79 },
	{ drawn = 96, shown = 96 },
}

local function lift(shown: number): number
	for i = 2, #RESPONSE do
		local low = assert(RESPONSE[i - 1])
		local high = assert(RESPONSE[i])
		if shown <= high.shown then
			local f = (shown - low.shown) / (high.shown - low.shown)
			return math.Round(Lerp(f, low.drawn, high.drawn))
		end
	end
	return shown
end

-- An opaque colour that appears on screen as (r, g, b).
local function shown(r: number, g: number, b: number): Color
	return Color(lift(r), lift(g), lift(b), 255)
end

-- The forward response: what a drawn grey shows as.
local function crush(drawn: number): number
	for i = 2, #RESPONSE do
		local low = assert(RESPONSE[i - 1])
		local high = assert(RESPONSE[i])
		if drawn <= high.drawn then
			return Lerp((drawn - low.drawn) / (high.drawn - low.drawn), low.shown, high.shown)
		end
	end
	return drawn
end

local function toLinear(value: number): number
	local c = value / 255
	return c <= 0.04045 and c / 12.92 or ((c + 0.055) / 1.055) ^ 2.4
end

-- GMod blends translucent draws in linear light, where the web blends sRGB values, so the same
-- alpha comes out far stronger (white at 24 over black shows 86, not 24). This finds the alpha
-- that shows like the web's `alpha`. Near-black scales whatever is below, which has a closed form
-- (1 - (1 - a)^2.2); anything else is matched over the menu background, and is close over
-- lighter surfaces.
local DARK_BASE: number[] = { 14, 14, 16 }
-- The light window: HeroUI's --background with the light scheme's tint.
local LIGHT_BASE: number[] = { 233, 233, 233 }

------------------------------------------------------------------------------ colour schemes

local type Rgb = [number, number, number]

-- The menu's colour schemes, one picked by each player. A scheme is HeroUI's way of theming:
-- its light or dark theme with an accent (`--accent` and `--accent-foreground`, the text on
-- it), the shades HeroUI derives from those worked out the same way below. Ours on top: `tint`
-- shifts the theme's greys (toward a dark scheme's hue, or a step darker for the light one),
-- and `gradient` is the top bar's four drifting stops (`vivid` the same at full strength, for
-- progress bars).
local type DonatosScheme = {
	-- In the menu's picker, with a colour to show it by.
	label: string;
	swatch: Rgb;
	light: boolean;
	accent: Rgb;
	accentForeground: Rgb;
	tint: Rgb;
	-- The stops as colours, shown over the background at `strength` (or as given, when 1).
	gradient: Rgb[];
	strength: number;
	-- Progress bars' stops, when not the gradient's at full strength.
	vivid?: Rgb[];
}

local SCHEME_ORDER: DonatosColorScheme[] = { "ocean", "emerald", "amber", "graphite", "light" }

local SNOW: Rgb = { 252, 252, 252 }
local ECLIPSE: Rgb = { 24, 24, 27 }

local SCHEMES: Table<DonatosColorScheme, DonatosScheme> = {
